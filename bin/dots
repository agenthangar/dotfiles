#!/usr/bin/env bash
# Command entry point for both Homebrew and checkout installations.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: dots <command>

Commands:
  install [DIRECTORY]        Set up dotfiles (default: ~/code/dotfiles)
  update [--all|--dev|--relink]
                             Update the installed configuration

Update options:
  --all, -a                  Update here and on configured remote hosts
  --dev, -d                  Use the dotfiles worktree in this directory
  --relink                   Refresh installed links without fetching

Bare dots and dots --all/--dev/--relink remain aliases for update.
Run dots install --help for installation details.
EOF
}

case "${1:-}" in
    help|-h|--help) usage; exit 0 ;;
    install)
        shift
        # Follow both Homebrew and ~/bin links to this command's own payload.
        script=${BASH_SOURCE[0]}
        while [[ -L "$script" ]]; do
            directory=$(cd -P "$(dirname "$script")" && pwd)
            script=$(readlink "$script")
            [[ "$script" == /* ]] || script="$directory/$script"
        done
        root=$(cd -P "$(dirname "$script")/.." && pwd)
        exec bash "$root/scripts/dotfiles-setup" "$@"
        ;;
    update) shift ;;
    ""|--all|-a|--dev|-d|--relink) ;;
    *) printf 'dots: unknown command: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    ""|--all|-a|--dev|-d|--relink) ;;
    *) printf 'dots update: unknown option: %s\n' "$1" >&2; exit 2 ;;
esac

# Updates belong to the selected shell configuration, not Homebrew's snapshot.
# Check for the function explicitly so an unconfigured shell cannot recurse
# into this executable. Interactive zsh calls the function directly and reloads
# itself; other callers update through this child shell.
exec zsh -f -c '
    [[ -r "$HOME/.zshrc" ]] && source "$HOME/.zshrc"
    if (( ! $+functions[dots] )); then
        print -u2 -- "dots: shell integration not found; run dots install first"
        exit 1
    fi
    dots "$@"
' dots "$@"
