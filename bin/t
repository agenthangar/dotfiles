            "direct use.")
    lp = sub.add_parser("new-land", help="(internal) clone + register a `t new` repo on this host",
        description="Internal: clone <url> to ~/code/<name> (skipped when it already is that "
            "clone) and append DEV_REPOS[<alias>] to this host's ~/.zshrc.local. Invoked over "
            "ssh by `t new` / `t setup`; not for direct use.")
    lp.add_argument("url")
    lp.add_argument("name")
    lp.add_argument("alias")
    mp = sub.add_parser("mcp", help="(internal) stdio MCP server: which session is working on what",
        description="Internal: the stdio MCP server Claude Code spawns, registered at user "
            "scope as `sessions` by install.sh (or `t mcp --install`). Exposes the live slots, "
            "keyword search over every saved transcript's prompts, and per-session detail, "
            "so any Claude session can answer \"which session was working on X?\". "
