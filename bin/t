#!/usr/bin/env python3
# t — Claude session manager: open/list/move tmux'd Claude sessions (gh-style).
#
# Single front door for the Claude-session workflow (was the dev/tpush/tpop/tbeam/
# tread/tplan/tpaste/tfind/on family). gh-style: `t <verb> [args] [--flags]`, -h
# everywhere. This BIN owns argument parsing, help, config, the cross-host fan-out,
# rendering, and the Python-shaped verbs. Verbs that must manipulate the CALLING
# shell (cd + `claude -r` in the current terminal, the tpush sentinel handoff) are
# driven by the thin `t()` zsh shim via `t __resolve …` — a bin subprocess cannot
# cd the parent shell or exec into its TTY.
#
# Config: ~/.config/t/config.sh, derived from the live zsh arrays by _t_sync_config
# in .zshrc (DEV_REPOS / DEV_BRANCHES / REMOTE_HOSTS / DEV_BRANCH). Parsed here with
# a strict line regex — never sourced (it is shell, but ~/.zshrc.local is not, and
# we never execute either).
#
# Hybrid: the intricate, battle-tested tmux/ps introspection + transcript resolution
# (the _dev_* helpers) stay as zsh functions; this bin invokes them via `zsh -lic`
# for the data and renders in Python. Reimplementing ps-tree walking buys nothing.

import argparse
import calendar
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "t", "config.sh")

# Every zsh helper we spawn is `zsh -lic` (login+interactive — required so .zshrc is
# sourced and the _dev_* functions exist). An interactive login shell exiting under
# macOS Terminal.app triggers its shell-session-save, which prints "Saving session…"
# noise to stderr on every `t ls`/`t read`/etc. Disable it for our children (inherited
# by subprocess + execvp); does not affect the user's own shell.
os.environ["SHELL_SESSIONS_DISABLE"] = "1"

# Job-control noise prelude, prepended to every zsh snippet we spawn. The fan-out
# helpers run `&` + `wait` (e.g. _dev_rows_all behind `t ls -r`). When the spawned
# `zsh -lic` inherits a controlling tty (it does from a real terminal), -i turns on
# MONITOR (job control), so it prints job notices during the run and, crucially,
# "warning: N jobs SIGHUPed" at *exit*. _dev_rows_all's own `setopt local_options
# no_monitor` cannot fix the exit warning: local_options restores MONITOR=on when the
# function returns, before the shell exits. Setting it here keeps MONITOR off for the
# whole spawned-shell lifetime — quiet during the run AND at exit — and only touches
# our throwaway capture shells, never the user's interactive shell (or the `$(…)`
# subshell callers of _dev_rows_all, which already run with job control off).
ZSH_PRELUDE = "setopt no_monitor no_notify 2>/dev/null; "

# ─── config ──────────────────────────────────────────────────────────────────

_CFG_LINE = re.compile(
    r"^(DEV_REPOS|DEV_BRANCHES|REMOTE_HOSTS|DEV_WORKTREE)\[([^\]]+)\]=(.*)$"
    r"|^(DEV_BRANCH|DEV_WORKTREE_ROOT|DEV_WORKTREE_DEFAULT)=(.*)$")


def _unquote(v):
    """Strip one layer of zsh ${(q)} quoting (backslash escapes / quotes)."""
    v = v.strip()
    if not v:
        return ""
    try:
        parts = shlex.split(v)
        return parts[0] if parts else ""
    except ValueError:
        return v


class Config:
    def __init__(self):
        self.repos = {}      # alias -> path
        self.branches = {}   # alias -> branch
        self.hosts = {}      # alias -> ssh target
        self.branch = "dev/claude-1"
        self.worktree = {}   # alias -> opt-out flag (0/no/off → shared-tree)
        self.worktree_root = os.path.join(HOME, "code", ".worktrees")
        self.worktree_default = "1"
        self._load()

    def _load(self):
        try:
            with open(CONFIG, errors="ignore") as fh:
                lines = fh.readlines()
        except OSError:
            return  # graceful: no repos configured (mirrors zsh's degradation)
        for line in lines:
            m = _CFG_LINE.match(line.rstrip("\n"))
            if not m:
                continue
            if m.group(1):
                arr, key, val = m.group(1), m.group(2), _unquote(m.group(3))
                {"DEV_REPOS": self.repos, "DEV_BRANCHES": self.branches,
                 "REMOTE_HOSTS": self.hosts, "DEV_WORKTREE": self.worktree}[arr][key] = val
            elif m.group(4) == "DEV_BRANCH":
                self.branch = _unquote(m.group(5))
            elif m.group(4) == "DEV_WORKTREE_ROOT":
                self.worktree_root = _unquote(m.group(5))
            elif m.group(4) == "DEV_WORKTREE_DEFAULT":
                self.worktree_default = _unquote(m.group(5))

    def repo_of_dir(self, cwd):
        """(alias, slot) for a path — the Python twin of zsh _dev_repo_of_dir. slot is
        the worktree's own slot ($DEV_WORKTREE_ROOT/<basename>/<slot>), else "". Alias
        choice mirrors zsh: the key equal to the basename wins, else the shortest key.
        (None, None) when no repo matches."""
        base, slot = None, ""
        root = self.worktree_root
        if root and cwd.startswith(root + "/"):
            parts = cwd[len(root) + 1:].split("/")
            if len(parts) >= 2:
                base, slot = parts[0], parts[1]
        if base is None:
            best = ""
            for path in self.repos.values():
                if cwd == path or cwd.startswith(path + "/"):
                    if len(path) > len(best):
                        best = path
            if not best:
                return (None, None)
            base = os.path.basename(best)
        matches = [k for k, v in self.repos.items() if os.path.basename(v) == base]
        if not matches:
            return (None, None)
        if base in matches:
            return (base, slot)
        return (min(matches, key=len), slot)

    def repo_dir_for_cwd(self, cwd):
        """Canonical DEV_REPOS dir for cwd (or for the worktree containing it), else ''.
        Worktree-aware via repo_of_dir."""
        alias, _ = self.repo_of_dir(cwd)
        return self.repos.get(alias, "") if alias else ""


# ─── shell-out helpers ─────────────────────────────────────────────────────────

def zsh_capture(snippet, stdin=subprocess.DEVNULL):
    """Run a zsh login+interactive snippet, return stdout (stderr passes through).

    `-lic` is the same context the remote fan-out uses: ~/bin and Homebrew tmux/fzf
    are only on the login/interactive PATH, and the _dev_* helpers are defined there.

    The child gets NO terminal: a fresh session, stdin from /dev/null. An interactive
    zsh that can see a tty moves itself into its own process group and makes THAT the
    terminal's foreground group — measured under a pty: the foreground pgrp flipped to
    the child's pid and STAYED there after it exited, leaving this process in the
    background. Nothing notices until something touches the terminal: the next
    tcsetattr (the inline picker's raw mode, fzf) is answered with SIGTTOU — "zsh:
    suspended (tty output)", the #90 bug, blamed then on the scan's cost. `t ls` never
    noticed because it only prints. Detached, the child cannot take the terminal, and
    nothing captured here needs one: tmux talks over its socket, ssh runs BatchMode.
    (`stdin` predates this as the MCP server's escape hatch — its own stdin is the
    JSON-RPC wire, so it passed DEVNULL explicitly; that is now the default.)
    """
    try:
        r = subprocess.run(["zsh", "-lic", ZSH_PRELUDE + snippet], stdout=subprocess.PIPE,
                           stdin=stdin, start_new_session=True, text=True)
        return r.stdout
    except FileNotFoundError:
        return ""


def _run(cmd, cwd=None, timeout=None):
    """subprocess.run with captured text output that never raises: a missing binary
    reads as rc 127 and a timeout as rc 124, both with the reason in .stderr, so
    callers classify outcomes instead of catching exceptions (bin/pr-watch's run()).
    stdin is /dev/null: nothing run through here may prompt, and a child that touched
    the tty from inside the raw-mode wizard would leave it reading a terminal it no
    longer owns (see _new_sh_whence)."""
    try:
        return subprocess.run(cmd, cwd=cwd, text=True, timeout=timeout, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))
    except subprocess.TimeoutExpired as e:
        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
        return subprocess.CompletedProcess(cmd, 124, out, err + f"\ntimed out after {timeout}s")


# ─── rendering ───────────────────────────────────────────────────────────────

class Style:
    def __init__(self, tty=None):
        """tty=False forces plain text — for a label a picker measures and truncates
        by len(), where an escape sequence would count as width."""
        tty = sys.stdout.isatty() if tty is None else tty
        self.g = "\033[32m" if tty else ""
        self.c = "\033[36m" if tty else ""
        self.y = "\033[2m" if tty else ""
        self.b = "\033[1m" if tty else ""
        self.r = "\033[0m" if tty else ""


def _columns():
    return shutil.get_terminal_size((80, 24)).columns


def _truncate(s, avail):
    if len(s) > avail:
        return s[:avail - 1] + "…"
    return s


_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def _vis_len(s):
    """Columns a styled line takes on screen: its length with the SGR escapes out."""
    return len(_ANSI_RE.sub("", s))


def _term_rows(line, cols):
    """Screen rows a printed line occupies — a line wider than the terminal WRAPS,
    and the in-place repaint moves the cursor up by rows, not by lines. Counting
    lines was exactly right on a wide terminal and off by one per wrapped line on
    a phone (Termius: ~44 columns), where every keypress left a stale row behind
    and the block crept down the screen."""
    return max(1, -(-_vis_len(line) // max(1, cols)))


def _page_window(heights, top, avail):
    """Which lines of a block fit on screen: heights = rows per line, top = the first
    line wanted, avail = rows the block may take INCLUDING its markers. → (lo, hi):
    show lines[lo:hi], with an "… N above" row when lo > 0 and an "… N below" row
    when hi < len. top is clamped so the block never scrolls past its own end, and
    at least one line is always shown even when it alone overflows."""
    n = len(heights)
    if n == 0 or sum(heights) <= avail:
        return 0, n

    def extent(lo):
        room = avail - (1 if lo else 0)
        used, hi = 0, lo
        while hi < n:
            need = heights[hi] + (0 if hi + 1 == n else 1)
            if used + need > room and hi > lo:
                break
            used += heights[hi]
            hi += 1
            if used > room:
                break
        return hi

    last_top = next((lo for lo in range(n) if extent(lo) == n), n - 1)
    lo = max(0, min(top, last_top))
    return lo, extent(lo)


def _parse_rows(text, host_prefixed=False):
    """Parse _dev_session_rows / _dev_rows_all output into dicts."""
    rows = []
    for line in text.splitlines():
        if not line:
            continue
        f = line.split("\t")
        if host_prefixed:
            if len(f) < 7:
                continue
            host, sid, cwd, slot, state, context, summary = f[:7]
        else:
            if len(f) < 6:
                continue
            host = "local"
            sid, cwd, slot, state, context, summary = f[:6]
        rows.append(dict(host=host, sid=sid, cwd=cwd, slot=slot,
                         state=state, context=context, summary=summary))
    return rows


_HOME_PREFIX = re.compile(r"^/(?:Users|home)/[^/]+/")


def _homerel(p):
    """Strip the machine-local home prefix (/Users/<u>/ on macOS, /home/<u>/ on
    Linux) so remote cwds compare against local scopes on hosts whose $HOME
    differs — the cross-host key is the home-relative form (`code/dotfiles`).
    Zsh twin: _dev_homerel in .zshrc; keep them in sync."""
    return _HOME_PREFIX.sub("", p or "")


def _scope_filter(rows, scope, wt_scope=""):
    """Keep rows whose cwd is under <scope> OR under <wt_scope> (the repo's worktree
    root $DEV_WORKTREE_ROOT/<basename>, where per-session worktrees live). Paths
    are compared home-relative so remote rows from a differing-$HOME host match."""
    if not scope:
        return rows
    scope, wt_scope = _homerel(scope), _homerel(wt_scope)
    def ok(c):
        c = _homerel(c)
        if c == scope or c.startswith(scope + "/"):
            return True
        return bool(wt_scope) and c.startswith(wt_scope + "/")
    return [r for r in rows if ok(r["cwd"])]


def _header(st, scope):
    note = ""
    if scope:
        # Make the scoped repo prominent (bold cyan) — the rest of the note stays dim.
        repo = os.path.basename(scope)
        note = f"   {st.y}(repo: {st.r}{st.b}{st.c}{repo}{st.r}{st.y} — --all for all){st.r}"
    return f"dev sessions   {st.g}●{st.r} attached · {st.c}✓{st.r} active context{note}"


def _ls_scope(cfg, repo, all_repos, cwd):
    """Resolve `t ls [repo] [-a]` to (scope, wt_scope): the canonical repo dir the
    rows are filtered to (plus its worktree root), or ("", "") for every repo.

    An explicit repo is the scope from ANY directory — `t ls dot -r` from ~ was the
    ask, and every other slot verb already takes `<repo>` this way. Unknown alias →
    ValueError naming the choices (never a silent fall-through to the cwd repo,
    which would render the WRONG repo under a heading that looks right). Combined
    with -a it is a contradiction and is refused rather than one flag quietly
    winning."""
    if repo:
        if all_repos:
            raise ValueError("t ls: a repo and --all are contradictory — pick one")
        if repo not in cfg.repos:
            raise ValueError("unknown repo %r — one of: %s"
                             % (repo, ", ".join(sorted(cfg.repos)) or "(none registered)"))
        scope = cfg.repos[repo]
    else:
        scope = "" if all_repos else cfg.repo_dir_for_cwd(cwd)
    wt_scope = os.path.join(cfg.worktree_root, os.path.basename(scope)) if scope else ""
    return scope, wt_scope


def cmd_ls(cfg, args):
    try:
        scope, wt_scope = _ls_scope(cfg, args.repo, args.all, os.getcwd())
    except ValueError as e:
        print(e, file=sys.stderr)
        return 1
    st = Style()
    if args.remote:
        rows = _scope_filter(_parse_rows(zsh_capture("_dev_rows_all"), host_prefixed=True), scope, wt_scope)
        if not rows:
            where = f" in {os.path.basename(scope)} (t ls -r --all for every repo)," if scope else ""
            print(f"No dev sessions running{where} on this machine or any reachable host.")
            return 0
        _render_remote(rows, scope, st)
    else:
        rows = _scope_filter(_parse_rows(zsh_capture("_dev_session_rows")), scope, wt_scope)
        if not rows:
            where = f" in {os.path.basename(scope)}" if scope else ""
            hints = ([f"t ls --all for every repo"] if scope else []) + \
                    (["t ls -r for other machines"] if cfg.hosts else [])
            tail = f"  ({' · '.join(hints)})" if hints else ""
            print(f"No dev sessions running{where}.{tail}")
            return 0
        _render_local(rows, scope, st, bool(cfg.hosts))
    return 0


def _slot_line(r, st, name_w, avail, host_w=None):
    """ONE row of the slot view: `● ✓     <slot>  <working on>`. `t ls` and every
    slot picker draw their rows through this, so a slot reads the same wherever it is
    offered — the point of a shared view is that you never re-learn a slot's row.
    state attached → ●, detached → ○, anything else (a dead slot from
    _dev_dead_slot_rows) → blank, and its summary carries the
    story instead; context active → ✓. host_w adds the `t ls -r` HOST column. The
    Style is the only colour, so Style(tty=False) yields a label a picker can measure."""
    amark = {"attached": f"{st.g}●{st.r}", "detached": "○"}.get(r.get("state"), " ")
    cmark = f"{st.c}✓{st.r}" if r.get("context") == "active" else " "
    host = ""
    if host_w is not None:
        cell = "" if r.get("host", "local") == "local" else r["host"]
        host = f"{cell:<{host_w}} "
    summary = _truncate(r.get("summary") or "", avail)
    return f"{amark} {cmark}     {host}{r['slot']:<{name_w}} {st.y}{summary}{st.r}"


def _render_local(rows, scope, st, has_remote=False):
    name_w = max([7] + [len(r["slot"]) for r in rows])
    avail = _columns() - 11 - name_w
    if avail < 12:
        avail = 80 - 11 - name_w
    print(_header(st, scope))
    print()
    print(f"  {st.y}{'STATUS':<8}{'SESSION':<{name_w}} WORKING ON{st.r}")
    has_fg = False
    for r in rows:
        print("  " + _slot_line(r, st, name_w, avail))
        if ":" in r["slot"]:                       # colon marks a foreground row
            has_fg = True
    foot = "reattach: t open <repo> <slot>"
    if has_fg:
        foot += " · foreground: t open <id>"
    if has_remote:
        foot += " · other machines: t ls -r"
    print()
    print(f"  {st.y}{foot}{st.r}")


def _render_remote(rows, scope, st):
    host_w = max([4] + [len(r["host"]) for r in rows if r["host"] != "local"])
    name_w = max([7] + [len(r["slot"]) for r in rows])
    avail = _columns() - 12 - host_w - name_w
    if avail < 12:
        avail = 80 - 12 - host_w - name_w
    print(_header(st, scope))
    print()
    print(f"  {st.y}{'STATUS':<8}{'HOST':<{host_w}} {'SESSION':<{name_w}} WORKING ON{st.r}")
    has_fg = False
    for r in rows:
        print("  " + _slot_line(r, st, name_w, avail, host_w))
        if ":" in r["slot"]:                       # colon marks a foreground row
            has_fg = True
    foot = ("attach (auto-finds its host): t open <repo> <slot> · "
            "pull here: t beam <repo> <slot> --from <host>")
    if has_fg:
        foot += " · foreground: t on <host> t open <id>"
    print()
    print(f"  {st.y}{foot}{st.r}")


# ─── machine-readable (remote contract) ────────────────────────────────────────

def cmd_session_rows(cfg, args):
    """The per-host scan behind `t ls -r`. Delegates to the proven zsh helper."""
    sys.stdout.write(zsh_capture("_dev_session_rows"))
    return 0


def cmd_land(cfg, args):
    """Resume a beamed session on this host. Reads TB_CWD/TB_SID/TB_MODE/TB_ATTACH
    from the env (set by the beam orchestrator over ssh, dodging nested-quote hell)
    and delegates to the proven zsh _tbeam_land."""
    os.execvp("zsh", ["zsh", "-lic", "_tbeam_land"])


def cmd_kill_owner(cfg, args):
    """Stop the local dev slot that owns TB_SID (the MOVE / one-live-owner step).
    Delegates to the proven zsh _tbeam_kill_owner."""
    os.execvp("zsh", ["zsh", "-lic", "_tbeam_kill_owner"])


def cmd_cursor(cfg, args):
    """Passthrough to bin/cursor-beam, the cursor-agent chat mover — cursor chats
    have no dev slot/tmux, so the whole t machinery does not apply; this verb just
    gives them the same front door. `t cursor ls` sugar maps to `cursor-beam --ls`;
    everything else forwards verbatim. Resolved as a sibling of the real bin/t
    (works from a repo checkout before install.sh links it), else from PATH."""
    rest = list(args.rest)
    if rest and rest[0] == "ls":
        rest[0] = "--ls"
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cursor-beam")
    if not os.path.isfile(exe):
        exe = "cursor-beam"
    os.execvp(exe, [exe] + rest)


# ─── subprocess-safe verbs ─────────────────────────────────────────────────────

def _set_term_title(text):
    """Set the terminal/tab title via OSC, mirroring .zshrc's _term_title. No-op when
    stdout is not a tty. Used before an execvp into ssh so the title reads `host: cmd`
    instead of the leaked ssh argv. We cannot clear it afterward (execvp replaces this
    process), but the shell's precmd refreshes the title on return."""
    if sys.stdout.isatty():
        sys.stdout.write(f"\033]0;{text}\007")
        sys.stdout.flush()


def cmd_on(cfg, args):
    if not args.rest:
        # interactive login shell on the host
        target = cfg.hosts.get(args.host, args.host)
        _set_term_title(args.host)
        os.execvp("ssh", ["ssh", "-t", target])
    host = args.host
    target = cfg.hosts.get(host, host)
    inner = " ".join(shlex.quote(a) for a in args.rest)
    _set_term_title(f"{host}: {' '.join(args.rest)}")
    os.execvp("ssh", ["ssh", "-t", target, f"zsh -lic {shlex.quote(inner)}"])


# Escape-stripping for a tmux capture-pane log of a TUI (Claude Code). The naive
# "delete \r, strip a hand-picked set of CSI letters" stripper (the old _PERL_STRIP)
# was garbage on real logs two ways: (1) deleting \r collapsed every screen REPAINT
# into one giant jammed line, and (2) its letter allowlist missed the private-mode
# CSI sequences a modern TUI emits — \x1b[>4;2m / \x1b[>1u / \x1b[<u (keyboard
# protocol) and \x1b[?25h/l (cursor show/hide) — whose `>`/`<`/`?` parameter marker
# defeated the [\d;]* match, so they leaked into less as `^Qu1u4;2m`-style junk.
# _clean_capture handles the FULL CSI grammar instead: ESC [ <params 0x30-0x3F>
# <intermediates 0x20-0x2F> <final 0x40-0x7E>. It drops every CSI EXCEPT plain SGR
# colour (final `m`, digit/semicolon params only) so `less -R` still renders colour,
# strips OSC title sets / charset selects / lone control chars, and splits on BOTH
# \r and \n so each repaint row becomes one display line. Shared by the less and the
# --dump paths so they render identically. (Residual word-jamming — "monthpriceforecast"
# — is the TUI positioning words with cursor moves we strip; reconstructing that needs a
# terminal emulator and is out of scope.)
# All stripping runs on raw BYTES, before the utf-8 decode. A tmux capture interleaves
# SO/SI charset-shift bytes (\x0e/\x0f) and escapes *inside* multibyte UTF-8 chars
# (⏵, ─, ←), so decoding first and stripping after leaves the char already mangled into
# �; stripping the control/escape bytes first makes each char's bytes contiguous so
# it decodes cleanly.
_OSC = re.compile(rb"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
_CSI = re.compile(rb"\x1b\[[0-?]*[ -/]*[@-~]")
_CHARSET = re.compile(rb"\x1b[()][0-9AB]")
_ESC2 = re.compile(rb"\x1b[=>Mc78]")
_CTRL = re.compile(rb"[\x00-\x08\x0b\x0c\x0e-\x1a\x1c-\x1f\x7f]")


def _keep_sgr(m):
    """CSI replacement: keep plain SGR colour (\\x1b[…m, digit/semicolon params), drop
    everything else (cursor moves, clears, private-mode toggles)."""
    s = m.group(0)
    if s[-1:] == b"m" and all(c in b"0123456789;" for c in s[2:-1]):
        return s
    return b""


def _clean_capture(logfile):
    """Read a capture-pane log, strip non-colour escapes, return one display line per
    repaint row (split on \\r and \\n)."""
    b = open(logfile, "rb").read()
    b = _OSC.sub(b"", b)
    b = _CSI.sub(_keep_sgr, b)
    b = _CHARSET.sub(b"", b)
    b = _ESC2.sub(b"", b)
    # Drop the leftover C0 control chars (BEL, the SO/SI charset shifts \x0e/\x0f that
    # show as ^N/^O, etc.) — but keep \t, \n, \r (the split feeds on \r/\n) and \x1b
    # (the surviving SGR colour sequences start with it).
    b = _CTRL.sub(b"", b)
    return re.split(r"[\r\n]+", b.decode("utf-8", "replace"))


def _infer_repo(cfg, slot=None):
    """Repo alias implied by cwd — the bin-side twin of zsh's _t_infer_repo (t read
    is bin-native so it can't call the zsh helper). Evidence is the log files
    (t read targets logs, which outlive sessions): an existing dev-<alias>-<slot>.log
    wins, then any dev-<alias>-*.log — newest mtime first either way, so when several
    aliases key one dir (dot-* and dotfiles-* both at ~/code/dotfiles) the alias
    actually in use beats a stale one. No logs → the DEV_REPOS key for the dir
    (basename match preferred, then shortest)."""
    d = cfg.repo_dir_for_cwd(os.getcwd())
    if not d:
        return None
    aliases = [k for k, v in cfg.repos.items() if v == d]
    if not aliases:
        return None
    logdir = os.path.join(HOME, ".tmux-logs")

    def newest(patterns):
        cands = []
        for k in aliases:
            for pat in patterns(k):
                if os.path.isfile(pat):
                    cands.append((os.path.getmtime(pat), k))
        return max(cands)[1] if cands else None

    if slot:
        hit = newest(lambda k: [os.path.join(logdir, f"dev-{k}-{slot}.log")])
        if hit:
            return hit
    hit = newest(lambda k: glob.glob(os.path.join(logdir, f"dev-{k}-[0-9]*.log")))
    if hit:
        return hit
    base = os.path.basename(d)
    if base in aliases:
        return base
    return min(aliases, key=len)


def cmd_read(cfg, args):
    bare = args.repo is None and args.slot is None
    repo, slot = args.repo, args.slot
    # Repo-aware: `t read 4` ≡ slot 4 of the repo cwd is in; bare `t read` is its
    # first slot's log.
    if repo is not None and repo.isdigit() and not slot:
        repo, slot = None, repo
    # Inside a slot's worktree with no slot given → default to that worktree's slot
    # (so bare `t read` in ~/code/.worktrees/<repo>/3 reads slot 3, not slot 1).
    if not slot:
        _wa, _ws = cfg.repo_of_dir(os.getcwd())
        if _ws:
            slot = _ws
    if not repo:
        repo = _infer_repo(cfg, slot or "1")
    if not repo or repo not in cfg.repos:
        _read_usage(cfg)
        return 1
    args.repo = repo
    slot = slot or "1"
    # --tail implies --dump (a tailed pager makes no sense on mobile).
    dump = args.dump or args.tail is not None
    logfile = os.path.join(HOME, ".tmux-logs", f"dev-{args.repo}-{slot}.log")
    if not os.path.isfile(logfile):
        # Same-dir sibling aliases (mirrors _dev_kill / _t_pop): `dot` and
        # `dotfiles` both key ~/code/dotfiles, so `t read dotfiles 2` should
        # also reach `dev-dot-2.log` here before delegating to a remote host.
        # _infer_repo already does this when the repo arg is omitted; this
        # handles an explicitly-named repo too.
        d = cfg.repos.get(args.repo, "")
        if d:
            for k, v in cfg.repos.items():
                if k == args.repo or v != d:
                    continue
                sib = os.path.join(HOME, ".tmux-logs", f"dev-{k}-{slot}.log")
                if os.path.isfile(sib):
                    args.repo, logfile = k, sib
                    break
    if not os.path.isfile(logfile):
        # No log here — the slot may live on a remote host (the tmux log is host-local;
        # csync syncs transcripts, not ~/.tmux-logs). Try delegating the read to that
        # host over ssh -t, which renders the remote log in less through the ssh TTY.
        # On a fully bare `t read` (no repo, no slot), probe for ANY of the inferred
        # repo's remote slots (empty slot → _dev_remote_resolve picks / fzf-picks) so a
        # remote slot other than 1 is still found. With a repo or slot explicitly named,
        # pass the resolved slot so remote mirrors the local default of slot 1.
        # --dump/--tail forward so the mobile-friendly stdout dump renders on the host.
        # rc 0 = handled (or a no-TTY hint printed); rc 1 = live nowhere → local error.
        extra = []
        if args.tail is not None:
            extra += ["--tail", str(args.tail)]
        elif dump:
            extra.append("--dump")
        if _try_remote_delegate(args.repo, "" if bare else slot, "read", extra) == 0:
            return 0
        print(f"No log found: {logfile}")
        print(f"(start a session with 't open {args.repo} {slot}' first)")
        return 1
    lines = _clean_capture(logfile)
    if dump:
        # Print straight to stdout (no pager) so a mobile terminal's native touch-scroll
        # can scroll it — `less` repaints one viewport and needs arrow/PageUp keys that
        # are unusable on a phone. --tail N keeps only the last N lines (bare --dump
        # prints all). SGR colour stays so the dump is still readable; the rest is
        # stripped by _clean_capture.
        if args.tail is not None:
            lines = lines[-args.tail:]
        sys.stdout.write("\n".join(lines) + "\n")
        return 0
    # Feed the same cleaned, repaint-split text to less -R (colour rendered, +G = tail).
    less = subprocess.Popen(["less", "-R", "+G"], stdin=subprocess.PIPE)
    less.communicate(("\n".join(lines) + "\n").encode("utf-8", "replace"))
    return 0


def _delegate(snippet):
    """exec the existing zsh implementation (login+interactive). For subprocess-safe
    verbs whose battle-tested logic stays in zsh during the hybrid migration; these
    end in a pager / tmux send-keys / tmux kill, all child-safe. (At hard cutover the
    target functions are renamed to internal _t_* helpers and these snippets follow.)"""
    os.execvp("zsh", ["zsh", "-lic", ZSH_PRELUDE + snippet])


def _try_remote_delegate(repo, slot, verb, extra=None):
    """Run zsh `_dev_remote_delegate <repo> <slot> <verb> [extra…]` (login+interactive)
    so a slot that is live on a $REMOTE_HOSTS host is handled THERE over ssh -t — the
    same shared helper `t plan`/`t pop` use. Unlike _delegate() this does NOT exec: it
    runs as a child (inheriting the TTY so the remote pager/attach works) and RETURNS the
    rc, so a bin-native verb can fall back to its local path. `extra` forwards verb flags
    (e.g. read's --dump/--tail) to the far-side `t <verb>`. rc 0 = handled (or a no-TTY
    hint was printed); rc 1 = no remote slot. Returns 1 if zsh is unavailable."""
    toks = ["_dev_remote_delegate", shlex.quote(repo), shlex.quote(slot), shlex.quote(verb)]
    toks += [shlex.quote(a) for a in (extra or [])]
    snippet = " ".join(toks)
    try:
        return subprocess.run(["zsh", "-lic", ZSH_PRELUDE + snippet]).returncode
    except OSError:
        return 1


def cmd_plan(cfg, args):
    parts = ["_t_plan"]
    if args.all:
        parts.append("--all")
    if args.repo:
        parts.append(shlex.quote(args.repo))
    if args.slot:
        parts.append(shlex.quote(args.slot))
    _delegate(" ".join(parts))


def cmd_paste(cfg, args):
    parts = ["_t_paste"]
    if args.pick:
        parts.append("--pick")
    if args.newest:
        parts.append("--newest")
    if args.repo:
        parts.append(shlex.quote(args.repo))
    if args.slot:
        parts.append(shlex.quote(args.slot))
    _delegate(" ".join(parts))


def cmd_kill(cfg, args):
    # remote kill = `_t_dev -r kill <repo> [slot]`; local = `_t_dev kill <repo> <slot|all>`
    parts = ["_t_dev", "-r", "kill"] if args.remote else ["_t_dev", "kill"]
    if args.repo:
        parts.append(shlex.quote(args.repo))
    if args.slot:
        parts.append(shlex.quote(args.slot))
    if args.yes:
        parts.append("-y")
    _delegate(" ".join(parts))


def _read_usage(cfg):
    repos = "|".join(cfg.repos) or "repo"
    print(f"t read — open a dev slot's tmux log in less\n")
    print(f"Usage: t read [{repos}] [slot] [-d|-n N]   (no repo: the one cwd is in)")
    print(f"       -d/--dump prints to stdout for mobile touch-scroll; -n N tails N lines\n")
    print("Logs:")
    logdir = os.path.join(HOME, ".tmux-logs")
    logs = sorted(f for f in os.listdir(logdir)) if os.path.isdir(logdir) else []
    logs = [f for f in logs if f.endswith(".log")]
    if logs:
        for f in logs:
            print(f"  {f[:-4]}  {os.path.join(logdir, f)}")
    else:
        print("  (none yet — start one with 't open <repo> <slot>')")


# ─── setup — onboard repos + hosts into ~/.zshrc.local ─────────────────────────
# `t setup [dir …]` scans for git checkouts (default ~/code) and ~/.ssh/config
# hosts, and appends the picks as DEV_REPOS/REMOTE_HOSTS lines to ~/.zshrc.local.
# The local file is parsed with line regexes and NEVER sourced (same stance as the
# config bridge header above); dedup unions the parsed live lines with the possibly
# stale config cache — over-skipping is the safe direction for an appender. All
# picks are staged in memory and land in ONE dated block at the end, so Ctrl-C
# mid-flow writes nothing. Idempotent by dedup, not by marker: re-runs offer only
# what is not yet registered.

ZSHRC_LOCAL = os.path.join(HOME, ".zshrc.local")
SSH_CONFIG = os.path.join(HOME, ".ssh", "config")

_LOCAL_LINE = re.compile(r"^\s*(DEV_REPOS|REMOTE_HOSTS)\[([^\]]+)\]=(.*)$")
_TBEAM_LINE = re.compile(r"^\s*export\s+TBEAM_HOST=")
_BARE_HOST = re.compile(r"^[A-Za-z0-9@._:-]+$")
_SETUP_KEY = re.compile(r"^[^\s\]=-][^\s\]=]*$")   # no whitespace/]/=; no leading -


def _local_entries(text):
    """Parse LIVE (uncommented) DEV_REPOS/REMOTE_HOSTS assignments and a TBEAM_HOST
    export out of ~/.zshrc.local text. Returns (repos, hosts, tbeam_set) with raw
    (still-quoted) values."""
    repos, hosts, tbeam = {}, {}, False
    for line in text.splitlines():
        if _TBEAM_LINE.match(line):
            tbeam = True
            continue
        m = _LOCAL_LINE.match(line)
        if m:
            (repos if m.group(1) == "DEV_REPOS" else hosts)[m.group(2)] = m.group(3).strip()
    return repos, hosts, tbeam


def _expand_home(rawval):
    """Comparable absolute path for a raw ~/.zshrc.local value: strip one quoting
    layer, then expand $HOME/${HOME}/~ (the forms the example file uses)."""
    v = _unquote(rawval).replace("${HOME}", HOME).replace("$HOME", HOME)
    return os.path.expanduser(v)


def _scan_repos(dirs, skip_paths, max_depth=3):
    """Git checkouts under dirs: a dir containing .git (dir OR file — worktrees and
    submodules have a file) counts and is not descended into. Skips hidden dirs and
    anything whose realpath is in skip_paths (registered repos, the worktree root).
    Deduped by realpath (symlinked duplicates), sorted."""
    skip = {os.path.realpath(p) for p in skip_paths}
    found, seen = [], set()
    for top in dirs:
        for dirpath, dirnames, _ in os.walk(top):
            real = os.path.realpath(dirpath)
            if real in skip:
                dirnames[:] = []
                continue
            if os.path.exists(os.path.join(dirpath, ".git")):
                dirnames[:] = []
                if real not in seen:
                    seen.add(real)
                    found.append(dirpath)
                continue
            rel = os.path.relpath(dirpath, top)
            depth = 0 if rel == "." else rel.count(os.sep) + 1
            if depth >= max_depth:
                dirnames[:] = []
                continue
            dirnames[:] = sorted(d for d in dirnames if not d.startswith("."))
    return sorted(found)


def _propose_aliases(paths, taken):
    """{path: alias} proposals + the set of paths whose alias needed disambiguating
    (those get an interactive override prompt). Policy: basename; a collision with
    a taken key or an earlier path qualifies with the parent dir (~/work/api →
    work-api); still taken → numeric suffix on the QUALIFIED alias (work-api-2),
    so the parent context survives."""
    proposals, collided = {}, set()
    used = set(taken)
    for p in paths:
        base = os.path.basename(p.rstrip(os.sep))
        alias = base
        if alias in used:
            alias = f"{os.path.basename(os.path.dirname(p))}-{base}"
            collided.add(p)
        qualified, n = alias, 2
        while alias in used:
            alias = f"{qualified}-{n}"
            n += 1
            collided.add(p)
        proposals[p] = alias
        used.add(alias)
    return proposals, collided


def _propose_aliases_hosts(names, taken):
    """{alias: target} for ssh-config Host names: alias = first dot-label
    (studio.local → studio), the full name when that label is taken, skipped
    entirely when both are. Returns (proposals, skipped-names)."""
    out, skipped = {}, []
    used = set(taken)
    for n in names:
        alias = n.split(".")[0]
        if alias in used or alias in out:
            alias = n
        if alias in used or alias in out or not _SETUP_KEY.match(alias):
            skipped.append(n)
            continue
        out[alias] = n
        used.add(alias)
    return out, skipped


def _homeify(path):
    """Render a repo path for ~/.zshrc.local: "$HOME/rel" under home (portable
    across machines with differing usernames), else the quoted absolute path."""
    if path == HOME or path.startswith(HOME + os.sep):
        return f'"$HOME/{os.path.relpath(path, HOME)}"'
    return f'"{path}"'


def _hostval(target):
    """Host values are written bare when shell-safe (matches the example file),
    quoted otherwise."""
    return target if _BARE_HOST.match(target) else f'"{target}"'


def _setup_block(repos, hosts, tbeam, date, tool="t setup"):
    """The exact text appended to ~/.zshrc.local: a dated provenance marker + one
    assignment per pick (sorted for determinism). `date` is injected so the block
    is testable byte-for-byte; `tool` names the writer (t setup / t new)."""
    lines = [f"# ── added by `{tool}` ({date}) ──"]
    lines += [f"DEV_REPOS[{k}]={_homeify(repos[k])}" for k in sorted(repos)]
    lines += [f"REMOTE_HOSTS[{k}]={_hostval(hosts[k])}" for k in sorted(hosts)]
    if tbeam:
        lines.append(f"export TBEAM_HOST={_hostval(tbeam)}")
    return "\n".join(lines) + "\n"


def _parse_ssh_hosts(path, seen=None):
    """Ordered, deduped Host names from an ssh config: keywords case-insensitive,
    multi-pattern Host lines split, wildcard (*/?) and negated (!) patterns skipped
    (drops the stock `Host *`), Include followed (expanduser, ~/.ssh-relative,
    glob-expanded, cycle-safe via `seen`). Missing file → []."""
    seen = set() if seen is None else seen
    real = os.path.realpath(path)
    if real in seen:
        return []
    seen.add(real)
    try:
        with open(path, errors="ignore") as fh:
            lines = fh.readlines()
    except OSError:
        return []
    hosts = []
    for line in lines:
        parts = line.strip().split(None, 1)
        if len(parts) < 2 or parts[0].startswith("#"):
            continue
        key, rest = parts[0].lower(), parts[1]
        if key == "include":
            try:
                pats = shlex.split(rest)
            except ValueError:
                pats = rest.split()
            for pat in pats:
                pat = os.path.expanduser(pat)
                if not os.path.isabs(pat):
                    pat = os.path.join(HOME, ".ssh", pat)
                for inc in sorted(glob.glob(pat)):
                    hosts.extend(_parse_ssh_hosts(inc, seen))
        elif key == "host":
            hosts.extend(n for n in rest.split()
                         if "*" not in n and "?" not in n and not n.startswith("!"))
    out = []
    for h in hosts:
        if h not in out:
            out.append(h)
    return out


def _comment_stale(text, keys):
    """Comment out exactly the named live DEV_REPOS[key]= lines (prefix marks
    provenance, so the edit is recognizable and reversible); every other line
    byte-identical."""
    out = []
    for line in text.splitlines(keepends=True):
        m = _LOCAL_LINE.match(line)
        if m and m.group(1) == "DEV_REPOS" and m.group(2) in keys:
            out.append("# (stale — t setup) " + line)
        else:
            out.append(line)
    return "".join(out)


def _append_local(path, block):
    """Append block to ~/.zshrc.local with a separating blank line, normalizing a
    missing trailing newline first. An absent file (install.sh normally seeds it)
    is created with a short header rather than failing."""
    try:
        with open(path, errors="ignore") as fh:
            text = fh.read()
    except OSError:
        text = ("# ~/.zshrc.local — per-machine config, sourced by ~/.zshrc if it exists.\n"
                "# Created by `t setup` (install.sh normally seeds it from .zshrc.local.example).\n")
    if text and not text.endswith("\n"):
        text += "\n"
    with open(path, "w") as fh:
        fh.write(text + "\n" + block)


def _tilde(p):
    """~-abbreviate a path under $HOME for display."""
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


def _setup_items(repo_cands, reg_repos, host_cands, reg_hosts, tbeam_default, stale, roots_label):
    """Build the checklist item model the setup UI renders — pure and testable.
    repo_cands: [(path, alias)]; host_cands: [(alias, target)]; reg_*: registered
    entries, shown locked with a ✓ so "why isn't X offered?" answers itself;
    tbeam_default: proposed TBEAM_HOST target or None; stale: registered aliases
    whose path is gone. Item types: header / spacer / note / locked / toggle
    (kind repo|host|stale|tbeam)."""
    items = [{"t": "header", "sec": "repos", "label": f"REPOS · {roots_label}"}]
    for path, alias in repo_cands:
        items.append({"t": "toggle", "sec": "repos", "kind": "repo",
                      "alias": alias, "value": path, "checked": False})
    if not repo_cands:
        items.append({"t": "note", "sec": "repos", "label": "no new checkouts found"})
    for k in sorted(reg_repos):
        items.append({"t": "locked", "sec": "repos", "alias": k, "value": reg_repos[k]})
    items += [{"t": "spacer", "sec": "hosts"},
              {"t": "header", "sec": "hosts", "label": "HOSTS · ~/.ssh/config"}]
    for alias, target in host_cands:
        items.append({"t": "toggle", "sec": "hosts", "kind": "host",
                      "alias": alias, "value": target, "checked": False})
    # manual add is a ROW, not a keybind: the hosts step always has something to
    # select, and the affordance is visible instead of hidden in a hint bar
    items.append({"t": "toggle", "sec": "hosts", "kind": "addhost",
                  "alias": "+ add a host manually", "value": "", "checked": False})
    for k in sorted(reg_hosts):
        items.append({"t": "locked", "sec": "hosts", "alias": k, "value": reg_hosts[k]})
    if stale or tbeam_default:
        items += [{"t": "spacer", "sec": "options"},
                  {"t": "header", "sec": "options", "label": "OPTIONS"}]
    if stale:
        items.append({"t": "toggle", "sec": "options", "kind": "stale",
                      "alias": "comment out stale entries",
                      "value": ", ".join(stale), "checked": False})
    if tbeam_default:
        items.append({"t": "toggle", "sec": "options", "kind": "tbeam",
                      "alias": "set TBEAM_HOST", "value": tbeam_default, "checked": False})
    return items


def _selectable(items):
    """Indices of the toggleable rows, in screen order."""
    return [i for i, it in enumerate(items) if it["t"] == "toggle"]


def _setup_result(items):
    """(repos, hosts, tbeam, stale_confirmed) from the checked toggles."""
    repos, hosts, tbeam, stale = {}, {}, None, False
    for it in items:
        if it["t"] != "toggle" or not it["checked"]:
            continue
        if it["kind"] == "repo":
            repos[it["alias"]] = it["value"]
        elif it["kind"] == "host":
            hosts[it["alias"]] = it["value"]
        elif it["kind"] == "tbeam":
            tbeam = it["value"]
        elif it["kind"] == "stale":
            stale = True
    return repos, hosts, tbeam, stale


def _host_insert_at(items):
    """Where a manually-added host row belongs: right above the '+ add a host'
    action row (else after the last host toggle / the HOSTS header) — always
    before the section's locked rows."""
    at = None
    for i, it in enumerate(items):
        if it["sec"] != "hosts":
            continue
        if it.get("kind") == "addhost":
            return i
        if it["t"] in ("header", "toggle"):
            at = i
    return (at + 1) if at is not None else len(items)


def _prompt(msg, default=""):
    """input() wrapper: strip, empty → default, EOF → None (caller aborts cleanly)."""
    try:
        r = input(msg).strip()
    except EOFError:
        print()
        return None
    return r if r else default


def _confirm(msg):
    """[y/N] confirm — EOF, blank, and anything but y/yes are all No."""
    r = _prompt(f"{msg} [y/N] ")
    return bool(r) and r.lower() in ("y", "yes")


def _parse_host_entry(ent, used):
    """Parse a manual 'alias=target' / 'user@host' entry against the aliases
    already in use. Returns (alias, target) or (None, error-message)."""
    alias, _sep, target = ent.partition("=")
    alias, target = alias.strip(), target.strip()
    if not target:  # bare target → alias = first dot-label of the host part
        target = alias
        alias = target.split("@")[-1].split(".")[0]
    if not _SETUP_KEY.match(alias) or alias in used:
        return None, f"'{alias}' is taken or not a valid key"
    return alias, target


class _RailUI:
    """The inline-wizard primitives shared by `t setup` and `t new`: raw single-key
    reads, an input line with a readline-PREFILLED suggestion, and in-place repaint of
    a block of rail lines via ANSI cursor-up — a step redraws itself while the finished
    steps above it stay in normal scrollback (the clack / `npm create` aesthetic).
    Constructing it off a tty (no line discipline to save) raises, which is the signal
    the callers use to fall back to plain prompts. stdlib only — deliberately neither
    fzf nor curses: fzf is not on every host, and both take over the screen while
    the wizard's transcript stays in normal scrollback."""

    def __init__(self):
        import termios
        self.st, self.out = Style(), sys.stdout
        self.fd = sys.stdin.fileno()
        self.old_attrs = termios.tcgetattr(self.fd)
        self.rail = f"{self.st.y}│{self.st.r}"
        self.width = max(40, shutil.get_terminal_size((100, 24)).columns)
        self.painted = [0]   # screen ROWS of the block currently on screen (0 = nothing to erase)

    def cols(self):
        # re-read per paint: a phone rotates, a window resizes, mid-wizard
        return max(20, shutil.get_terminal_size((100, 24)).columns)

    def lines(self):
        return max(8, shutil.get_terminal_size((100, 24)).lines)

    def head(self, label, hint, marker=None):
        """The ◆ step line(s): the key hint rides on the label when the terminal is
        wide enough and drops to a rail line of its own when it is not (a phone),
        so the picker stays compact where it can and readable where it cannot."""
        st = self.st
        mark = marker or f"{st.c}◆{st.r}"
        one = f"{mark}  {st.b}{label}{st.r}  {st.y}{hint}{st.r}"
        if not hint or _vis_len(one) <= self.cols():
            return [one if hint else f"{mark}  {st.b}{label}{st.r}"]
        return [f"{mark}  {st.b}{label}{st.r}", f"{self.rail}  {st.y}{hint}{st.r}"]

    def raw(self):
        import tty
        tty.setcbreak(self.fd)
        self.out.write("\x1b[?25l")
        self.out.flush()

    def restore(self):
        import termios
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_attrs)
        self.out.write("\x1b[?25h")
        self.out.flush()

    def read_key(self):
        import select
        ch = os.read(self.fd, 1).decode(errors="replace")
        if ch == "\x1b":
            r, _, _ = select.select([self.fd], [], [], 0.05)
            if r:
                seq = os.read(self.fd, 2).decode(errors="replace")
                return {"[A": "up", "OA": "up", "[B": "down", "OB": "down"}.get(seq, "esc")
            return "esc"
        return {"\r": "enter", "\n": "enter", " ": "space", "\x03": "abort",
                "\x04": "abort", "": "abort"}.get(ch, ch)

    def cooked_input(self, prompt, default="", prefill=None):
        # Temporarily restore the line discipline so input() gives real editing.
        # `prefill` puts the suggestion IN the input line, editable in place —
        # the clearest "you can change this" signal there is (readline startup
        # hook; on the rare build without readline it degrades to a [suggestion]
        # prompt). Prompts here stay ANSI-free: once readline is loaded it does
        # the cursor math for every input(), and escape codes break it.
        import termios
        import tty
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_attrs)
        self.out.write("\x1b[?25h")
        self.out.flush()
        hooked = False
        if prefill:
            try:
                import readline
                readline.set_startup_hook(lambda: readline.insert_text(prefill))
                hooked = True
            except ImportError:
                prompt = f"{prompt}[{prefill}] "
        try:
            s = input(prompt).strip()
        except EOFError:
            s = ""
        finally:
            if hooked:
                import readline
                readline.set_startup_hook()
            tty.setcbreak(self.fd)
            self.out.write("\x1b[?25l")
            self.out.flush()
        # reclaim the input line for the repaint — every row it wrapped onto
        self.out.write(f"\x1b[{_term_rows(prompt + s, self.cols())}A\r\x1b[J")
        return s or default

    def repaint(self, lines):
        """Erase the block painted last time and draw this one in its place. The
        erase is cursor-up by the ROWS the old block occupied (_term_rows — a line
        wider than the terminal wraps), never by its line count."""
        if self.painted[0]:
            self.out.write(f"\x1b[{self.painted[0]}A\r\x1b[J")
        self.out.write("\n".join(lines) + "\n")
        cols = self.cols()
        self.painted[0] = sum(_term_rows(ln, cols) for ln in lines)
        self.out.flush()

    def commit(self, lines):
        """Repaint, then forget the block: the next repaint starts BELOW it, so these
        lines are now permanent scrollback (a finished step's ◇ summary)."""
        self.repaint(lines)
        self.painted[0] = 0

    def done(self, label, value):
        st = self.st
        self.commit([f"{st.g}◇{st.r}  {label:<11} {value}"])

    def pick(self, label, rows, multi=False, default=0, marked=None):
        """A list under a ◆ step, redrawn in place: ↑↓/jk move, space marks (multi),
        enter picks, q/esc/ctrl-c cancels → None. rows: [(value, text)]. `default` is
        the initial cursor row, `marked` the pre-marked rows (multi) — the two things
        that let a wizard step open on its suggestion."""
        st, rail = self.st, self.rail
        cur = max(0, min(default or 0, len(rows) - 1))
        marks = set(marked or ())
        # j/k are advertised on purpose: a phone keyboard has no arrow keys
        keys = ("↑↓/jk move · space mark · enter pick · q quit" if multi
                else "↑↓/jk move · enter pick · q quit")
        flash = ""
        while True:
            head = self.head(label, flash or keys)
            flash = ""
            height = max(3, self.lines() - 7 - len(head))
            lo = max(0, min(cur - height // 2, len(rows) - height)) if len(rows) > height else 0
            hi = min(len(rows), lo + height)
            lines = list(head)
            if lo:
                lines.append(f"{rail}   {st.y}… {lo} above{st.r}")
            width = self.cols()
            for n in range(lo, hi):
                pre = f"{st.c}▸{st.r}" if n == cur else " "
                box = (f"{st.c}◼{st.r} " if n in marks else "◻ ") if multi else ""
                body = _truncate(rows[n][1], max(12, width - 8))
                body = f"{st.b}{body}{st.r}" if n == cur else body
                lines.append(f"{rail}  {pre}{box}{body}")
            if hi < len(rows):
                lines.append(f"{rail}   {st.y}… {len(rows) - hi} more{st.r}")
            self.repaint(lines)
            k = self.read_key()
            if k in ("up", "k"):
                cur = (cur - 1) % len(rows)
            elif k in ("down", "j"):
                cur = (cur + 1) % len(rows)
            elif k == "space" and multi:
                marks.symmetric_difference_update({cur})
                cur = min(cur + 1, len(rows) - 1)
            elif k == "enter":
                return [rows[i][0] for i in sorted(marks)] if multi else rows[cur][0]
            elif k in ("q", "esc", "abort"):
                return None
            else:
                # a key that does nothing must SAY so — a silent no-op reads as broken
                flash = f"⚠ no binding for that key — {keys}"

    def page(self, label, body, accept, keys=""):
        """A read-only block under a ◆ step (the review screens), windowed to the
        terminal and scrolled in place with ↑↓/jk (space = a screenful) when taller
        than it; a key in `accept` returns it. Rows are counted through _term_rows,
        so a review whose command lines wrap on a phone keeps its head — and the
        y/n/q hint — on screen instead of pushing them off the top with no way back."""
        st, rail = self.st, self.rail
        scroll_hint = f"↑↓/jk scroll · {keys}" if keys else "↑↓/jk scroll"
        top, flash = 0, ""
        while True:
            cols, lines = self.cols(), self.lines()
            heights = [_term_rows(ln, cols) for ln in body]

            def window(hint):
                head = self.head(label, hint)
                avail = max(3, lines - 2 - sum(_term_rows(h, cols) for h in head))
                return head, _page_window(heights, top, avail)

            head, (lo, hi) = window(flash or keys)
            scrolls = (lo, hi) != (0, len(body))
            if scrolls and not flash:
                head, (lo, hi) = window(scroll_hint)
            flash, top = "", lo
            out = list(head)
            if lo:
                out.append(f"{rail}   {st.y}… {lo} above{st.r}")
            out.extend(body[lo:hi])
            if hi < len(body):
                out.append(f"{rail}   {st.y}… {len(body) - hi} below{st.r}")
            self.repaint(out)
            k = self.read_key()
            if k in accept:
                return k
            if k in ("up", "k"):
                top = max(0, top - 1)
            elif k in ("down", "j"):
                top += 1
            elif k == "space":
                top += max(1, hi - lo - 1)
            else:
                flash = f"⚠ no binding for that key — {scroll_hint if scrolls else keys}"


def _setup_wizard(items, taken, trailer=None):
    """The t setup UI (on the _RailUI primitives): a clack-style inline TWO-SCREEN flow. Screen one is the
    whole selection — repos, hosts (with the '+ add a host' action row), and
    options on a single list under one cursor; screen two is a diff-style review
    of the exact ~/.zshrc.local changes: y applies, n/esc goes back to the
    selection, q/ctrl-c aborts with nothing written. Rendered inline on a
    vertical rail (redrawn in place via ANSI cursor-up, windowed when taller
    than the terminal) so the whole transcript stays in scrollback. stdlib only
    — termios/tty raw keys, readline prefill for the rename input. Returns True
    on apply (items mutated in place), False on abort; raises when raw mode is
    unavailable → _setup_prompt_flow."""
    ui = _RailUI()
    st, out, rail, width = ui.st, ui.out, ui.rail, ui.width
    read_key, cooked_input, repaint = ui.read_key, ui.cooked_input, ui.repaint

    def used_aliases(skip=None):
        return taken | {it["alias"] for it in items
                        if it is not skip and it["t"] in ("toggle", "locked")}

    def row_text(it, aw, cur):
        if it.get("kind") == "addhost":
            pre = f"{st.c}▸{st.r}" if cur else " "
            text = it["alias"].lstrip("+ ") + "…"
            body = f"{st.b}{text}{st.r}" if cur else text
            tail = f"  {st.c}· space to add{st.r}" if cur else ""
            return f"{rail}  {pre}{st.c}+{st.r} {body}{tail}"
        # host/tbeam values are ssh targets (never home paths); everything else
        # is a filesystem path worth ~-abbreviating (locked rows have no kind)
        val = it["value"] if it.get("kind") in ("host", "tbeam") else _tilde(str(it["value"]))
        val = _truncate(str(val), max(8, width - aw - 12))
        if it["t"] == "locked":
            return f"{rail}   {st.g}✓{st.r} {st.y}{it['alias']:<{aw}}  {val} · registered{st.r}"
        mark = f"{st.c}◼{st.r}" if it["checked"] else "◻"
        pre = f"{st.c}▸{st.r}" if cur else " "
        alias = (f"{st.b}{it['alias']:<{aw}}{st.r}" if cur else f"{it['alias']:<{aw}}")
        # the cursor row advertises the rename key right where the eye is
        tail = f"  {st.c}· e rename{st.r}" if cur and it.get("kind") in ("repo", "host") else ""
        return f"{rail}  {pre}{mark} {alias}  {st.y}{val}{st.r}{tail}"

    HINTS = "space select · e rename · enter review · q quit"

    def select_screen(msg=""):
        # ONE list: every section under a single cursor; enter goes to review
        pos = 0
        while True:
            sel = _selectable(items)
            pos = max(0, min(pos, len(sel) - 1))
            cur = sel[pos]
            aw = max([len(items[i]["alias"]) for i in sel
                      if items[i].get("kind") != "addhost"] +
                     [len(x["alias"]) for x in items if x["t"] == "locked"] + [1])
            head = ui.head("pick what to add", msg or HINTS)
            nh = len(head)   # 1, or 2 when the hint dropped to its own rail line
            disp = [(h, None) for h in head]
            for idx, it in enumerate(items):
                if it["t"] == "spacer":
                    disp.append((rail, None))
                elif it["t"] == "header":
                    disp.append((f"{rail}  {st.b}{it['label']}{st.r}", None))
                elif it["t"] == "note":
                    disp.append((f"{rail}   {st.y}{it['label']}{st.r}", None))
                else:
                    disp.append((row_text(it, aw, idx == cur), idx))
            # window the list when taller than the terminal, cursor kept visible
            body = max(6, ui.lines() - 2 - nh)
            if len(disp) > body:
                cur_line = next((n for n, d in enumerate(disp) if d[1] == cur), nh)
                lo = max(nh, min(cur_line - body // 2, len(disp) - (body - nh)))
                lines = [d[0] for d in disp[:nh]] + [d[0] for d in disp[lo:lo + body - nh]]
                if lo > nh:
                    lines[nh] = f"{rail}  {st.y}… {lo - nh} more above{st.r}"
                if lo + body - nh < len(disp):
                    lines[-1] = f"{rail}  {st.y}… {len(disp) - (lo + body - nh)} more below{st.r}"
            else:
                lines = [d[0] for d in disp]
            repaint(lines)
            msg = ""
            k = read_key()
            it = items[cur] if sel else None
            if k in ("q", "esc", "abort"):
                return False
            elif k == "enter":
                return True
            elif it and k in ("up", "k"):
                pos -= 1
            elif it and k in ("down", "j"):
                pos += 1
            elif (k == "a") or (it and it.get("kind") == "addhost"
                                and k in ("space", "e")):
                ent = cooked_input("│  add host (alias=target or user@host): ")
                if not ent:
                    continue
                alias, target = _parse_host_entry(ent, used_aliases())
                if alias is None:
                    msg = f"⚠ {target}"
                    continue
                at = _host_insert_at(items)
                items.insert(at, {"t": "toggle", "sec": "hosts", "kind": "host",
                                  "alias": alias, "value": target, "checked": True})
                pos = _selectable(items).index(at)
            elif it and k == "space":
                it["checked"] = not it["checked"]
                pos += 1
            elif it and k == "e" and it["kind"] in ("repo", "host"):
                a = cooked_input(f"│  name for {_tilde(str(it['value']))} → ",
                                 it["alias"], prefill=it["alias"])
                if a != it["alias"]:
                    if _SETUP_KEY.match(a) and a not in used_aliases(skip=it):
                        it["alias"] = a
                        it["checked"] = True   # renaming it means you want it
                    else:
                        msg = f"⚠ '{a}' is taken or not a valid key"
            elif it and k == "e" and it["kind"] == "tbeam":
                it["value"] = cooked_input("│  TBEAM_HOST target → ", it["value"],
                                           prefill=it["value"])
            else:
                # a key that does nothing must SAY so — a silent no-op reads as broken
                msg = f"⚠ no binding for that key — {HINTS}"

    def review_screen():
        # diff-style: exactly what lands in ~/.zshrc.local, one keypress decides
        repos, hosts, tbeam, stale_ok = _setup_result(items)
        if not (repos or hosts or tbeam or stale_ok):
            return "empty"
        lines = []
        for ln in _setup_block(repos, hosts, tbeam, time.strftime("%Y-%m-%d")).splitlines():
            shown = f"{st.y}{ln}{st.r}" if ln.startswith("#") else ln
            lines.append(f"{rail}  {st.g}+{st.r} {shown}")
        if stale_ok:
            sv = next(x["value"] for x in items if x.get("kind") == "stale")
            lines.append(f"{rail}  {st.y}~ comment out stale entries: {sv}{st.r}")
        if trailer and repos:
            lines.append(f"{rail}  {st.c}→{st.r} {st.y}{trailer}{st.r}")
        k = ui.page("review — changes to ~/.zshrc.local", lines,
                    accept=("y", "n", "esc", "q", "abort"), keys="y apply · n back · q quit")
        if k == "y":
            ui.commit([f"{st.g}◇{st.r}  {st.b}applied to ~/.zshrc.local{st.r}"] + lines)
            return True
        if k in ("n", "esc"):
            return False
        return None

    out.write(f"{st.y}┌{st.r}  {st.b}t setup{st.r} {st.y}· ~/.zshrc.local — nothing "
              f"is written until you confirm{st.r}\n{rail}\n")
    ui.raw()
    ok, msg = False, ""
    try:
        while True:
            if not select_screen(msg):
                break
            r = review_screen()
            if r == "empty":
                msg = "nothing selected — space marks ◼ what gets added"
                continue
            if r:
                ok = True
                break
            if r is None:
                break
            msg = ""   # n: back to the selection, keep editing
    except KeyboardInterrupt:
        ok = False
    finally:
        ui.restore()
    end = "" if ok else f" {st.y}· aborted — nothing written{st.r}"
    out.write(f"{st.y}└{st.r}{end}\n")
    return ok


def _setup_prompt_flow(items, taken, trailer=None):
    """Plain-prompt fallback when curses cannot initialize (TERM=dumb, hostile
    terminals): same item model, one y/N per candidate, a manual host loop, then
    the same review gate. Returns True when the review confirm passed."""
    st = Style()
    for it in items:
        if it["t"] == "header":
            print(f"\n{st.b}{it['label']}{st.r}")
        elif it["t"] == "note":
            print(f"  {st.y}{it['label'].replace(' — press a to add one', '')}{st.r}")
        elif it["t"] == "locked":
            print(f"  {st.y}✓ {it['alias']} — already registered{st.r}")
        elif it["t"] == "toggle":
            if it["kind"] == "addhost":
                continue   # the fallback has its own manual-add loop below
            if it["kind"] in ("repo", "host"):
                q = {"repo": f"add repo {it['alias']} ({_tilde(it['value'])})",
                     "host": f"add host {it['alias']} → {it['value']}"}[it["kind"]]
                while True:   # any answer that is not y/n = yes, under that alias
                    r = _prompt(f"  {q}? [y/N/other alias] ")
                    if r is None or r.lower() in ("", "n", "no"):
                        break
                    if r.lower() in ("y", "yes"):
                        it["checked"] = True
                        break
                    used = taken | {x["alias"] for x in items
                                    if x is not it and x["t"] in ("toggle", "locked")}
                    if _SETUP_KEY.match(r) and r not in used:
                        it["alias"] = r
                        it["checked"] = True
                        break
                    print(f"  '{r}' is taken or not a valid key", file=sys.stderr)
            else:
                q = {"stale": f"comment out stale entries ({it['value']})",
                     "tbeam": f"set TBEAM_HOST = {it['value']}"}[it["kind"]]
                it["checked"] = _confirm(f"  {q}?")
    while True:
        ent = _prompt("add host (alias=target or user@host, blank to finish): ")
        if not ent:
            break
        used = taken | {x["alias"] for x in items if x["t"] in ("toggle", "locked")}
        alias, target = _parse_host_entry(ent, used)
        if alias is None:
            print(f"  {target}", file=sys.stderr)
            continue
        items.insert(_host_insert_at(items),
                     {"t": "toggle", "sec": "hosts", "kind": "host",
                      "alias": alias, "value": target, "checked": True})
        print(f"  {st.g}+{st.r} {alias} → {target}")
    repos, hosts, tbeam, stale_ok = _setup_result(items)
    if not (repos or hosts or tbeam or stale_ok):
        return True   # nothing selected — cmd_setup prints the no-op summary
    print(f"\n{st.b}review{st.r} — will append to ~/.zshrc.local:\n")
    if repos or hosts or tbeam:
        for ln in _setup_block(repos, hosts, tbeam, time.strftime("%Y-%m-%d")).splitlines():
            print(f"  {ln}")
    if stale_ok:
        sv = next(x["value"] for x in items if x.get("kind") == "stale")
        print(f"  (and comment out the stale entries: {sv})")
    if trailer and repos:
        print(f"  → {trailer}")
    return _confirm("proceed?")


def cmd_setup(cfg, args):
    """Interactive onboarding (see the section comment above). Phases: stale-entry
    comment-out (the one in-place edit, own confirm) → repo picker → host picker +
    manual loop → TBEAM_HOST offer → summary + single append + cache regen."""
    try:
        with open(ZSHRC_LOCAL, errors="ignore") as fh:
            local_text = fh.read()
    except OSError:
        local_text = ""
    f_repos, f_hosts, tbeam_set = _local_entries(local_text)
    land_hosts, err = _new_pick_hosts(cfg.hosts, args.hosts, args.no_hosts)
    if err:
        print(f"t setup: {err}", file=sys.stderr)
        return 1
    trailer = _setup_hosts_trailer(land_hosts)

    # dedup state: union of the live file lines and the (possibly stale) cache
    reg_paths = ({os.path.realpath(_expand_home(v)) for v in f_repos.values()} |
                 {os.path.realpath(v) for v in cfg.repos.values()})
    taken_keys = set(f_repos) | set(cfg.repos)
    host_keys = set(f_hosts) | set(cfg.hosts)
    host_targets = {_unquote(v) for v in f_hosts.values()} | set(cfg.hosts.values())

    # scan roots: args or ~/code; drop missing / worktree-rooted ones with a note
    roots, wt_root = [], os.path.realpath(cfg.worktree_root)
    for d in (args.dirs or [os.path.join(HOME, "code")]):
        d = os.path.abspath(os.path.expanduser(d))
        real = os.path.realpath(d)
        if not os.path.isdir(d):
            print(f"t setup: skipping {d} — not a directory", file=sys.stderr)
        elif real == wt_root or real.startswith(wt_root + os.sep):
            print(f"t setup: skipping {d} — per-session worktrees are managed by "
                  f"`t open`, not DEV_REPOS", file=sys.stderr)
        else:
            roots.append(d)
    if not roots:
        print("t setup: no scannable directories", file=sys.stderr)
        return 1

    cands = _scan_repos(roots, reg_paths | {cfg.worktree_root})
    proposals, collided = _propose_aliases(cands, taken_keys)
    ssh_hosts = [h for h in _parse_ssh_hosts(SSH_CONFIG)
                 if h not in host_keys and h not in host_targets]
    stale = sorted(k for k, v in f_repos.items() if not os.path.isdir(_expand_home(v)))

    # registered entries scoped to what this run looks at, for the "already in
    # your config" context each phase prints (silent skipping read as a bug);
    # stale entries are excluded — they get their own phase-0 section
    reg_repos = {k: v for k, v in
                 {**{k: _expand_home(v) for k, v in f_repos.items()}, **cfg.repos}.items()
                 if k not in stale
                 and any(v == r or v.startswith(r + os.sep) for r in roots)}
    reg_hosts = {**{k: _unquote(v) for k, v in f_hosts.items()}, **cfg.hosts}

    if args.dry_run or not (sys.stdin.isatty() and sys.stdout.isatty()):
        if reg_repos or reg_hosts:
            print(f"already registered: {len(reg_repos)} repo(s) under the scanned "
                  f"dirs, {len(reg_hosts)} host(s)")
        if stale:
            print("stale DEV_REPOS entries (path missing): " + ", ".join(stale))
        if not cands and not ssh_hosts:
            print("nothing to offer — every discovered repo/host is already registered")
        else:
            hp, _ = _propose_aliases_hosts(ssh_hosts, host_keys)
            print("would offer (shown as if everything were picked):\n")
            print(_setup_block({a: p for p, a in proposals.items()}, hp, None,
                               time.strftime("%Y-%m-%d")), end="")
            if cands and trailer:
                print(f"→ {trailer}")
        if args.dry_run:
            return 0
        print("\nt setup is interactive — run it from a terminal (or use --dry-run)",
              file=sys.stderr)
        return 1

    # one checklist screen: everything discovered, registered entries locked
    hp, _skipped = _propose_aliases_hosts(ssh_hosts, host_keys)
    tbeam_default = None
    if not tbeam_set:
        tbeam_default = next(iter(hp.values()), None) or next(iter(sorted(reg_hosts.values())), None)
    items = _setup_items([(p, proposals[p]) for p in cands], reg_repos,
                         list(hp.items()), reg_hosts, tbeam_default, stale,
                         ", ".join(_tilde(r) for r in roots))
    if not _selectable(items):   # no toggles at all → nothing the screen could do
        print("nothing to offer — every discovered repo and host is already registered")
        print("(add an unlisted host by hand: REMOTE_HOSTS[alias]=user@host in ~/.zshrc.local)")
        return 0
    all_keys = taken_keys | host_keys
    wizard_ran = True
    try:
        confirmed = _setup_wizard(items, all_keys, trailer)
    except Exception as e:
        wizard_ran = False
        print(f"(inline UI unavailable: {e} — falling back to prompts)", file=sys.stderr)
        confirmed = _setup_prompt_flow(items, all_keys, trailer)
    if not confirmed:
        if not wizard_ran:   # the wizard already printed its └ aborted line
            print("t setup: aborted — nothing written")
        return 1

    add_repos, add_hosts, tbeam_target, stale_ok = _setup_result(items)
    st = Style()
    if stale_ok and stale:
        local_text = _comment_stale(local_text, set(stale))
        with open(ZSHRC_LOCAL, "w") as fh:
            fh.write(local_text)
        print(f"✓ commented out stale entries: {', '.join(stale)}")
    if not add_repos and not add_hosts and not tbeam_target:
        if not stale_ok and not wizard_ran:   # the wizard showed "nothing selected"
            print("nothing selected — nothing written")
        return 0

    block = _setup_block(add_repos, add_hosts, tbeam_target, time.strftime("%Y-%m-%d"))
    _append_local(ZSHRC_LOCAL, block)
    # a fresh zsh -lic sources the updated ~/.zshrc.local; .zshrc's own
    # _t_sync_config call then regenerates the (now-stale) config cache
    zsh_capture("_t_sync_config")
    n = len(add_repos) + len(add_hosts) + (1 if tbeam_target else 0)
    if wizard_ran:   # its review left the exact block on screen — just summarize
        print(f"✓ appended {n} entr{'y' if n == 1 else 'ies'} to ~/.zshrc.local")
    else:
        print("✓ appended to ~/.zshrc.local:")
        for ln in block.splitlines():
            print(f"  {st.y}{ln}{st.r}" if ln.startswith("#") else f"  {ln}")
    if add_repos and land_hosts:
        _hosts_land(cfg, add_repos, args.hosts)
    if not os.environ.get("T_SETUP_SHIM"):
        print("run `source ~/.zshrc` (or open a new shell) to make the new shortcuts live")
    return 0


# ─── t new — create a repo here + on GitHub, register it here and on every host ──
#
# The wizard sibling of `t setup`: setup registers checkouts that already exist, new
# makes one from nothing and finishes every wiring step the session tooling depends
# on. Architecture is answers → pure plan → review → walk: the wizard (or the flags)
# only collects ANSWERS; _new_plan turns answers + the probed state of ~/code/<name>
# and GitHub into an ordered list of check-then-do step records; the review screen
# (and --dry-run) render that list; y walks it. Nothing mutates before y, and because
# every step re-checks its precondition, re-running after a failure (gh down, a host
# unreachable) resumes with the done steps rendered as `=`.
#
# Why each step exists — the path is FIXED to ~/code/<name> because t beam / t open -r
# resolve a repo by the same path on every host; origin/main MUST exist afterwards
# because _dev_worktree_create (.zshrc) branches every session off it, so a merely
# git-init'ed repo makes `t open` fall into the shared-tree fallback; squash-only +
# auto-merge + delete-branch-on-merge because the standing workflow is `gh pr merge
# --auto --squash`, which errors on a repo without auto-merge; and the host step
# because a repo registered on one machine is invisible to the others until someone
# clones + registers it there by hand — the manual sequence this verb replaces.

NEW_OWNER = "agenthangar"
_NEW_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$")
_NEW_SLUG = re.compile(r"^(?:git@github\.com:|ssh://git@github\.com/|https://github\.com/)"
                       r"([^/\s]+)/([^/\s]+?)(?:\.git)?/?$")
_NEW_STALE = "invalid choice: 'new-land'"
_NEW_SENTINEL = "new-land: "
_NEW_AGAIN = "\0again"   # the "none of these" pick row; never a valid repo name


def _new_validate_name(name):
    """GitHub repo-name rules (also the ~/code dir name): letters, digits, . _ -; no
    leading - or .; at most 100 chars; not . / .. / *.git. → error text or None."""
    if not name:
        return "a repo name is required"
    if not _NEW_NAME.match(name) or name.endswith(".git"):
        return (f"'{name}' is not a valid repo name — letters, digits, '.', '_', '-' only; "
                "no leading '-' or '.'; at most 100 chars")
    return None


def _new_name_warnings(name):
    return (["GitHub compares names case-insensitively — lowercase is the convention"]
            if name != name.lower() else [])


NEW_NAME_MODEL = "sonnet"
_NEW_NAME_MAX = 6


def _new_name_input(text):
    """Classify what the name step was given: one token → ("name", token), a
    description (any whitespace inside) → ("prompt", text). A name is validated by
    the caller, so a single bad token still errors as a name, never becomes a prompt."""
    text = text.strip()
    return ("prompt", text) if re.search(r"\s", text) else ("name", text)


def _new_name_prompt(desc, taken):
    """The `claude -p` brief for repo names from a description. Rules mirror
    _new_validate_name plus the house style (lowercase, hyphens, short — it is a
    ~/code dir, a DEV_REPOS key, and a tmux/worktree prefix), and `taken` keeps it
    off the names already on this machine."""
    avoid = ", ".join(sorted(taken)[:40])
    return (f"Suggest names for a new GitHub repo. What it is for:\n\"{desc}\"\n\n"
            f"Rules: lowercase letters, digits and hyphens only, 1-3 words joined by hyphens, "
            f"at most 24 chars, memorable and specific; no generic filler (app, tool, project). "
            + (f"Do not suggest any of these, they are taken: {avoid}.\n" if avoid else "\n")
            + f"Return ONLY a JSON array (no prose, no code fence) of {_NEW_NAME_MAX} objects, "
              "best first, each {\"name\": \"<name>\", \"why\": \"<reason in 8 words or fewer>\"}.")


def _new_parse_names(text, taken=()):
    """→ [(name, why)] from the model's reply: tolerate fences/prose around the
    array, lowercase, validate through _new_validate_name, drop taken names and
    duplicates, cap at _NEW_NAME_MAX. An unparseable reply is [] (the caller says so)."""
    m = re.search(r"\[.*\]", text or "", re.S)
    if not m:
        return []
    try:
        arr = json.loads(m.group(0))
    except ValueError:
        return []
    out, seen = [], set(taken)
    for o in arr if isinstance(arr, list) else []:
        name = str(o.get("name", "") if isinstance(o, dict) else o).strip().lower()
        if not name or name in seen or _new_validate_name(name):
            continue
        seen.add(name)
        out.append((name, str(o.get("why", "") if isinstance(o, dict) else "").strip()))
        if len(out) >= _NEW_NAME_MAX:
            break
    return out


def _new_taken_names(repo_paths, code_entries):
    """Names a suggestion must avoid: every DEV_REPOS basename + every ~/code entry."""
    return {os.path.basename(p.rstrip("/")) for p in repo_paths if p} | {e for e in code_entries if e}


def _new_path(name):
    return os.path.join(HOME, "code", name)


def _new_clone_url(owner, name):
    return f"git@github.com:{owner}/{name}.git"


def _new_repo_slug(url):
    """'owner/name' from a github.com remote URL (ssh, ssh://, https; optional .git),
    else None — a non-GitHub origin is one t new cannot wire."""
    m = _NEW_SLUG.match((url or "").strip())
    return f"{m.group(1)}/{m.group(2)}" if m else None


def _new_gh_repo_state(rc, out, err):
    """Classify `gh api repos/<slug>` (REST, because `gh repo view --json` has no
    auto-merge field): ('present', info) with the merge-setting fields, ('absent',
    None) on 404, ('error', msg) otherwise — the not-logged-in case gets its own
    message since it is the usual first-run failure."""
    e = (err or "").strip()
    if rc == 0:
        try:
            return "present", (json.loads(out or "null") or {})
        except json.JSONDecodeError:
            return "error", "gh returned unparseable JSON"
    if "HTTP 404" in e or "Not Found" in e:
        return "absent", None
    if "gh auth login" in e or "not logged in" in e.lower():
        return "error", "gh is not logged in — run `gh auth login`"
    return "error", (e.splitlines()[-1].strip() if e else f"gh api failed (rc {rc})")


def _new_settings_ok(info):
    """The merge policy every repo here runs on: squash-only PRs, auto-merge on, head
    branches deleted on merge (what `gh pr merge --auto --squash` needs)."""
    return bool(info.get("allow_auto_merge") and info.get("delete_branch_on_merge")
                and info.get("allow_squash_merge", True)
                and not info.get("allow_merge_commit") and not info.get("allow_rebase_merge"))


def _new_whence_kind(text):
    """`whence -w name` prints 'name: kind' — the kind, unless none/empty."""
    kind = (text or "").strip().rpartition(":")[2].strip()
    return kind if kind and kind != "none" else None


def _new_alias_check(alias, path, f_repos, cfg_repos, whence_kind=None):
    """Decide the register step: ('skip', why) when the alias already maps to this
    path (a path under a SECOND alias is fine — dot + dotfiles is the precedent),
    ('error', why) when the alias maps elsewhere, is not a valid key, or would shadow
    a zsh command/builtin/function (the generated `alias <k>="cd …"` shadows whatever
    <k> was — `t new test` must not break the shell), else ('run', None)."""
    if not _SETUP_KEY.match(alias or ""):
        return "error", f"'{alias}' is not a valid key (no spaces, ']' or '='; no leading '-')"
    real = os.path.realpath(path)
    reg = {k: os.path.realpath(v) for k, v in cfg_repos.items()}
    reg.update({k: os.path.realpath(_expand_home(v)) for k, v in f_repos.items()})
    if alias in reg:
        if reg[alias] == real:
            return "skip", f"DEV_REPOS[{alias}] already registered"
        return "error", f"alias '{alias}' already maps to {_tilde(reg[alias])} — pick another alias"
    if whence_kind:
        return "error", (f"'{alias}' is a zsh {whence_kind} — the cd shortcut would shadow it; "
                         "pick another alias")
    return "run", None


def _new_owner_rows(login, orgs, default):
    """Picker rows for the GitHub owner: the default first, then the rest sorted, the
    token's own user labelled (you). Only owners the token can actually see."""
    orgs = set(orgs or ())
    names = [n for n in [default] + sorted(orgs | ({login} if login else set()))
             if n and (n == login or n in orgs)]
    names = list(dict.fromkeys(names))
    return [(n, f"{n} (you)" if n == login else n) for n in names]


def _new_pick_hosts(cfg_hosts, only, none):
    """The hosts to clone + register on: none → [], `only` ('a,b') → those (an unknown
    alias is an error), else every REMOTE_HOSTS entry sorted. → (rows, error)."""
    if none:
        return [], None
    if only:
        picked = [h.strip() for h in only.split(",") if h.strip()]
        unknown = [h for h in picked if h not in cfg_hosts]
        if unknown:
            return [], (f"unknown host(s): {', '.join(unknown)} — REMOTE_HOSTS has: "
                        f"{', '.join(sorted(cfg_hosts)) or '(none)'}")
        return [(h, cfg_hosts[h]) for h in picked], None
    return sorted(cfg_hosts.items()), None


def _new_answers(args):
    """What the flags already decided; None = the wizard asks. hosts: None (ask),
    [] (--no-hosts) or the --hosts list."""
    vis = ("public" if getattr(args, "public", False)
           else "private" if getattr(args, "private", False) else None)
    hosts = None
    if getattr(args, "no_hosts", False):
        hosts = []
    elif getattr(args, "hosts", None):
        hosts = [h.strip() for h in args.hosts.split(",") if h.strip()]
    return {"name": getattr(args, "name", None) or None, "owner": getattr(args, "owner", None),
            "visibility": vis, "alias": getattr(args, "alias", None), "hosts": hosts,
            "prompt": (getattr(args, "prompt", None) or "").strip() or None}


def _new_state_summary(state):
    if not state["exists"]:
        return "new"
    if state["is_repo"]:
        o = _new_repo_slug(state.get("origin_url")) or state.get("origin_url")
        return (f"exists — repo on {state.get('branch') or 'detached HEAD'}"
                + (f", origin {o}" if o else ", no origin")
                + ("" if state["has_commits"] else ", no commits"))
    return "exists — NOT a git repo" if state["nonempty"] else "exists (empty)"


def _new_plan(name, alias, owner, private, path, state, gh, register, hosts):
    """The ordered check-then-do steps. Each record: step, do (run|skip|error), label,
    cmd (argv for subprocess steps; None for the python register step), warn. An
    origin that already points elsewhere RETARGETS the slug (with a warn) — settings
    and host clones must aim at the repo that exists, which also makes `t new
    <existing>` an adopt-and-finish-wiring command."""
    steps = []

    def rec(step, do, label, cmd=None, warn=None, **kw):
        steps.append({"step": step, "do": do, "label": label, "cmd": cmd, "warn": warn, **kw})

    slug, url = f"{owner}/{name}", _new_clone_url(owner, name)
    gh_kind, gh_info = gh
    p, br = _tilde(path), state.get("branch")
    if state["is_repo"]:
        if br != "main" and state["has_commits"]:
            rec("init", "error", f"{p} is on '{br or 'detached HEAD'}' with commits — expected main "
                                 "(git branch -m main, then re-run)")
        elif br != "main":
            rec("init", "run", f"switch {p} to main (no commits yet)",
                ["git", "-C", path, "symbolic-ref", "HEAD", "refs/heads/main"])
        else:
            rec("init", "skip", f"{p} exists on main")
    elif state["exists"] and state["nonempty"]:
        rec("init", "error", f"{p} exists and is not a git repo — move it aside or pick another name")
    else:
        rec("init", "run", f"git init -b main {p}", ["git", "init", "-q", "-b", "main", path])
    if state["has_commits"]:
        rec("commit", "skip", "already has commits")
    else:
        rec("commit", "run", f'git commit --allow-empty -m "init: {name}"',
            ["git", "-C", path, "commit", "-q", "--allow-empty", "-m", f"init: {name}"])
    created, origin = False, state.get("origin_url")
    if origin:
        oslug = _new_repo_slug(origin)
        if oslug is None:
            rec("remote", "error", f"origin {origin} is not a github.com repo — t new only wires GitHub")
        else:
            warn = None
            if oslug != slug:
                warn = f"origin is {oslug}, not {slug} — keeping the existing origin"
                slug, url = oslug, origin
            rec("remote", "skip", f"origin → {slug}", warn=warn)
    elif gh_kind == "error":
        rec("remote", "error", gh_info)
    elif gh_kind == "present":
        rec("remote", "run", f"git remote add origin {url} (already on GitHub)",
            ["git", "-C", path, "remote", "add", "origin", url])
    else:
        created, vis = True, ("--private" if private else "--public")
        rec("remote", "run", f"gh repo create {slug} {vis} --source {p} --push",
            ["gh", "repo", "create", slug, vis, "--source", path, "--remote", "origin", "--push"])
    if state["has_origin_main"]:
        rec("push", "skip", "origin/main present")
    elif created:
        rec("push", "skip", "pushed by gh repo create")
    elif steps[-1]["do"] != "error":
        rec("push", "run", "git push -u origin main",
            ["git", "-C", path, "push", "-q", "-u", "origin", "main"])
    if gh_kind == "error":
        rec("settings", "error", gh_info)
    elif gh_kind == "present" and _new_settings_ok(gh_info):
        rec("settings", "skip", f"{slug}: squash-only + auto-merge already set")
    else:
        warn = None
        if gh_kind == "present" and bool(gh_info.get("private")) != private:
            warn = (f"{slug} exists as {'private' if gh_info.get('private') else 'public'} — "
                    "visibility left as is")
        rec("settings", "run", f"gh repo edit {slug}: squash-only + auto-merge + delete-branch-on-merge",
            ["gh", "repo", "edit", slug, "--enable-auto-merge", "--delete-branch-on-merge",
             "--enable-squash-merge", "--enable-merge-commit=false", "--enable-rebase-merge=false"],
            warn=warn)
    rk, rmsg = register
    rec("register", rk, rmsg or f"DEV_REPOS[{alias}]={_homeify(path)} → ~/.zshrc.local",
        alias=alias, path=path)
    for h, target in hosts:
        rec(f"host:{h}", "run", f"{h}: clone + register", _new_ssh_argv(target, url, name, alias),
            host=h, target=target, url=url)
    return steps


def _new_ssh_argv(target, url, name, alias):
    """`ssh <target> "zsh -lic 't new-land …'"` — two quoting layers (the cmd_on
    precedent): the inner words for the far zsh -c, the whole thing as ONE ssh token
    since ssh re-splits its command on spaces. zsh -lic because ~/bin/t is only on
    the interactive PATH (the _dev_rows_all contract)."""
    inner = " ".join(shlex.quote(a) for a in ("t", "new-land", url, name, alias))
    return ["ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", target,
            f"zsh -lic {shlex.quote(inner)}"]


def _new_host_outcome(rc, out, err):
    """Classify one host's `t new-land` run → (status, detail). An unreachable host
    (ssh rc 255, or our own timeout 124 — ConnectTimeout does not cover DNS when
    tailscale is down) vs stale dotfiles there (argparse rejects the verb: rc 2 +
    'invalid choice') vs no `t` at all (rc 127) vs a real failure (the last stderr
    lines). Success reads the far side's `new-land: …` stdout sentinel — a `zsh -lic`
    stdout can carry rc noise, so the summary is prefixed, not bare."""
    e, o = (err or "").strip(), (out or "").strip()
    if rc in (255, 124):
        return "unreachable", ""
    if rc == 2 and _NEW_STALE in e:
        return "stale", ""
    if rc == 127 or "command not found: t" in e:
        return "missing", ""
    if rc == 0:
        for ln in reversed(o.splitlines()):
            if ln.startswith(_NEW_SENTINEL):
                return "ok", ln[len(_NEW_SENTINEL):].strip()
        return "ok", "done"
    tail = [ln.strip() for ln in e.splitlines() if ln.strip()][-3:]
    return "failed", (" / ".join(tail) if tail else f"rc {rc}")


def _new_host_line(host, status, detail, name):
    """The one line per host, shared by t new and t setup."""
    if status == "ok":
        return f"✓ {host}: {detail}"
    if status == "unreachable":
        return f"⚠ {host}: unreachable — re-run `t new {name}` later, it resumes"
    if status == "stale":
        return f"⚠ {host}: stale dotfiles — run `dots` there, then re-run `t new {name}`"
    if status == "missing":
        return f"⚠ {host}: no `t` there — run install.sh on it, then re-run `t new {name}`"
    return f"⚠ {host}: failed — {detail}"


def _new_land_plan(name, alias, url, path, state, register):
    """The far side's steps: clone unless the dir already is a clone of the same
    repo (ssh vs https origins match by slug), then the same register record."""
    steps, want, p = [], _new_repo_slug(url), _tilde(path)

    def rec(step, do, label, cmd=None, **kw):
        steps.append({"step": step, "do": do, "label": label, "cmd": cmd, "warn": None, **kw})

    if state["is_repo"]:
        have = _new_repo_slug(state.get("origin_url"))
        if have and have == want:
            rec("clone", "skip", f"{p} already cloned")
        elif have:
            rec("clone", "error", f"{p} exists with origin {have}, expected {want}")
        else:
            rec("clone", "error", f"{p} exists with no origin — expected a clone of {want}")
    elif state["exists"] and state["nonempty"]:
        rec("clone", "error", f"{p} exists and is not a git repo")
    else:
        rec("clone", "run", f"git clone {url} {p}", ["git", "clone", "-q", url, path])
    rk, rmsg = register
    rec("register", rk, rmsg or f"DEV_REPOS[{alias}]={_homeify(path)}", alias=alias, path=path)
    return steps


def _new_land_summary(steps):
    do = {s["step"]: s["do"] for s in steps}
    c, r = do.get("clone"), do.get("register")
    if c == "run" and r == "run":
        return "cloned + registered"
    if c == "skip" and r == "skip":
        return "already set up"
    if c == "skip":
        return "clone present, registered"
    return "cloned (alias already registered)"


def _new_render(steps, st):
    """Review / dry-run lines: + run, = skip, ✗ error, ⚠ warn, → the hosts."""
    lines, hosts = [], []
    for s in steps:
        if s["step"].startswith("host:"):
            hosts.append(s["host"])
            continue
        if s["do"] == "run":
            lines.append(f"{st.g}+{st.r} {s['label']}")
        elif s["do"] == "skip":
            lines.append(f"{st.y}= {s['label']}{st.r}")
        else:
            lines.append(f"{st.b}✗ {s['label']}{st.r}")
        if s.get("warn"):
            lines.append(f"{st.y}  ⚠ {s['warn']}{st.r}")
    if hosts:
        lines.append(f"{st.c}→{st.r} {', '.join(hosts)}: clone + register")
    return lines


def _setup_hosts_trailer(hosts):
    """The review-screen line that says `t setup` will ALSO clone + register the
    picked repos on every host — the review must state everything `y` does."""
    return ("then clone + register the picked repos on: " + ", ".join(h for h, _ in hosts)
            if hosts else None)


def _new_sh_state(path):
    """Probe ~/code/<name>: existence, emptiness, repo-ness (.git file OR dir, the
    _scan_repos rule), commits, current branch, origin, and whether origin/main is
    known locally — everything _new_plan's check-then-do needs, in one place."""
    s = {"exists": os.path.exists(path), "nonempty": False, "is_repo": False,
         "has_commits": False, "branch": None, "origin_url": None, "has_origin_main": False}
    if not s["exists"]:
        return s
    try:
        s["nonempty"] = bool(os.listdir(path))
    except OSError:
        s["nonempty"] = True
    s["is_repo"] = os.path.exists(os.path.join(path, ".git"))
    if not s["is_repo"]:
        return s

    def g(*a):
        return _run(["git", "-C", path, *a])
    s["has_commits"] = g("rev-parse", "-q", "--verify", "HEAD").returncode == 0
    r = g("symbolic-ref", "--short", "-q", "HEAD")
    s["branch"] = r.stdout.strip() or None if r.returncode == 0 else None
    r = g("remote", "get-url", "origin")
    s["origin_url"] = r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None
    s["has_origin_main"] = g("rev-parse", "-q", "--verify", "refs/remotes/origin/main").returncode == 0
    return s


def _new_sh_gh(slug):
    if not shutil.which("gh"):
        return "error", "gh not found — brew install gh (Linux: apt install gh)"
    r = _run(["gh", "api", f"repos/{slug}"], timeout=30)
    return _new_gh_repo_state(r.returncode, r.stdout, r.stderr)


def _new_sh_suggest(desc, taken):
    """Ask Claude (`claude -p`, the t find precedent — the real binary, never the
    zsh wrapper) for repo names. → (rows, error): rows from _new_parse_names, or
    an error line when the CLI is missing, times out, or replies with no names."""
    claude_bin = shutil.which("claude") or os.path.join(HOME, ".local", "bin", "claude")
    if not os.path.exists(claude_bin):
        return [], "claude CLI not found — type a name instead"
    try:
        p = subprocess.run([claude_bin, "-p", "--model", NEW_NAME_MODEL, "--output-format", "json"],
                           input=_new_name_prompt(desc, taken), capture_output=True, text=True,
                           timeout=90)
        res = json.loads(p.stdout).get("result", "") if p.stdout.strip() else ""
    except subprocess.TimeoutExpired:
        return [], "claude took too long — type a name instead"
    except (OSError, ValueError) as e:
        return [], f"claude failed ({e}) — type a name instead"
    rows = _new_parse_names(res, taken)
    if not rows:
        tail = (p.stderr or "").strip().splitlines()
        return [], "claude returned no usable names" + (f" ({tail[-1]})" if tail else "")
    return rows, None


def _new_sh_owners():
    """(login, [orgs]) the gh token can create under; ([], None) without gh."""
    if not shutil.which("gh"):
        return None, []
    u = _run(["gh", "api", "user", "--jq", ".login"], timeout=30)
    o = _run(["gh", "api", "user/orgs", "--jq", ".[].login"], timeout=30)
    return ((u.stdout.strip() or None) if u.returncode == 0 else None,
            o.stdout.split() if o.returncode == 0 else [])


def _new_sh_whence(alias):
    """`whence -w <alias>` in a login+interactive zsh (so functions/aliases from .zshrc
    count), run DETACHED — stdin /dev/null + its own session. This is called from
    inside the raw-mode wizard, and an interactive zsh that inherits the tty makes
    itself the terminal's foreground process group on startup; when it exits the
    wizard's next read of the tty fails with EIO (or SIGTTIN) — the same family of bug
    as the SIGTTOU suspension an undetached `zsh -lic` scan once caused. Detached,
    it has no controlling terminal to take. None on any failure (no zsh, timeout)."""
    try:
        r = subprocess.run(["zsh", "-lic", ZSH_PRELUDE + f"whence -w {shlex.quote(alias)}"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, text=True, start_new_session=True,
                           timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return _new_whence_kind(r.stdout)


def _new_sh_register(alias, path, tool):
    _append_local(ZSHRC_LOCAL, _setup_block({alias: path}, {}, None,
                                            time.strftime("%Y-%m-%d"), tool=tool))
    zsh_capture("_t_sync_config")   # regenerate the config cache (fresh zsh -lic sources .zshrc.local)


def _new_sh_host(argv):
    r = _run(argv, timeout=300)
    return _new_host_outcome(r.returncode, r.stdout, r.stderr)


def _hosts_land(cfg, repos, only=None):
    """Clone + register {alias: path} on every REMOTE_HOSTS host (or the `only` subset)
    via `t new-land` over ssh; one line per (repo, host). Shared by t new and t setup.
    A repo with no origin has nothing to clone — noted, never an error."""
    st = Style()
    hosts, err = _new_pick_hosts(cfg.hosts, only, False)
    if err:
        print(f"⚠ {err}")
        return
    if not hosts:
        print(f"{st.y}(no REMOTE_HOSTS configured — nothing to clone elsewhere){st.r}")
        return
    for alias, path in repos.items():
        r = _run(["git", "-C", path, "remote", "get-url", "origin"])
        url = r.stdout.strip() if r.returncode == 0 else ""
        name = os.path.basename(path.rstrip("/"))
        if not url:
            print(f"{st.y}↷ {alias}: no origin remote — nothing to clone on hosts{st.r}")
            continue
        for h, target in hosts:
            status, detail = _new_sh_host(_new_ssh_argv(target, url, name, alias))
            print(_new_host_line(h, status, detail, name))


def _new_wizard(cfg, answers, ctx):
    """The t new UI: clack-style steps on the rail — name, path (info), owner,
    visibility, alias, hosts — each collapsing to a ◇ line (a step a flag already
    answered collapses at once; owner + visibility LOCK to the existing origin/GitHub
    repo when there is one), then a diff-style review of the plan: y applies, n goes
    back to the owner step, q/ctrl-c aborts with nothing created. Returns (steps,
    answers) — steps may hold error records the caller reports — or None on abort.
    Raises when raw mode is unavailable → _new_prompt_flow."""
    ui = _RailUI()
    st, rail = ui.st, ui.rail
    ui.out.write(f"{st.y}┌{st.r}  {st.b}t new{st.r} {st.y}· create a repo — nothing is created "
                 f"until you confirm{st.r}\n{rail}\n")
    ui.raw()
    result = None
    try:
        name, desc = answers["name"], answers["prompt"]
        while not name:
            if desc is None:
                n = ui.cooked_input("│  repo name (or describe it in a sentence for suggestions) → ")
                if not n:
                    return None
                kind, text = _new_name_input(n)
                if kind == "name":
                    err = _new_validate_name(text)
                    if err:
                        ui.commit([f"{rail}  {st.y}⚠ {err}{st.r}"])
                        continue
                    name = text
                    break
                desc = text
            ui.done("describe", desc)
            # the head repaints in place under the ◇ line; pick() replaces it
            ui.repaint(ui.head("name", f"asking claude ({NEW_NAME_MODEL}) for names…"))
            rows, err = ctx["suggest"](desc, ctx["taken"])
            desc = None
            if err:
                ui.commit([f"{rail}  {st.y}⚠ {err}{st.r}"])
                continue
            choices = [(n, f"{n}  {st.y}{why}{st.r}" if why else n) for n, why in rows]
            choices.append((_NEW_AGAIN, f"{st.y}none of these — type a name or describe it again{st.r}"))
            pick = ui.pick("name", choices)
            if pick is None:
                return None
            if pick != _NEW_AGAIN:
                name = pick
        answers["name"] = name
        ui.done("name", name)
        path, state = ctx["probe"](name)
        ui.done("path", f"{_tilde(path)} {st.y}· {_new_state_summary(state)}{st.r}")
        for w in _new_name_warnings(name):
            ui.commit([f"{rail}  {st.y}⚠ {w}{st.r}"])
        oslug = _new_repo_slug(state.get("origin_url")) if state.get("origin_url") else None
        owner_rows = None
        while True:
            if oslug:
                owner = oslug.split("/")[0]
                ui.done("owner", f"{owner} {st.y}· from origin {oslug}{st.r}")
            elif answers["owner"]:
                owner = answers["owner"]
                ui.done("owner", owner)
            else:
                if owner_rows is None:
                    owner_rows = _new_owner_rows(*ctx["owners"](), NEW_OWNER)
                if owner_rows:
                    owner = ui.pick("owner", owner_rows)
                    if owner is None:
                        return None
                else:
                    owner = ui.cooked_input("│  github owner → ", NEW_OWNER, prefill=NEW_OWNER)
                ui.done("owner", owner)
            slug = oslug or f"{owner}/{name}"
            gh = ctx["gh"](slug)
            if gh[0] == "present":
                private = bool(gh[1].get("private"))
                ui.done("visibility", f"{'private' if private else 'public'} {st.y}· {slug} exists{st.r}")
            elif answers["visibility"]:
                private = answers["visibility"] == "private"
                ui.done("visibility", answers["visibility"])
            else:
                v = ui.pick("visibility", [("private", "private"), ("public", "public")])
                if v is None:
                    return None
                private = v == "private"
                ui.done("visibility", v)
            alias = answers["alias"] or name
            while True:
                a = ui.cooked_input("│  alias (cd shortcut + DEV_REPOS key) → ", alias, prefill=alias)
                register = _new_alias_check(a, path, ctx["f_repos"], cfg.repos, ctx["whence"](a))
                if register[0] == "error":
                    ui.commit([f"{rail}  {st.y}⚠ {register[1]}{st.r}"])
                    alias = a
                    continue
                alias = a
                break
            ui.done("alias", alias + (f" {st.y}· already registered{st.r}" if register[0] == "skip" else ""))
            if answers["hosts"] is not None:
                hosts = [(h, cfg.hosts[h]) for h in answers["hosts"]]
                ui.done("hosts", ", ".join(h for h, _ in hosts) or "none")
            elif not cfg.hosts:
                hosts = []
                ui.done("hosts", f"{st.y}none configured (REMOTE_HOSTS){st.r}")
            else:
                rows = [(h, f"{h}  {st.y}{t}{st.r}") for h, t in sorted(cfg.hosts.items())]
                picked = ui.pick("hosts", rows, multi=True, marked=range(len(rows)))
                if picked is None:
                    return None
                hosts = [(h, cfg.hosts[h]) for h in picked]
                ui.done("hosts", ", ".join(picked) or "none")
            answers.update({"owner": owner, "visibility": "private" if private else "public",
                            "alias": alias, "hosts": [h for h, _ in hosts]})
            steps = _new_plan(name, alias, owner, private, path, state, gh, register, hosts)
            errs = [s for s in steps if s["do"] == "error"]
            body = [f"{rail}  {ln}" for ln in _new_render(steps, st)]
            if errs:
                ui.commit([f"{st.b}✗{st.r}  {st.b}review — cannot continue{st.r}"] + body)
                result = (steps, answers)
                return result
            # windowed + scrollable: on a phone the argv lines wrap and the whole
            # plan is taller than the screen — the y/n/q hint must stay reachable
            k = ui.page("review — what will run", body, accept=("y", "n", "esc", "q", "abort"),
                        keys="y apply · n back · q quit")
            if k == "y":
                ui.commit([f"{st.g}◇{st.r}  {st.b}review{st.r}"] + body)
                result = (steps, answers)
                return result
            if k in ("n", "esc"):
                ui.commit([f"{rail}  {st.y}↶ back — from the owner step{st.r}"])
                continue
            return None
    except KeyboardInterrupt:
        return None
    finally:
        ui.restore()
        if result is None:
            ui.out.write(f"{st.y}└{st.r} {st.y}· aborted — nothing created{st.r}\n")


def _new_prompt_flow(cfg, answers, ctx):
    """Plain-prompt fallback (TERM=dumb, no raw mode): the same questions as
    _new_wizard over input(), then the same review gate. → (steps, answers) or None."""
    st = Style()
    name, desc = answers["name"], answers["prompt"]
    while not name:
        if desc is None:
            n = _prompt("repo name (or describe it in a sentence for suggestions): ")
            if n is None:
                return None
            kind, text = _new_name_input(n)
            if kind == "name":
                err = _new_validate_name(text)
                if err:
                    print(f"  {err}", file=sys.stderr)
                    continue
                name = text
                break
            desc = text
        print(f"  asking claude ({NEW_NAME_MODEL}) for names…")
        rows, err = ctx["suggest"](desc, ctx["taken"])
        desc = None
        if err:
            print(f"  {err}", file=sys.stderr)
            continue
        for i, (n, why) in enumerate(rows, 1):
            print(f"  {i}) {n}" + (f"  — {why}" if why else ""))
        r = _prompt(f"  pick 1-{len(rows)}, or type a name / a new description: ")
        if r is None:
            return None
        if r.isdigit() and 1 <= int(r) <= len(rows):
            name = rows[int(r) - 1][0]
        elif r:
            kind, text = _new_name_input(r)
            if kind == "prompt":
                desc = text
            elif _new_validate_name(text):
                print(f"  {_new_validate_name(text)}", file=sys.stderr)
            else:
                name = text
    answers["name"] = name
    path, state = ctx["probe"](name)
    print(f"  path: {_tilde(path)} · {_new_state_summary(state)}")
    oslug = _new_repo_slug(state.get("origin_url")) if state.get("origin_url") else None
    if oslug:
        owner = oslug.split("/")[0]
        print(f"  owner: {owner} (from origin {oslug})")
    elif answers["owner"]:
        owner = answers["owner"]
    else:
        rows = _new_owner_rows(*ctx["owners"](), NEW_OWNER)
        choices = ", ".join(v for v, _ in rows)
        owner = _prompt(f"  github owner [{NEW_OWNER}]{' (' + choices + ')' if choices else ''}: ",
                        NEW_OWNER)
        if owner is None:
            return None
    slug = oslug or f"{owner}/{name}"
    gh = ctx["gh"](slug)
    if gh[0] == "present":
        private = bool(gh[1].get("private"))
        print(f"  visibility: {'private' if private else 'public'} ({slug} exists)")
    elif answers["visibility"]:
        private = answers["visibility"] == "private"
    else:
        private = not _confirm("  public?")
    alias = answers["alias"] or name
    while True:
        a = _prompt(f"  alias [{alias}]: ", alias)
        if a is None:
            return None
        register = _new_alias_check(a, path, ctx["f_repos"], cfg.repos, ctx["whence"](a))
        if register[0] == "error":
            print(f"  {register[1]}", file=sys.stderr)
            alias = a
            continue
        alias = a
        break
    if answers["hosts"] is not None:
        hosts = [(h, cfg.hosts[h]) for h in answers["hosts"]]
    else:
        hosts = []
        for h, t in sorted(cfg.hosts.items()):
            r = _prompt(f"  clone + register on {h} ({t})? [Y/n] ", "y")
            if r is None:
                return None
            if r.lower() in ("y", "yes"):
                hosts.append((h, t))
    answers.update({"owner": owner, "visibility": "private" if private else "public",
                    "alias": alias, "hosts": [h for h, _ in hosts]})
    steps = _new_plan(name, alias, owner, private, path, state, gh, register, hosts)
    print(f"\n{st.b}review{st.r} — what will run:\n")
    for ln in _new_render(steps, st):
        print(f"  {ln}")
    if any(s["do"] == "error" for s in steps):
        return steps, answers
    return (steps, answers) if _confirm("proceed?") else None


def _new_resolve(cfg, answers, ctx):
    """The no-wizard path (-y / --dry-run / no tty): fill every unanswered step with
    its default — owner from the origin else NEW_OWNER, private, alias = name, every
    host — and build the plan."""
    name = answers["name"]
    path, state = ctx["probe"](name)
    oslug = _new_repo_slug(state.get("origin_url")) if state.get("origin_url") else None
    owner = oslug.split("/")[0] if oslug else (answers["owner"] or NEW_OWNER)
    gh = ctx["gh"](oslug or f"{owner}/{name}")
    if gh[0] == "present":
        private = bool(gh[1].get("private"))
    else:
        private = answers["visibility"] != "public"
    alias = answers["alias"] or name
    register = _new_alias_check(alias, path, ctx["f_repos"], cfg.repos, ctx["whence"](alias))
    if answers["hosts"] is None:
        hosts, _ = _new_pick_hosts(cfg.hosts, None, False)
    else:
        hosts = [(h, cfg.hosts[h]) for h in answers["hosts"]]
    answers.update({"owner": owner, "visibility": "private" if private else "public",
                    "alias": alias, "hosts": [h for h, _ in hosts]})
    return _new_plan(name, alias, owner, private, path, state, gh, register, hosts)


def _new_walk(steps, answers, pre="", close=False):
    """Run the plan in order: `=` for a skip, ✓ per step, the register step through
    _new_sh_register, then one line per host. A failing step stops with the resume
    hint; host outcomes never change the rc (the local repo is complete, and the
    shim's `source ~/.zshrc` reload rides on rc 0)."""
    st = Style()
    name, alias, registered = answers["name"], answers["alias"], False
    for s in steps:
        if s["step"].startswith("host:"):
            continue
        if s["do"] == "skip":
            print(f"{pre}{st.y}= {s['label']}{st.r}")
            continue
        if s["step"] == "register":
            _new_sh_register(alias, s["path"], "t new")
            registered = True
        else:
            if s["step"] == "init" and s["cmd"][:2] == ["git", "init"]:
                os.makedirs(os.path.dirname(s["cmd"][-1]), exist_ok=True)
            r = _run(s["cmd"], timeout=300)
            if r.returncode != 0:
                tail = [ln.strip() for ln in (r.stderr or "").splitlines() if ln.strip()][-3:]
                print(f"{pre}{st.b}✗ {s['label']}{st.r}")
                print(f"t new: {s['step']} failed — {' / '.join(tail) or f'rc {r.returncode}'}\n"
                      f"  (fix that, then re-run `t new {name}` — it resumes)", file=sys.stderr)
                if close:
                    print(f"{st.y}└{st.r} {st.y}· stopped{st.r}")
                return 1
        print(f"{pre}✓ {s['label']}")
        if s.get("warn"):
            print(f"{pre}{st.y}  ⚠ {s['warn']}{st.r}")
    for s in steps:
        if s["step"].startswith("host:"):
            status, detail = _new_sh_host(s["cmd"])
            print(f"{pre}{_new_host_line(s['host'], status, detail, name)}")
    tail = f"next: {st.b}t open {alias}{st.r}"
    print(f"{st.y}└{st.r}  {st.g}✓{st.r} {name} — {tail}" if close else f"✓ {name} — {tail}")
    if registered and not os.environ.get("T_SETUP_SHIM"):
        print("run `source ~/.zshrc` (or open a new shell) to make the new shortcut live")
    return 0


def cmd_new(cfg, args):
    """See the section comment above. Flags pre-answer wizard steps; -y / --dry-run /
    no tty skip the wizard and take the defaults for the rest."""
    answers = _new_answers(args)
    if answers["name"] and answers["prompt"]:
        print("t new: give a name OR --prompt, not both", file=sys.stderr)
        return 1
    if answers["name"]:
        err = _new_validate_name(answers["name"])
        if err:
            print(f"t new: {err}", file=sys.stderr)
            return 1
    if answers["hosts"]:
        _, err = _new_pick_hosts(cfg.hosts, ",".join(answers["hosts"]), False)
        if err:
            print(f"t new: {err}", file=sys.stderr)
            return 1
    try:
        with open(ZSHRC_LOCAL, errors="ignore") as fh:
            local_text = fh.read()
    except OSError:
        local_text = ""
    f_repos, _, _ = _local_entries(local_text)
    registered = set(f_repos) | set(cfg.repos)
    gh_cache = {}

    def gh_for(slug):
        if slug not in gh_cache:
            gh_cache[slug] = _new_sh_gh(slug)
        return gh_cache[slug]
    try:
        code_entries = os.listdir(os.path.join(HOME, "code"))
    except OSError:
        code_entries = []
    ctx = {"probe": lambda n: (_new_path(n), _new_sh_state(_new_path(n))),
           "gh": gh_for, "owners": _new_sh_owners, "f_repos": f_repos,
           "whence": lambda a: None if a in registered else _new_sh_whence(a),
           "suggest": _new_sh_suggest,
           "taken": _new_taken_names(cfg.repos.values(), code_entries)}
    st = Style()
    tty_ok = sys.stdin.isatty() and sys.stdout.isatty()
    if args.dry_run or args.yes or not tty_ok:
        if not answers["name"] and answers["prompt"]:
            # no wizard to pick from: the model's first suggestion is the name
            rows, err = _new_sh_suggest(answers["prompt"], ctx["taken"])
            if err:
                print(f"t new: {err}", file=sys.stderr)
                return 1
            answers["name"] = rows[0][0]
            print(f"t new: name {answers['name']} (from --prompt; also suggested: "
                  f"{', '.join(n for n, _ in rows[1:]) or 'nothing else'})")
        if not answers["name"]:
            print("t new: a repo name (or --prompt <description>) is required without the "
                  "wizard (t new <name> …)", file=sys.stderr)
            return 1
        steps = _new_resolve(cfg, answers, ctx)
        errs = [s for s in steps if s["do"] == "error"]
        if args.dry_run or not args.yes:
            print(f"t new {answers['name']} → {answers['owner']} ({answers['visibility']}), "
                  f"alias {answers['alias']}:")
            for ln in _new_render(steps, st):
                print(f"  {ln}")
        for e in errs:
            print(f"t new: {e['label']}", file=sys.stderr)
        if args.dry_run or errs:
            return 1 if errs else 0
        if not args.yes:
            print("\nt new is interactive — run it from a terminal, or pass -y with the flags",
                  file=sys.stderr)
            return 1
        return _new_walk(steps, answers)
    wizard_ran = True
    try:
        r = _new_wizard(cfg, answers, ctx)
    except Exception as e:
        wizard_ran = False
        print(f"(inline UI unavailable: {e} — falling back to prompts)", file=sys.stderr)
        r = _new_prompt_flow(cfg, answers, ctx)
    if r is None:
        if not wizard_ran:
            print("t new: aborted — nothing created")
        return 1
    steps, answers = r
    errs = [s for s in steps if s["do"] == "error"]
    if errs:
        for e in errs:
            print(f"t new: {e['label']}", file=sys.stderr)
        if wizard_ran:
            print(f"{st.y}└{st.r} {st.y}· nothing created{st.r}")
        return 1
    return _new_walk(steps, answers, pre=f"{st.y}│{st.r}  " if wizard_ran else "", close=wizard_ran)


def cmd_new_land(cfg, args):
    """ON the host (over ssh from t new / t setup): clone <url> to ~/code/<name> unless
    it is already that clone, register DEV_REPOS[<alias>] here, print the sentinel
    summary line the caller parses. Errors go to stderr with rc 1."""
    err = _new_validate_name(args.name)
    if err:
        print(f"t new-land: {err}", file=sys.stderr)
        return 1
    path = _new_path(args.name)
    try:
        with open(ZSHRC_LOCAL, errors="ignore") as fh:
            local_text = fh.read()
    except OSError:
        local_text = ""
    f_repos, _, _ = _local_entries(local_text)
    whence = None if args.alias in (set(f_repos) | set(cfg.repos)) else _new_sh_whence(args.alias)
    register = _new_alias_check(args.alias, path, f_repos, cfg.repos, whence)
    steps = _new_land_plan(args.name, args.alias, args.url, path, _new_sh_state(path), register)
    errs = [s for s in steps if s["do"] == "error"]
    if errs:
        for e in errs:
            print(f"t new-land: {e['label']}", file=sys.stderr)
        return 1
    for s in steps:
        if s["do"] != "run":
            continue
        if s["step"] == "clone":
            os.makedirs(os.path.dirname(path), exist_ok=True)
            r = _run(s["cmd"], timeout=600)
            if r.returncode != 0:
                tail = [ln.strip() for ln in (r.stderr or "").splitlines() if ln.strip()][-3:]
                print(f"t new-land: clone failed — {' / '.join(tail) or f'rc {r.returncode}'}",
                      file=sys.stderr)
                return 1
        else:
            _new_sh_register(args.alias, path, "t new")
    print(_NEW_SENTINEL + _new_land_summary(steps))
    return 0


# ─── shell-bound verbs — handled by the t() zsh shim, not the bin ──────────────
# These cd the calling shell / exec `claude -r` in the current terminal / hand off
# the tpush sentinel — a subprocess cannot. The t() function in .zshrc intercepts
# them and calls the _t_dev/_t_pop/_t_push/_t_resume/_t_find/_t_beam/_t_cd helpers. Reaching
# the bin here means it was invoked DIRECTLY (e.g. `command t open`, or a context with no
# t() function) — which cannot perform the shell action.

_SHELL_BOUND = {"open", "pop", "push", "resume", "beam", "find", "cd", "__resolve"}


def cmd_pending(cfg, args):
    print(f"t {args._verb}: this verb runs in the shell via the `t` function, not the "
          f"bin. You reached bin/t directly (e.g. `command t {args._verb}`) — run "
          f"`t {args._verb} …` in an interactive zsh instead.", file=sys.stderr)
    return 2


# ─── install — install + log in the agent CLIs (claude · codex · cursor) ───────
#
# The onboarding step `t setup` never covered: the agent binaries themselves. Before
# this, a fresh box (or a remote host) got Claude Code, Codex, and the Cursor CLI by
# hand, each from a different vendor page, then logged into each — and which of the
# three was missing on which host was nobody's business until `t open --codex` said
# "command not found" there. Same shape as `t setup` because it is the same job:
# probe what is already there, offer the rest on ONE list with the present entries
# locked under a ✓, show the exact commands as a review, run them on y.
#
# _INSTALL_AGENTS is the single table every surface reads — the probe, the plan,
# `t doctor`'s agent rows, and the parity matrix (_AGENT_PARITY, rendered into
# `t -h`, `t install --status`, README, and `help`); add an agent there and the rest
# follows. Install commands are the vendors' published one-liners, shown VERBATIM in
# the review so nothing runs that the screen did not state — a curl-pipe-sh is
# exactly the kind of command you want to read before it runs. Login steps are
# INTERACTIVE (inherited stdio: they open a browser or print a device code), so the
# walk runs them after the rail UI has restored the terminal; over ssh (or
# --headless) the device-code variants are used, since the browser is not where you
# are (the cursor-beam keychain precedent). Hosts run the same verb over `ssh -t`
# with -y, so a device-code login there prompts through the TTY.

INSTALL_AGENTS = ("claude", "codex", "cursor")

_CURL_CLAUDE = "curl -fsSL https://claude.ai/install.sh | bash"
_CURL_CODEX = "curl -fsSL https://chatgpt.com/codex/install.sh | sh"
_CURL_CURSOR = "curl https://cursor.com/install -fsS | bash"

_INSTALL_AGENTS = {
    "claude": {
        "label": "Claude Code", "bin": "claude",
        "install": {"darwin": _CURL_CLAUDE, "linux": _CURL_CLAUDE},
        "login": ["claude", "auth", "login"],
        "login_headless": ["claude", "auth", "login"],
        "status": ["claude", "auth", "status"],
        "update": ["claude", "update"],
        "note": None,
    },
    "codex": {
        "label": "Codex CLI (OpenAI)", "bin": "codex",
        # brew's cask on a Mac that has brew (updatable with brew upgrade --cask); the
        # vendor script everywhere else — no Node dependency on the Linux node
        "install": {"darwin": "brew install --cask codex", "darwin-nobrew": _CURL_CODEX,
                    "linux": _CURL_CODEX},
        "login": ["codex", "login"],
        "login_headless": ["codex", "login", "--device-auth"],
        "status": ["codex", "login", "status"],
        "update": ["codex", "update"],
        "note": ("then open codex once and accept the dotfiles SessionStart hook under "
                 "/hooks — t doctor checks"),
    },
    "cursor": {
        "label": "Cursor CLI (cursor-agent)", "bin": "cursor-agent",
        "install": {"darwin": _CURL_CURSOR, "linux": _CURL_CURSOR},
        "login": ["cursor-agent", "login"],
        "login_headless": ["env", "NO_OPEN_BROWSER=1", "cursor-agent", "login"],
        "status": ["cursor-agent", "status"],
        "update": ["cursor-agent", "update"],
        "note": None,
    },
}

_INSTALL_STALE = "invalid choice: 'install'"


def _install_cmd(agent, os_name, has_brew=True):
    """(label, argv) for installing `agent` on this OS: the vendor one-liner run through
    `sh -c`, with the label being the one-liner itself so the review shows exactly
    what runs. macOS without brew falls to the script variant where one exists."""
    table = _INSTALL_AGENTS[agent]["install"]
    key = "darwin" if os_name == "darwin" else "linux"
    if key == "darwin" and not has_brew and "darwin-nobrew" in table:
        key = "darwin-nobrew"
    line = table.get(key) or table["linux"]
    return line, ["sh", "-c", line]


def _install_login_cmd(agent, headless):
    return _INSTALL_AGENTS[agent]["login_headless" if headless else "login"]


def _install_headless(env, flag=False):
    """Over ssh the browser is not where you are — use each agent's device-code
    login. --headless forces it (a tmux pane whose ssh env was scrubbed)."""
    return bool(flag or env.get("SSH_CONNECTION") or env.get("SSH_TTY"))


def _install_version(out):
    """The version token in a `<bin> --version` line ('2.1.267 (Claude Code)',
    'codex-cli 0.153.4', '2026.02.13-41ac335') — the first digit-led token."""
    if not out or not out.strip():
        return None
    m = re.search(r"\d[\w.\-]*", out.strip().splitlines()[0])
    return m.group(0) if m else out.strip().splitlines()[0]


def _install_status_ok(agent, rc, out):
    """Is the agent logged in, from its status command? claude answers JSON
    ({"loggedIn": true}); codex prints 'Logged in using ChatGPT'; cursor-agent prints
    an animated 'Logged in (…)' — so it is a text match with the negatives excluded,
    and anything unparseable reads as NOT logged in (the safe direction: an extra
    login offer costs a keypress, a missed one costs a failed session)."""
    text = _ANSI_RE.sub("", out or "")
    if agent == "claude":
        try:
            data = json.loads(text)
            return bool(isinstance(data, dict) and data.get("loggedIn"))
        except ValueError:
            return rc == 0 and bool(re.search(r'"loggedIn"\s*:\s*true', text))
    if rc != 0:
        return False
    if re.search(r"not (logged in|authenticated|signed in)", text, re.I):
        return False
    return bool(re.search(r"logged in|login successful|signed in", text, re.I))


def _install_probe(agents=INSTALL_AGENTS):
    """{agent: {bin, version, logged_in}} for this machine: `--version` and the status
    command per agent, ~0.3s in all. A binary only on the interactive PATH
    (~/.local/bin) is found by its known home when `which` misses it."""
    out = {}
    for a in agents:
        spec = _INSTALL_AGENTS[a]
        exe = shutil.which(spec["bin"]) or os.path.join(HOME, ".local", "bin", spec["bin"])
        if not os.path.exists(exe):
            out[a] = {"bin": None, "version": None, "logged_in": None}
            continue
        r = _run([exe, "--version"], timeout=20)
        ver = _install_version(r.stdout) if r.returncode == 0 else None
        s = _run([exe] + spec["status"][1:], timeout=30)
        out[a] = {"bin": exe, "version": ver or "?",
                  "logged_in": _install_status_ok(a, s.returncode, s.stdout + s.stderr)}
    return out


def _install_items(probed, want, hosts, update=False, no_login=False):
    """The checklist item model `t install` renders — pure and testable, the
    _setup_items shape (header / spacer / locked / toggle rows in one list).
    probed: _install_probe output; want: agents named on the command line (None =
    pre-mark every missing / logged-out one); hosts: [(alias, target)]. An installed
    agent is a locked ✓ row with its version, a logged-in one a locked ✓ under LOGIN,
    so "why isn't X offered?" answers itself. Login rows for a not-yet-installed
    agent follow its install mark (login needs the binary first)."""
    def wanted(a):
        return (a in want) if want is not None else True

    items = [{"t": "header", "sec": "agents", "label": "AGENTS · install"}]
    installed = []
    for a in INSTALL_AGENTS:
        p = probed.get(a) or {}
        if p.get("version"):
            installed.append(a)
            items.append({"t": "locked", "sec": "agents", "alias": a,
                          "value": f"{p['version']} · installed"})
        else:
            items.append({"t": "toggle", "sec": "agents", "kind": "install", "alias": a,
                          "value": _INSTALL_AGENTS[a]["label"], "checked": wanted(a)})
    items += [{"t": "spacer", "sec": "login"},
              {"t": "header", "sec": "login", "label": "LOGIN"}]
    for a in INSTALL_AGENTS:
        p = probed.get(a) or {}
        if p.get("logged_in"):
            items.append({"t": "locked", "sec": "login", "alias": a, "value": "logged in"})
        else:
            items.append({"t": "toggle", "sec": "login", "kind": "login", "alias": a,
                          "value": " ".join(_INSTALL_AGENTS[a]["login"]),
                          "checked": wanted(a) and not no_login})
    if installed:
        items += [{"t": "spacer", "sec": "options"},
                  {"t": "header", "sec": "options", "label": "OPTIONS"},
                  {"t": "toggle", "sec": "options", "kind": "update",
                   "alias": "update installed agents", "value": ", ".join(installed),
                   "checked": bool(update)}]
    if hosts:
        items += [{"t": "spacer", "sec": "hosts"},
                  {"t": "header", "sec": "hosts", "label": "HOSTS · then run t install there"}]
        for alias, target in hosts:
            items.append({"t": "toggle", "sec": "hosts", "kind": "host", "alias": alias,
                          "value": target, "checked": True})
    return items


def _install_result(items):
    """{install: [agents], login: [agents], update: bool, hosts: [aliases]} from the
    checked toggles, agents in INSTALL_AGENTS order."""
    sel = {"install": [], "login": [], "update": False, "hosts": []}
    for it in items:
        if it["t"] != "toggle" or not it["checked"]:
            continue
        if it["kind"] in ("install", "login"):
            sel[it["kind"]].append(it["alias"])
        elif it["kind"] == "update":
            sel["update"] = True
        elif it["kind"] == "host":
            sel["hosts"].append(it["alias"])
    return sel


def _install_ssh_argv(target, agents, no_login=False, update=False):
    """`ssh -t <target> "zsh -lic 't install <agents> -y --no-hosts …'"` — the two
    quoting layers of _new_ssh_argv, but -t and NO BatchMode-style silencing of the
    far side: the remote login step prompts (a device code) through this TTY."""
    words = ["t", "install"] + list(agents) + ["-y", "--no-hosts"]
    if no_login:
        words.append("--no-login")
    if update:
        words.append("--update")
    inner = " ".join(shlex.quote(w) for w in words)
    return ["ssh", "-t", "-o", "ConnectTimeout=5", target, f"zsh -lic {shlex.quote(inner)}"]


def _install_host_outcome(rc):
    """Classify a host run by rc alone — its stdio was the TTY (login prompts), so
    there is no stderr to read: 255/124 unreachable, 2 = argparse rejected the verb
    (stale dotfiles there), 127 = no `t`, 0 ok, else failed."""
    if rc in (255, 124):
        return "unreachable"
    if rc == 2:
        return "stale"
    if rc == 127:
        return "missing"
    return "ok" if rc == 0 else "failed"


def _install_host_line(host, status):
    return {
        "ok": f"✓ {host}: done",
        "unreachable": f"⚠ {host}: unreachable — re-run `t install --hosts {host}` later",
        "stale": f"⚠ {host}: stale dotfiles (no `t install` there) — run `dots` on it, then re-run",
        "missing": f"⚠ {host}: no `t` there — run install.sh on it, then re-run",
    }.get(status, f"⚠ {host}: failed — see its output above")


def _install_plan(sel, probed, os_name, has_brew, headless, hosts):
    """sel (_install_result) + probed state → ordered check-then-do step records, the
    `t new` record shape ({step, do: run|skip|error, label, cmd, warn, interactive}).
    Per agent: install (skip when present), update (when asked and present), login
    (skip when logged in; error when the binary is neither present nor selected —
    login needs it first). Then one `host:<alias>` step per picked host. Because
    every step re-checks the probed state, a re-run after a failed login renders the
    done steps as `=` and offers only what is left."""
    steps = []

    def rec(step, do, label, cmd=None, **kw):
        steps.append({"step": step, "do": do, "label": label, "cmd": cmd,
                      "warn": None, "interactive": False, **kw})

    for a in INSTALL_AGENTS:
        p = probed.get(a) or {}
        present = bool(p.get("version"))
        if a in sel["install"]:
            if present:
                rec(f"install:{a}", "skip", f"{a} {p['version']} already installed")
            else:
                label, cmd = _install_cmd(a, os_name, has_brew)
                rec(f"install:{a}", "run", label, cmd, warn=_INSTALL_AGENTS[a]["note"])
        elif present and sel["update"]:
            rec(f"update:{a}", "run", " ".join(_INSTALL_AGENTS[a]["update"]),
                list(_INSTALL_AGENTS[a]["update"]))
        if a in sel["login"]:
            if p.get("logged_in"):
                rec(f"login:{a}", "skip", f"{a} already logged in")
            elif present or a in sel["install"]:
                cmd = _install_login_cmd(a, headless)
                rec(f"login:{a}", "run", " ".join(cmd), list(cmd), interactive=True)
            else:
                rec(f"login:{a}", "error",
                    f"{a} login: not installed and not selected for install")
    agents = [a for a in INSTALL_AGENTS if a in sel["install"] or a in sel["login"]]
    for alias, target in hosts:
        if alias not in sel["hosts"]:
            continue
        argv = _install_ssh_argv(target, agents or list(INSTALL_AGENTS),
                                 no_login=not sel["login"], update=sel["update"])
        rec(f"host:{alias}", "run", f"{alias}: t install {' '.join(agents) or 'everything'}",
            argv, host=alias, interactive=True)
    return steps


def _install_render(steps, st):
    """Review / dry-run lines: + run, = skip, ✗ error, ⚠ warn, → the hosts."""
    lines, hosts = [], []
    for s in steps:
        if s["step"].startswith("host:"):
            hosts.append(s["host"])
            continue
        if s["do"] == "run":
            lines.append(f"{st.g}+{st.r} {s['label']}")
        elif s["do"] == "skip":
            lines.append(f"{st.y}= {s['label']}{st.r}")
        else:
            lines.append(f"{st.b}✗ {s['label']}{st.r}")
        if s.get("warn"):
            lines.append(f"{st.y}  ⚠ {s['warn']}{st.r}")
    if hosts:
        run = next((s for s in steps if s["step"].startswith("host:")), None)
        what = run["label"].split(": ", 1)[1] if run else "t install"
        lines.append(f"{st.c}→{st.r} then on {', '.join(hosts)}: {what} -y --no-hosts")
    return lines


def _install_relink():
    """Re-run the live install.sh in links-only mode so a seed that keys on a binary
    just installed (install_codex_hooks) lands now, not on the next dots. Same
    capability guard as _dots_relink in .zshrc."""
    live = os.path.dirname(os.path.realpath(os.path.join(HOME, ".zshrc")))
    inst = os.path.join(live, "install.sh")
    try:
        with open(inst, encoding="utf-8", errors="ignore") as fh:
            if "DOTFILES_LINKS_ONLY" not in fh.read():
                return
    except OSError:
        return
    r = subprocess.run([inst], env={**os.environ, "DOTFILES_LINKS_ONLY": "1"},
                       stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, text=True)
    if r.stdout.strip():
        print(r.stdout.rstrip())


def _install_walk(steps, close=False):
    """Run the plan: `=` for a skip, ✓ per step. Interactive steps (logins, hosts)
    inherit the TTY; an install that fails skips that agent's login (it would only
    fail again). A codex install re-seeds the hooks file at once. Host outcomes never
    change the rc; a failed local step does."""
    st = Style()
    failed, skipped_login, codex_landed = 0, set(), False
    for s in steps:
        if s["step"].startswith("host:"):
            continue
        kind, _, agent = s["step"].partition(":")
        if s["do"] == "skip":
            print(f"{st.y}= {s['label']}{st.r}")
            continue
        if s["do"] == "error" or (kind == "login" and agent in skipped_login):
            print(f"{st.b}✗ {s['label']}{st.r}")
            failed += s["do"] == "error"
            continue
        if s["interactive"]:
            rc = subprocess.call(s["cmd"])
        else:
            r = _run(s["cmd"], timeout=900)
            rc = r.returncode
            if rc != 0:
                tail = [ln.strip() for ln in (r.stderr or r.stdout or "").splitlines()
                        if ln.strip()][-3:]
                print(f"{st.b}✗ {s['label']}{st.r} — {' / '.join(tail) or f'rc {rc}'}")
        if rc != 0:
            failed += 1
            if kind == "install":
                skipped_login.add(agent)
            if s["interactive"]:
                print(f"{st.b}✗ {s['label']}{st.r} (rc {rc})")
            continue
        print(f"✓ {s['label']}")
        if s.get("warn"):
            print(f"{st.y}  ⚠ {s['warn']}{st.r}")
        if kind == "install" and agent == "codex":
            codex_landed = True
    if codex_landed:
        _install_relink()
    for s in steps:
        if s["step"].startswith("host:"):
            print(f"{st.c}→{st.r} {s['label']}")
            rc = subprocess.call(s["cmd"])
            print(_install_host_line(s["host"], _install_host_outcome(rc)))
    if close:
        print(f"{st.y}└{st.r}  " + (f"{st.g}✓{st.r} done" if not failed
                                    else f"{st.y}· {failed} step(s) failed — re-run to resume{st.r}"))
    return 1 if failed else 0


def _install_wizard(items, plan):
    """The `t setup` TUI over the install items: ONE list (agents, login, options,
    hosts) under a single cursor, present entries locked under a dim ✓; enter → the
    diff-style review (y apply · n back · q quit), re-planned from the live marks
    through `plan()`. Returns True on apply (items mutated in place), False on abort;
    raises off a tty → _install_prompt_flow."""
    ui = _RailUI()
    st, out, rail, width = ui.st, ui.out, ui.rail, ui.width
    HINTS = "space select · enter review · q quit"

    def row_text(it, aw, cur):
        val = _truncate(str(it["value"]), max(8, width - aw - 12))
        if it["t"] == "locked":
            return f"{rail}   {st.g}✓{st.r} {st.y}{it['alias']:<{aw}}  {val}{st.r}"
        mark = f"{st.c}◼{st.r}" if it["checked"] else "◻"
        pre = f"{st.c}▸{st.r}" if cur else " "
        alias = f"{st.b}{it['alias']:<{aw}}{st.r}" if cur else f"{it['alias']:<{aw}}"
        return f"{rail}  {pre}{mark} {alias}  {st.y}{val}{st.r}"

    def select_screen(msg=""):
        pos = 0
        while True:
            sel = _selectable(items)
            pos = max(0, min(pos, len(sel) - 1))
            cur = sel[pos] if sel else -1
            aw = max([len(x["alias"]) for x in items if x["t"] in ("toggle", "locked")] + [1])
            head = ui.head("pick what to install", msg or HINTS)
            nh = len(head)
            disp = [(h, None) for h in head]
            for idx, it in enumerate(items):
                if it["t"] == "spacer":
                    disp.append((rail, None))
                elif it["t"] == "header":
                    disp.append((f"{rail}  {st.b}{it['label']}{st.r}", None))
                else:
                    disp.append((row_text(it, aw, idx == cur), idx))
            body = max(6, ui.lines() - 2 - nh)
            if len(disp) > body:
                cur_line = next((n for n, d in enumerate(disp) if d[1] == cur), nh)
                lo = max(nh, min(cur_line - body // 2, len(disp) - (body - nh)))
                lines = [d[0] for d in disp[:nh]] + [d[0] for d in disp[lo:lo + body - nh]]
                if lo > nh:
                    lines[nh] = f"{rail}  {st.y}… {lo - nh} more above{st.r}"
                if lo + body - nh < len(disp):
                    lines[-1] = f"{rail}  {st.y}… {len(disp) - (lo + body - nh)} more below{st.r}"
            else:
                lines = [d[0] for d in disp]
            ui.repaint(lines)
            msg = ""
            k = ui.read_key()
            it = items[cur] if sel else None
            if k in ("q", "esc", "abort"):
                return False
            if k == "enter":
                return True
            if it and k in ("up", "k"):
                pos -= 1
            elif it and k in ("down", "j"):
                pos += 1
            elif it and k == "space":
                it["checked"] = not it["checked"]
                pos += 1
            else:
                msg = f"⚠ no binding for that key — {HINTS}"

    def review_screen(lines):
        if not lines:
            return "empty"
        body = [f"{rail}  {ln}" for ln in lines]
        k = ui.page("review — what will run", body,
                    accept=("y", "n", "esc", "q", "abort"), keys="y apply · n back · q quit")
        if k == "y":
            ui.commit([f"{st.g}◇{st.r}  {st.b}running{st.r}"] + body)
            return True
        return False if k in ("n", "esc") else None

    out.write(f"{st.y}┌{st.r}  {st.b}t install{st.r} {st.y}· agent CLIs — nothing runs until "
              f"you confirm{st.r}\n{rail}\n")
    ui.raw()
    ok, msg = False, ""
    try:
        while True:
            if not select_screen(msg):
                break
            r = review_screen(_install_render(plan(), st))
            if r == "empty":
                msg = "nothing selected — space marks ◼ what gets installed"
                continue
            if r:
                ok = True
                break
            if r is None:
                break
            msg = ""
    except KeyboardInterrupt:
        ok = False
    finally:
        ui.restore()
    if not ok:
        out.write(f"{st.y}└{st.r} {st.y}· aborted — nothing run{st.r}\n")
    return ok


def _install_prompt_flow(items, plan):
    """Plain-prompt fallback (TERM=dumb, no raw mode): one y/N per toggle over the
    same item model, then the same review gate."""
    st = Style()
    for it in items:
        if it["t"] == "header":
            print(f"\n{st.b}{it['label']}{st.r}")
        elif it["t"] == "locked":
            print(f"  {st.y}✓ {it['alias']} — {it['value']}{st.r}")
        elif it["t"] == "toggle":
            it["checked"] = _confirm(f"  {it['alias']} ({it['value']})?")
    lines = _install_render(plan(), st)
    if not lines:
        return False
    print(f"\n{st.b}review{st.r} — what will run:\n")
    for ln in lines:
        print(f"  {ln}")
    return _confirm("proceed?")


def cmd_install(cfg, args):
    """See the section comment above. Positional agents pre-mark rows; -y skips the
    TUI and takes the marks as they stand; --status prints the probe + parity matrix
    and stops; --dry-run (and no tty) prints the plan and stops."""
    st = Style()
    unknown = [a for a in args.agents if a not in INSTALL_AGENTS]
    if unknown:
        print(f"t install: unknown agent(s): {', '.join(unknown)} — one of "
              f"{', '.join(INSTALL_AGENTS)}", file=sys.stderr)
        return 2
    probed = _install_probe()
    if args.status:
        for a in INSTALL_AGENTS:
            p = probed[a]
            state = ("missing" if not p["version"] else
                     f"{p['version']} · {'logged in' if p['logged_in'] else 'NOT logged in'}")
            print(f"  {a:<8} {state}")
        print()
        for ln in _agent_parity_render():
            print(ln)
        return 0
    hosts, err = _new_pick_hosts(cfg.hosts, args.hosts, args.no_hosts)
    if err:
        print(f"t install: {err}", file=sys.stderr)
        return 1
    want = args.agents or None
    items = _install_items(probed, want, hosts, update=args.update, no_login=args.no_login)
    os_name = "darwin" if sys.platform == "darwin" else "linux"
    has_brew, headless = bool(shutil.which("brew")), _install_headless(os.environ, args.headless)

    def plan():   # the review re-plans from the live marks
        return _install_plan(_install_result(items), probed, os_name, has_brew, headless, hosts)

    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if args.dry_run or args.yes or not interactive:
        steps = plan()
        lines = _install_render(steps, st)
        if not lines:
            print("nothing to do — every agent is installed and logged in")
            return 0
        if args.dry_run or not args.yes:
            print("would run:" if args.dry_run else "t install would run:")
            for ln in lines:
                print(f"  {ln}")
            if args.dry_run:
                return 0
            print("\nt install is interactive — run it from a terminal, or pass -y "
                  "(or --dry-run)", file=sys.stderr)
            return 1
        return _install_walk(steps)
    if not _selectable(items):
        print("nothing to do — every agent is installed and logged in")
        return 0
    wizard_ran = True
    try:
        confirmed = _install_wizard(items, plan)
    except Exception as e:
        wizard_ran = False
        print(f"(inline UI unavailable: {e} — falling back to prompts)", file=sys.stderr)
        confirmed = _install_prompt_flow(items, plan)
    if not confirmed:
        if not wizard_ran:
            print("t install: aborted — nothing run")
        return 1
    return _install_walk(plan(), close=wizard_ran)


# ─── agent parity — one table, rendered everywhere it is documented ────────────
#
# Every `t` surface either supports all three agents or says which it does not, and
# the saying is generated: this table renders into `t -h`, `t install --status`,
# README's "Agents" section (pinned by test_readme_parity_matrix_matches_bin_t) and
# `help`. Add a surface → add a row, or the README test fails. Cells: ✓ supported,
# ✗ not (with why), → the verb that does it instead.

_AGENT_PARITY = [
    ("surface", "claude", "codex", "cursor"),
    ("t install (install · login · update)", "✓", "✓", "✓"),
    ("dev slots: t open / ls / kill / read / paste", "✓", "planned", "✗ no slot — t cursor ls"),
    ("t push / t pop", "✓", "planned", "✗ no slot"),
    ("t resume (dead slots)", "✓", "planned", "→ t cursor resume"),
    ("t beam / --from (move a session)", "✓", "planned", "→ t cursor [id] --host / --from"),
    ("csync (iCloud union of transcripts)", "✓ projects + plans", "planned", "✓ cursor-chats"),
    ("SessionStart stamps (registry · opened · origin)", "✓ settings.json hook",
     "✓ hooks.json + /hooks trust", "✗ no hook wired"),
    ("t plan", "✓", "✗ codex keeps no plan files", "✗"),
    ("t find / t mcp (transcript search)", "✓", "planned", "✗"),
    ("t doctor agent row (version · login · hook)", "✓", "✓", "✓ version · login"),
]


def _agent_parity_render():
    """The matrix as aligned plain-text lines (no ANSI: it is embedded in README and
    argparse's epilog verbatim)."""
    widths = [max(len(r[i]) for r in _AGENT_PARITY) for i in range(4)]
    lines = []
    for n, row in enumerate(_AGENT_PARITY):
        cells = [f"{c:<{widths[i]}}" for i, c in enumerate(row)]
        lines.append("  " + "  ".join(cells).rstrip())
        if n == 0:
            lines.append("  " + "  ".join("-" * w for w in widths))
    return lines


def _codex_hook_state(path):
    """~/.codex/hooks.json: "registered" when a SessionStart command runs
    claude-stamp-tmux, "none" when the file is absent or has no such entry, None when
    it is unreadable or foreign-shaped (not ours to judge — the twin of
    _mcp_allow_state)."""
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except OSError:
        return "none"
    except ValueError:
        return None
    hooks = data.get("hooks") if isinstance(data, dict) else None
    groups = hooks.get("SessionStart") if isinstance(hooks, dict) else None
    if groups is None:
        return "none" if isinstance(hooks, (dict, type(None))) else None
    if not isinstance(groups, list):
        return None
    for g in groups:
        for h in (g.get("hooks") or []) if isinstance(g, dict) else []:
            if isinstance(h, dict) and "claude-stamp-tmux" in str(h.get("command", "")):
                return "registered"
    return "none"


# ─── doctor — read-only setup diagnostics ─────────────────────────────────────
# Born from a real debugging session: "scroll wheel doesn't work" turned out to be
# four stacked facts (stale live checkout, missing ~/.tmux.conf link, tmux server
# options predating the config, and Claude's fullscreen TUI capturing the wheel).
# doctor gathers exactly that state in one shot. The gathering is subprocess glue
# (cmd_doctor, coverage-excluded); the diagnosis rules are pure + pytest-covered.

# install.sh's own `link "$LINK_SRC/<src>" "<dst>"` calls, parsed rather than
# hardcoded so doctor can never drift from what install.sh actually manages. Leading
# whitespace is allowed because the calls live inside install.sh's link_all(); a
# comment or a mention (`# link …`, `echo link …`) still has to not match, which is
# why this anchors on indentation-then-`link` rather than searching anywhere.
_INSTALL_LINK_RE = re.compile(r'^[ \t]*link\s+"\$LINK_SRC/([^"]+)"\s+"([^"]+)"', re.M)

# Terminals that translate the scroll wheel into arrow keys while an app sits on
# the alternate screen. Claude's fullscreen renderer keeps its own virtualized
# scrollback and expects real wheel events, so there the wheel moves nothing and
# Claude posts "Scroll wheel is sending arrow keys" (its detector trips on 8 bare
# arrows inside a 100ms window). Verified for Apple_Terminal — only add a
# terminal here once its wheel has actually been observed arriving as arrows.
_WHEEL_ARROW_TERMS = ("Apple_Terminal",)


def _env_on(env, name):
    """A CLAUDE_CODE_* toggle counts as on unless unset/empty/0/false."""
    return env.get(name, "").strip().lower() not in ("", "0", "false")


def _effective_tui(settings_tui, env):
    """Which renderer Claude will actually use: "fullscreen", "default" or None.

    `tui` is optional in Claude's settings schema with NO default, and the
    fullscreen upsell only fires while it is undefined — so unset means the
    CLASSIC main-screen renderer and must never be read as fullscreen (that
    would fire the wheel warning at everyone who never opted in). The env knobs
    override the file; DISABLE_ALTERNATE_SCREEN wins outright because it forces
    the main screen regardless of the renderer setting.
    """
    if _env_on(env, "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN"):
        return "default"
    if _env_on(env, "CLAUDE_CODE_NO_FLICKER"):   # documented as == fullscreen
        return "fullscreen"
    return settings_tui

# Terminals that translate the scroll wheel into arrow keys while an app sits on
# the alternate screen. Claude's fullscreen renderer keeps its own virtualized
# scrollback and expects real wheel events, so there the wheel moves nothing and
# Claude posts "Scroll wheel is sending arrow keys" (its detector trips on 8 bare
# arrows inside a 100ms window). Verified for Apple_Terminal — only add a
# terminal here once its wheel has actually been observed arriving as arrows.
_WHEEL_ARROW_TERMS = ("Apple_Terminal",)


def _env_on(env, name):
    """A CLAUDE_CODE_* toggle counts as on unless unset/empty/0/false."""
    return env.get(name, "").strip().lower() not in ("", "0", "false")


def _effective_tui(settings_tui, env):
    """Which renderer Claude will actually use: "fullscreen", "default" or None.

    `tui` is optional in Claude's settings schema with NO default, and the
    fullscreen upsell only fires while it is undefined — so unset means the
    CLASSIC main-screen renderer and must never be read as fullscreen (that
    would fire the wheel warning at everyone who never opted in). The env knobs
    override the file; DISABLE_ALTERNATE_SCREEN wins outright because it forces
    the main screen regardless of the renderer setting.
    """
    if _env_on(env, "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN"):
        return "default"
    if _env_on(env, "CLAUDE_CODE_NO_FLICKER"):   # documented as == fullscreen
        return "fullscreen"
    return settings_tui


def _parse_install_links(text):
    return [(m.group(1), m.group(2)) for m in _INSTALL_LINK_RE.finditer(text)]


def _doctor_findings(facts):
    """Pure diagnosis over the gathered facts → list of finding lines.

    facts keys (all optional): links [(dst, status)] where status != "ok" is a
    problem; behind (int, live surface commits behind origin/main); conf_exists /
    conf_is_link (~/.tmux.conf); tmux_running; mouse ("on"/"off"); conf_mouse_on
    (the FILE says mouse on); history_limit (global); panes [{session, cmd,
    mouse, alt, hist}]; in_tmux; term_program ($TERM_PROGRAM); tui (the
    effective renderer per _effective_tui).
    """
    out = []
    bad = [(d, s) for d, s in facts.get("links", []) if s != "ok"]
    if bad:
        out.append("⚠ %d managed link(s) not in place: %s — run dots (it relinks every "
                   "run; dots --relink to do it without fetching)"
                   % (len(bad), ", ".join("%s (%s)" % (os.path.basename(d), s) for d, s in bad)))
    if facts.get("behind"):
        out.append("⚠ live surface is %d commit(s) behind origin/main — run dots"
                   % facts["behind"])
    if facts.get("conf_exists") and not facts.get("conf_is_link"):
        out.append("⚠ ~/.tmux.conf is a real file, not the repo-managed symlink — "
                   "re-run install.sh to adopt it (the old file is backed up to .bak)")
    if facts.get("tmux_running"):
        if facts.get("mouse") != "on":
            if facts.get("conf_mouse_on"):
                out.append("⚠ tmux mouse is OFF but ~/.tmux.conf says on — the server "
                           "predates the config; run dots (it re-sources it), or: "
                           "tmux source-file ~/.tmux.conf")
            else:
                out.append("⚠ tmux mouse is OFF — the wheel scrolls the terminal's stale "
                           "scrollback, not the pane; get the repo ~/.tmux.conf linked "
                           "(install.sh), then tmux source-file ~/.tmux.conf")
        caps = [p for p in facts.get("panes", []) if p.get("mouse")]
        if caps and facts.get("mouse") == "on":
            out.append("· %d pane(s) capture the wheel themselves (Claude's fullscreen "
                       "TUI): scrolling there moves Claude's view, not tmux history. "
                       "Full output: ctrl+o transcript ('[' dumps it to native "
                       "scrollback); classic renderer: /tui default or "
                       "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1" % len(caps))
        gl = facts.get("history_limit")
        stale = [p for p in facts.get("panes", []) if gl and p.get("hist") and p["hist"] < gl]
        if stale:
            out.append("· %d existing pane(s) still have the old history-limit (%d); the "
                       "global %d applies only to panes created after the change"
                       % (len(stale), stale[0]["hist"], gl))
    if (not facts.get("in_tmux") and facts.get("tui") == "fullscreen"
            and facts.get("term_program") in _WHEEL_ARROW_TERMS):
        out.append("⚠ %s turns the wheel into arrow keys on the alternate screen, so "
                   "the fullscreen renderer never sees it scroll (\"Scroll wheel is "
                   "sending arrow keys\"). Fix: /tui default — the classic renderer "
                   "draws on the main screen, so the wheel scrolls the terminal\'s own "
                   "scrollback. To keep fullscreen, read back with the ctrl+o transcript "
                   "(\'[\' dumps it to native scrollback)" % facts["term_program"])
    if facts.get("mcp_sessions") is False:
        out.append("⚠ MCP server 'sessions' is not registered in ~/.claude.json — run "
                   "t mcp --install (dots does it when claude is on PATH)")
    if facts.get("mcp_allow") == "none":
        out.append("⚠ no %s allow rule in ~/.claude/settings.json, so every sessions "
                   "lookup prompts — run t mcp --install (dots seeds it too)"
                   % _MCP_ALLOW_RULE)
    for a, p in sorted((facts.get("agents") or {}).items()):
        if p.get("version") and p.get("logged_in") is False:
            out.append("⚠ %s is installed but not logged in — run t install %s" % (a, a))
    if facts.get("codex_hook") == "none":
        out.append("⚠ codex has no dotfiles SessionStart hook in ~/.codex/hooks.json — run "
                   "dots (install.sh seeds it), then accept it under /hooks in codex")
    elif (facts.get("codex_hook") == "registered" and facts.get("codex_used")
          and not facts.get("codex_hook_fired")):
        out.append("· the codex hook is registered but has never fired here — open codex, "
                   "run /hooks and trust it (until then t ls cannot title a codex slot)")
    if not out:
        out.append("✓ nothing suspicious found")
    return out


def cmd_doctor(cfg, args):
    import json
    import platform

    st = Style()

    def run(cmd, timeout=8):
        """stdout on success (stripped, possibly empty), None on any failure."""
        try:
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               text=True, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return r.stdout.strip() if r.returncode == 0 else None

    def ver(out):
        if out is None or not out.strip():
            return "missing"
        m = re.search(r"\d[\w.\-]*", out.splitlines()[0])
        return m.group(0) if m else out.splitlines()[0]

    def section(title):
        print("\n%s%s%s" % (st.b, title, st.r))

    print("%st doctor%s — dotfiles / tmux / Claude session diagnostics" % (st.b, st.r))

    # host + terminal environment
    section("Host")
    un = platform.uname()
    os_line = "%s %s (%s)" % (un.system, un.release, un.machine)
    if un.system == "Darwin":
        v = run(["sw_vers", "-productVersion"])
        if v:
            os_line = "macOS %s (%s)" % (v, un.machine)
    print("  %s · %s" % (un.node, os_line))
    bits = ["TERM=%s" % os.environ.get("TERM", "?")]
    if os.environ.get("TERM_PROGRAM"):
        bits.append("TERM_PROGRAM=%s %s" % (os.environ["TERM_PROGRAM"],
                                            os.environ.get("TERM_PROGRAM_VERSION", "")))
    bits.append("inside tmux: %s" % ("yes" if os.environ.get("TMUX") else "no"))
    bits.append("ssh: %s" % ("yes" if os.environ.get("SSH_CONNECTION") else "no"))
    print("  " + " · ".join(bits))
    # which renderer Claude will use here — decides who owns the scroll wheel
    settings_tui = None
    try:
        with open(os.path.join(HOME, ".claude", "settings.json")) as f:
            settings_tui = json.load(f).get("tui")
    except (OSError, ValueError, AttributeError):
        settings_tui = None
    tui = _effective_tui(settings_tui, os.environ)
    print("  claude tui: %s" % (tui or "default (unset)"))

    # tool versions (claude lives on the interactive PATH / ~/.local/bin)
    section("Versions")
    vers = ["%s %s" % (n, ver(run(c))) for n, c in [
        ("zsh", ["zsh", "--version"]), ("tmux", ["tmux", "-V"]),
        ("git", ["git", "--version"]), ("gh", ["gh", "--version"]),
        ("fzf", ["fzf", "--version"])]]
    print("  " + " · ".join(vers))

    # the agent CLIs: installed? logged in? (codex: is its hook wired?) — t install fixes
    section("Agents")
    facts_agents = _install_probe()
    for a in INSTALL_AGENTS:
        p = facts_agents[a]
        if not p["version"]:
            print("  %-8s missing — t install %s" % (a, a))
        else:
            print("  %-8s %s · %s" % (a, p["version"], "logged in" if p["logged_in"]
                                        else "NOT logged in — t install %s" % a))
    codex_hook = codex_used = None
    if facts_agents["codex"]["version"] or os.path.isdir(os.path.join(HOME, ".codex")):
        codex_hook = _codex_hook_state(os.path.join(HOME, ".codex", "hooks.json"))
        codex_used = os.path.isdir(os.path.join(HOME, ".codex", "sessions"))
        fired = bool(glob.glob(os.path.join(_cache_root(), "rollouts", "*")))
        print("  codex hook %s" % {"registered": "registered in ~/.codex/hooks.json%s"
                                   % ("" if fired else " (never fired here — trust it under /hooks)"),
                                   "none": "NOT registered — run dots (install.sh seeds it)",
                                   None: "~/.codex/hooks.json unreadable"}[codex_hook])

    # dotfiles: which checkout is live, is it current, are the links in place
    section("Dotfiles")
    facts = {"in_tmux": bool(os.environ.get("TMUX")),
             "term_program": os.environ.get("TERM_PROGRAM"), "tui": tui,
             "agents": facts_agents, "codex_hook": codex_hook, "codex_used": codex_used,
             "codex_hook_fired": bool(glob.glob(os.path.join(_cache_root(), "rollouts", "*")))}
    zrc = os.path.join(HOME, ".zshrc")
    live_src = None
    if os.path.islink(zrc):
        live_src = os.path.dirname(os.path.realpath(zrc))
        br = run(["git", "-C", live_src, "rev-parse", "--abbrev-ref", "HEAD"]) or "?"
        head = run(["git", "-C", live_src, "log", "-1", "--format=%h %s"]) or "?"
        print("  live surface   ~/.zshrc → %s" % live_src)
        print("                 %s @ %s" % (br, head))
        fetched = run(["git", "-C", live_src, "fetch", "-q", "origin", "main"]) is not None
        behind = run(["git", "-C", live_src, "rev-list", "--count", "HEAD..origin/main"])
        if behind is not None and behind.isdigit():
            facts["behind"] = int(behind)
            note = "" if fetched else " (as of last fetch — origin unreachable)"
            print("                 vs origin/main: %s%s"
                  % ("up to date" if not facts["behind"] else "behind %d" % facts["behind"], note))
    else:
        print("  live surface   ~/.zshrc is not a symlink — install.sh has not run here")
    links = []
    if live_src:
        try:
            with open(os.path.join(live_src, "install.sh")) as f:
                pairs = _parse_install_links(f.read())
        except OSError:
            pairs = []
        for rel, dst_raw in pairs:
            dst = dst_raw.replace("$HOME", HOME)
            want = os.path.realpath(os.path.join(live_src, rel))
            if not os.path.lexists(dst):
                links.append((dst, "missing"))
            elif not os.path.islink(dst):
                links.append((dst, "not a symlink"))
            elif os.path.realpath(dst) != want:
                links.append((dst, "→ %s" % os.path.realpath(dst)))
            else:
                links.append((dst, "ok"))
        n_ok = sum(1 for _, s in links if s == "ok")
        print("  managed links  %d/%d in place" % (n_ok, len(links)))
        for d, s in links:
            if s != "ok":
                print("                 %s~/%s: %s%s"
                      % (st.y, os.path.relpath(d, HOME), s, st.r))
    facts["links"] = links
    if os.path.exists(CONFIG):
        age = int(time.time() - os.path.getmtime(CONFIG))
        print("  config bridge  %s (%dm old)" % (CONFIG.replace(HOME, "~"), age // 60))
    else:
        print("  config bridge  missing (%s) — open an interactive zsh once" % CONFIG.replace(HOME, "~"))

    # tmux: server options vs the config file, and who owns the mouse per pane
    if shutil.which("claude"):
        facts["mcp_sessions"] = _mcp_registered(os.path.join(HOME, ".claude.json"))
        print("  mcp sessions   %s" % {True: "registered (user scope) → t mcp",
                                      False: "NOT registered — t mcp --install",
                                      None: "~/.claude.json unreadable"}[facts["mcp_sessions"]])
        facts["mcp_allow"] = _mcp_allow_state(os.path.join(HOME, ".claude", "settings.json"))
        print("  mcp permission %s"
              % {"server": "allowed (%s) — its tools never prompt" % _MCP_ALLOW_RULE,
                 "tools": "allowed per tool (%s__*) — hand-narrowed, left alone" % _MCP_ALLOW_RULE,
                 "none": "no allow rule — every call prompts",
                 None: "~/.claude/settings.json missing or unreadable"}[facts["mcp_allow"]])

    section("Tmux")
    tmux_running = run(["tmux", "list-sessions", "-F", "#{session_name}"]) is not None
    facts["tmux_running"] = tmux_running
    conf = os.path.join(HOME, ".tmux.conf")
    facts["conf_exists"] = os.path.lexists(conf)
    facts["conf_is_link"] = os.path.islink(conf)
    try:
        with open(conf) as f:
            facts["conf_mouse_on"] = bool(re.search(r"^\s*set(?:-option)?\s+-g\s+mouse\s+on",
                                                    f.read(), re.M))
    except OSError:
        facts["conf_mouse_on"] = False
    print("  ~/.tmux.conf   %s" % ("→ %s" % os.path.realpath(conf) if facts["conf_is_link"]
                                   else "real file (not repo-managed)" if facts["conf_exists"]
                                   else "absent"))
    if not tmux_running:
        print("  server         not running")
    else:
        mouse = run(["tmux", "show", "-g", "-v", "mouse"])
        focus = run(["tmux", "show", "-g", "-v", "focus-events"])
        hist = run(["tmux", "show", "-g", "-v", "history-limit"])
        facts["mouse"] = mouse
        facts["history_limit"] = int(hist) if hist and hist.isdigit() else None
        print("  server         mouse %s · focus-events %s · history-limit %s"
              % (mouse, focus, hist))
        panes = []
        raw = run(["tmux", "list-panes", "-a", "-F",
                   "#{session_name}\t#{pane_current_command}\t#{mouse_any_flag}"
                   "\t#{alternate_on}\t#{history_limit}"]) or ""
        for ln in raw.splitlines():
            f = ln.split("\t")
            if len(f) == 5:
                panes.append({"session": f[0], "cmd": f[1], "mouse": f[2] == "1",
                              "alt": f[3] == "1", "hist": int(f[4]) if f[4].isdigit() else 0})
        facts["panes"] = panes
        if panes:
            w = max(len(p["session"]) for p in panes)
            for p in panes:
                flags = [x for x in (("mouse-capture" if p["mouse"] else None),
                                     ("alt-screen" if p["alt"] else None)) if x]
                print("    %-*s  %-12s %-25s hist %d"
                      % (w, p["session"], p["cmd"], " ".join(flags) or "-", p["hist"]))

    section("Findings")
    for line in _doctor_findings(facts):
        print("  " + line)
    return 0



# ─── todo — retired ─────────────────────────────────────────────────────────────
#
# `t todo` (a per-slot task list with a /todo command, a statusline bar, a
# list_todos MCP tool and a csync pair) was retired in September 2026. The verb
# is answered in main() (no subparser — `t -h` does not list it) so an old habit,
# alias, or a lagging statusline setting gets one quiet line instead of argparse's
# "invalid choice". The lists it kept
# under $XDG_STATE_HOME/t/todo/ are left on disk, untouched.

_TODO_RETIRED_MSG = "t todo is retired — it was removed in September 2026."


def cmd_todo(cfg, args):
    if "--statusline" in (args.rest or []):
        return 0          # a lagging ~/.claude/settings.json: render nothing, never an error
    print(_TODO_RETIRED_MSG, file=sys.stderr)
    return 1


# ─── the dev URL a slot is testable at (the `sessions` MCP rows carry it) ─────────
#
# The dev server a slot's work is testable at. Mirrors financial-forecast's
# scripts/dev-worktree.sh, which is the thing that actually binds the port:
# .worktrees/<repo>/<N> → 5200+N, primary checkout → Vite's canonical 5173.
# Re-derived here rather than shelled out to because the MCP rows render it often
# and that script costs a bash plus several lsof calls.
_DEV_PORT_BASE = 5200
_DEV_PORT_PRIMARY = 5173


def _port_is_live(port, host="localhost", timeout=0.05):
    """True when something is LISTENING on the port. A loopback connect settles in
    well under a millisecond either way — a closed port refuses immediately rather
    than waiting out the timeout — which is what makes this affordable per render.

    Probed by NAME, not 127.0.0.1: create_connection tries every address localhost
    resolves to, and Vite without --host binds ONLY [::1] on modern macOS/Node, so an
    IPv4-only probe reported a perfectly live slot port dead and the bar fell through
    to whoever held the shared :5173."""
    try:
        with socket.create_connection((host, port), timeout):
            return True
    except OSError:
        return False


def _has_dev_server(cwd):
    """Could this checkout be running a dev server at all? A package.json is the tell."""
    return bool(cwd) and os.path.exists(os.path.join(cwd, "package.json"))


def _dev_url(key, cwd):
    """The URL to test this slot's work at, or None if nothing is serving it.

    Candidates in order: the slot's own deterministic port, then the canonical dev
    port — the latter only for a checkout that could plausibly have a dev server
    (a package.json), so a repo without one never claims the shared :5173 out from
    under whoever is on it.

    Only a port with a LIVE listener is returned. A URL that refuses the connection
    is worse than no URL, and appearing exactly when the server comes up makes the
    bar double as the "it's ready" signal."""
    # Only a checkout that could run a dev server (a package.json) gets a URL at all.
    # Ports are 5200+N across EVERY repo, so dotfiles slot 3 would otherwise claim
    # ff slot 3's vite on :5203 — a CLI repo pointing at someone else's web app.
    if not _has_dev_server(cwd):
        return None
    _, dash, slot = key.rpartition("-")
    if dash and slot.isdigit():
        # A slot has exactly one port. It never falls back to :5173 — that is some
        # OTHER checkout's server, and a bar that names it while this slot's server
        # is down sends you to the wrong app with total confidence.
        port = _DEV_PORT_BASE + int(slot)
    else:
        port = _DEV_PORT_PRIMARY
    return "http://localhost:%d" % port if _port_is_live(port) else None



# ─── mcp — which session is working on what ───────────────────────────────────
#
# `t mcp` is a stdio MCP server Claude Code spawns (registered at user scope as
# `sessions`, so the tools surface as mcp__sessions__* in EVERY repo's sessions). It
# answers the question nothing else could: "which session is — or was — working on
# X?". `t ls` carries only a slot's FIRST prompt as its title, `t find` reranks the
# first six prompts and is a shell-bound fzf picker, and a thing said forty turns into
# a conversation was invisible to all of them.
#
# Three stores, no zsh on the hot path: (1) every saved transcript, through an
# incremental INDEX cache (~/.cache/claude-sessions/index/<key>: the same inode +
# byte-offset scheme as .zshrc's _transcript_meta_batch, so a dead transcript is never
# re-read and a live one re-reads only what was appended); (2) liveness from the pid
# registry (~/.cache/claude-sessions/<pid> = sid\tcwd, written by claude-stamp-tmux)
# plus ONE `tmux list-sessions` fork — the zsh _dev_session_rows scan costs 1-5 s and
# its only extra signal (idle vs active by capture-pane) is not decision-relevant
# here; only all_hosts=true pays for zsh_capture("_dev_rows_all"), because remote
# liveness has no other source.
#
# The CALLER judges. find_sessions returns keyword-scored candidates WITH the prompt
# excerpts that matched, and the instructions tell the model to read them — the caller
# is already an LLM, so a nested `claude -p` rerank (what `t find` does) would add
# 5-15 s and a claude-inside-an-MCP-inside-claude for no better answer.
#
# STDOUT IS THE WIRE. Nothing in the serve path may print; every child subprocess
# runs with stdin=DEVNULL (a spawned interactive zsh must never read the JSON-RPC
# stdin) and stderr=DEVNULL. Framing mirrors hive's mcp_servers/protocol.py — a
# hand-rolled newline-delimited JSON-RPC 2.0 loop, because the official `mcp` SDK
# drags in httpx/pydantic/anyio/starlette and this repo has no dependencies.
#
# One server process per Claude session, so several refresh the index concurrently:
# cache writes are <key>.<pid>.tmp + os.replace, never a shared tmp name.

_PR_RE = re.compile(r"github\.com/([\w.-]+)/([\w.-]+)/pull/(\d+)")
_INDEX_V = 1
_INDEX_HEAD, _INDEX_TAIL = 8, 72   # prompts kept per transcript: first 8 + last 72
_INDEX_TEXT = 400                  # chars kept per prompt
_INDEX_ASST = 300                  # chars kept of the last assistant message
_INDEX_REFRESH_S = 15              # per-process re-stat gate between tool calls


def _cache_root():
    """~/.cache/claude-sessions — the registry, opened/, pr/, meta/ and now index/.
    Read at call time so $XDG_CACHE_HOME (and tests) can redirect it."""
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
    return os.path.join(base, "claude-sessions")


def _index_dir():
    return os.path.join(_cache_root(), "index")


def _projects_dir():
    return os.path.join(HOME, ".claude", "projects")


def _plan_re():
    # $HOME-anchored like _t_plan's grep, so a plan path quoted in some other host's
    # transcript (synced in) does not masquerade as a local file.
    return re.compile(re.escape(HOME) + r"/\.claude/plans/[^\"\s]*\.md")


def _iso_epoch(s):
    """'2026-08-23T06:37:38.765Z' → epoch seconds, or None. Transcript timestamps are
    UTC; timegm, not mktime, or every date shifts by the host's UTC offset."""
    try:
        return calendar.timegm(time.strptime(str(s)[:19], "%Y-%m-%dT%H:%M:%S"))
    except (TypeError, ValueError):
        return None


def _tx_user_text(rec):
    """The text the user actually typed in a transcript record, else None.

    The same filter every .zshrc scanner applies — `type == "user"`, content either a
    string (a typed prompt) or a list of blocks whose `text` is joined (tool_result
    blocks have no `text`, so they vanish), and nothing starting with `<` (the
    injected <command-name>/<local-command-stdout>/<system-reminder> pseudo-prompts)
    — plus two flags those scanners never checked: isMeta (an injected placeholder)
    and isSidechain (a subagent turn)."""
    if rec.get("type") != "user" or rec.get("isMeta") or rec.get("isSidechain"):
        return None
    msg = rec.get("message")
    c = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(c, str):
        txt = c
    elif isinstance(c, list):
        txt = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
    else:
        return None
    txt = " ".join(txt.split())
    if not txt or txt.startswith("<"):
        return None
    return txt


def _index_trim(prompts, head=_INDEX_HEAD, tail=_INDEX_TAIL):
    """Keep the first `head` and last `tail` prompts, in place. The first prompts say
    what a session is ABOUT (the signal every existing scanner uses); the last say
    where it LEFT OFF and what is still open — the two things actually asked. The
    middle is the least useful, and the cap bounds the cache at ~20 MB worst case."""
    if len(prompts) > head + tail:
        prompts[:] = prompts[:head] + prompts[-tail:]
    return prompts


def _index_empty(ino):
    return {"v": _INDEX_V, "ino": ino, "off": 0, "sid": None, "cwd": None,
            "branch": None, "ct": None, "at": None, "pr": None, "plan": None,
            "first_ts": None, "last_ts": None, "n_prompts": 0, "prompts": [],
            "last_asst": None}


def _tx_scan_line(st, raw):
    """Fold one transcript line into the index record `st`. Substring-gated before
    json.loads so the cold scan of an 800 MB corpus runs at I/O speed: only user
    lines, assistant lines that carry a text block, title records, and (until the id
    is known) any line naming a sessionId get decoded. PR and plan mentions are regex
    hits on the raw line — a `pr-link` record matches the same URL pattern, so one
    rule covers both."""
    line = raw.decode("utf-8", "replace") if isinstance(raw, bytes) else raw
    line = line.rstrip("\r\n")
    if not line:
        return
    if "/pull/" in line:
        for m in _PR_RE.finditer(line):
            st["pr"] = m.group(0)
    if ".claude/plans/" in line:
        hits = _plan_re().findall(line)
        if hits:
            st["plan"] = hits[-1]
    is_user = '"type":"user"' in line
    is_asst = '"type":"assistant"' in line and '"type":"text"' in line
    if not (is_user or is_asst or '"ai-title"' in line or '"custom-title"' in line
            or (st["sid"] is None and '"sessionId"' in line)):
        return
    try:
        rec = json.loads(line)
    except ValueError:
        return
    if not isinstance(rec, dict):
        return
    if st["sid"] is None and rec.get("sessionId"):
        st["sid"] = rec["sessionId"]
    if st["cwd"] is None and rec.get("cwd"):
        st["cwd"] = rec["cwd"]
    if rec.get("gitBranch"):
        st["branch"] = rec["gitBranch"]
    ts = _iso_epoch(rec["timestamp"]) if rec.get("timestamp") else None
    if ts:
        st["first_ts"] = min(st["first_ts"] or ts, ts)
        st["last_ts"] = max(st["last_ts"] or ts, ts)
    t = rec.get("type")
    if t == "ai-title" and rec.get("aiTitle"):
        st["at"] = rec["aiTitle"]
    elif t == "custom-title" and rec.get("customTitle"):
        st["ct"] = rec["customTitle"]
    elif t == "user":
        txt = _tx_user_text(rec)
        if txt:
            st["prompts"].append({"ts": ts, "text": txt[:_INDEX_TEXT]})
            st["n_prompts"] += 1
            _index_trim(st["prompts"])
    elif t == "assistant" and not rec.get("isSidechain"):
        msg = rec.get("message")
        c = msg.get("content") if isinstance(msg, dict) else None
        if isinstance(c, list):
            txt = " ".join(" ".join(x.get("text", "") for x in c
                                    if isinstance(x, dict) and x.get("type") == "text").split())
            if txt:
                st["last_asst"] = txt[:_INDEX_ASST]


def _tx_scan(st, data):
    """Fold a block of whole lines (bytes) into `st`."""
    for raw in data.split(b"\n"):
        _tx_scan_line(st, raw)
    return st


def _index_key(path):
    return hashlib.sha1(path.encode("utf-8", "surrogateescape")).hexdigest()[:20]


def _index_save(cpath, st):
    """tmp + os.replace, pid-suffixed: every Claude session spawns its own `t mcp`, so
    two processes can refresh the same transcript at once — a shared tmp name would
    let one replace the other's half-written file. Never raises: an unwritable cache
    just means the next process re-reads."""
    tmp = "%s.%d.tmp" % (cpath, os.getpid())
    try:
        os.makedirs(os.path.dirname(cpath), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(st, fh, ensure_ascii=False)
        os.replace(tmp, cpath)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def _index_update(path, cache_dir):
    """The index record for one transcript, refreshed from whatever was appended since
    the cache last saw it. None when the transcript cannot be stat'ed.

    Reset to a full rescan when the cache is missing/corrupt, from an older schema,
    for a different inode (csync's rsync writes a NEW file), or claims more bytes than
    exist (truncation). The delta is read line by line — never fh.read(): a cold ff
    transcript is 100+ MB — and a final line without its newline is NOT consumed, so a
    half-written record is re-read next time instead of parsed in halves."""
    try:
        info = os.stat(path)
    except OSError:
        return None
    cpath = os.path.join(cache_dir, _index_key(path))
    st = None
    try:
        with open(cpath, encoding="utf-8") as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        st = None
    if (not isinstance(st, dict) or st.get("v") != _INDEX_V or st.get("ino") != info.st_ino
            or not isinstance(st.get("off"), int) or st["off"] > info.st_size):
        st = _index_empty(info.st_ino)
    if st["off"] < info.st_size:
        consumed = 0
        try:
            with open(path, "rb") as fh:
                fh.seek(st["off"])
                for line in fh:
                    if not line.endswith(b"\n"):
                        break
                    _tx_scan_line(st, line)
                    consumed += len(line)
        except OSError:
            return None
        if consumed:
            st["off"] += consumed
            _index_save(cpath, st)
    return dict(st, path=path, mtime=info.st_mtime, size=info.st_size)


def _index_all(projects_dir, cache_dir):
    """Records for every ~/.claude/projects/<enc>/<sid>.jsonl. One directory level by
    construction, so the per-session subagent transcripts (<sid>/subagents/*.jsonl)
    are not indexed — a subagent's prompts are Claude's, not the user's."""
    out = []
    for p in sorted(glob.glob(os.path.join(projects_dir, "*", "*.jsonl"))):
        rec = _index_update(p, cache_dir)
        if rec is not None:
            out.append(rec)
    return out


def _index_dedupe(recs):
    """One record per session id. A beam that relands into a new slot COPIES the
    transcript into the new cwd's project dir (see _dev_beam_land_cwd), so the same
    id can sit under two dirs; keep the larger file and remember the other cwds."""
    by_sid, out = {}, []
    for r in recs:
        sid = r.get("sid")
        if not sid:
            out.append(r)
            continue
        cur = by_sid.get(sid)
        if cur is None:
            by_sid[sid] = r
            continue
        keep, drop = (r, cur) if r.get("size", 0) > cur.get("size", 0) else (cur, r)
        also = [c for c in keep.get("also_at", []) + [drop.get("cwd")] if c and c != keep.get("cwd")]
        keep["also_at"] = sorted(set(also))
        by_sid[sid] = keep
    return out + list(by_sid.values())


# ── enrichment ──

def _pr_info(pr, pr_dir):
    """{url, repo, number, state} for a stored 'github.com/o/r/pull/N', else None.
    State is the cached one only (~/.cache/claude-sessions/pr/<o>#<r>#<N>, written by
    the zsh _pr_state_refresh) — a tool call must never block on `gh`."""
    m = _PR_RE.search(pr or "")
    if not m:
        return None
    owner, repo, num = m.groups()
    state = "?"
    try:
        with open(os.path.join(pr_dir, "%s#%s#%s" % (owner, repo, num)), encoding="utf-8") as fh:
            s = fh.read().strip().upper()
        if s in ("MERGED", "CLOSED", "OPEN"):
            state = s.lower()
    except OSError:
        pass
    return {"url": "https://" + m.group(0), "repo": "%s/%s" % (owner, repo),
            "number": int(num), "state": state}


def _opened_stamp(sid, cache_root):
    """mtime of the last-opened stamp claude-stamp-tmux touches on every start; 0 if
    none. Resuming appends nothing, so by transcript mtime alone a just-reopened
    session looks days old."""
    try:
        return os.path.getmtime(os.path.join(cache_root, "opened", sid))
    except OSError:
        return 0


def _origin_of(path):
    """Contents of the <sid>.origin sidecar (hostname -s of where it last ran)."""
    try:
        with open(path[:-6] + ".origin", encoding="utf-8") as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def _activity(rec, opened=0):
    return int(max(rec.get("last_ts") or 0, rec.get("mtime") or 0, opened or 0))


def _ago(epoch, now):
    d = max(0, int(now - epoch))
    if d < 90:
        return "just now"
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 2 * 86400:
        return "%dh ago" % (d // 3600)
    return "%dd ago" % (d // 86400)


def _fmt_ts(epoch):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(epoch)) if epoch else None


def _fmt_short(epoch):
    return time.strftime("%m-%d %H:%M", time.localtime(epoch)) if epoch else None


def _rec_title(rec):
    prompts = rec.get("prompts") or []
    return rec.get("ct") or rec.get("at") or (prompts[0]["text"][:80] if prompts else "") or None


def _local_host():
    return socket.gethostname().split(".")[0]


def _session_row(cfg, rec, live_by_sid, now, cache_root=None, this_sid=None,
                 local_host=None):
    """The dict every tool returns per session. Pure given the record: the only I/O is
    an isdir on the worktree, a stat on the opened stamp, and reads of the two
    sidecar files (PR-state cache, .origin). `origin` is null for this host — it is a
    "last ran ELSEWHERE" signal, like t resume's column."""
    sid = rec.get("sid") or ""
    cwd = rec.get("cwd") or ""
    alias, slot = cfg.repo_of_dir(cwd) if cwd else (None, None)
    live = live_by_sid.get(sid) if sid else None
    key = worktree = None
    if alias and slot:
        key = "%s-%s" % (alias, slot)
        worktree = os.path.join(cfg.worktree_root, os.path.basename(cfg.repos[alias]), slot)
    branch = rec.get("branch")
    if not branch and key:
        branch = "dev/%s-%s" % (os.path.basename(cfg.repos[alias]), slot)
    prompts = rec.get("prompts") or []
    opened = _opened_stamp(sid, cache_root) if (cache_root and sid) else 0
    act = _activity(rec, opened)
    pr_dir = os.path.join(cache_root, "pr") if cache_root else ""
    origin = _origin_of(rec["path"]) if rec.get("path") else None
    if origin and origin == (local_host or _local_host()):
        origin = None
    return {
        "sid": sid, "short": sid[:8], "title": _rec_title(rec),
        "repo": alias, "slot": live["slot"] if live else key,
        "cwd": cwd, "worktree": worktree,
        "worktree_exists": bool(worktree and os.path.isdir(worktree)),
        "branch": branch, "live": bool(live),
        "state": live["state"] if live else "dead",
        "context": live.get("context") if live else None,
        "host": "local",
        "origin": origin,
        "started": _fmt_ts(rec.get("first_ts")),
        "last_activity": _fmt_ts(act), "ago": _ago(act, now), "activity_epoch": act,
        "pr": _pr_info(rec.get("pr"), pr_dir), "plan": rec.get("plan"),
        "prompts_total": rec.get("n_prompts", 0),
        "first_prompts": [p["text"] for p in prompts[:3]],
        "last_prompts": [p["text"] for p in prompts[-3:]] if len(prompts) > 3 else [],
        "url": None,
        "this_session": bool(this_sid and sid == this_sid),
    }


# ── liveness ──

def _live_index(tmux_rows, panes, parents, registry, cfg):
    """Join the pid registry to tmux → ({sid: {slot, cwd, state, kind, context}},
    [idle dev-* slots with no registered claude]).

    tmux_rows: (session_name, session_path, attached|detached); panes: (session_name,
    pane_pid); parents: {pid: ppid} for the whole process table; registry: {pid: (sid,
    cwd)} per live claude. A registered claude whose ANCESTRY reaches a dev-* pane is
    that slot's session — the pid walk _dev_session_sid does, rather than a cwd
    compare, because two claudes in one directory (a slot plus a foreground one, or
    two slots opened in a shared tree) are indistinguishable by cwd. Any other
    registered claude is a foreground one, labelled <repo>:<sid[:8]> the way t ls
    does. Ordered by pid so the older claude in a pane wins a tie (a `claude -p`
    child spawned inside a session registers too, briefly)."""
    sess = {name: (path, state) for name, path, state in tmux_rows if name.startswith("dev-")}
    pane_session = {int(pid): name for name, pid in panes
                    if name in sess and str(pid).isdigit()}
    out, claimed = {}, {}
    for pid in sorted(registry, key=int):
        sid, cwd = registry[pid]
        if not sid or sid in out:
            continue
        cur, hops, found = int(pid), 0, None
        while cur and cur > 1 and hops < 64:
            if cur in pane_session:
                found = pane_session[cur]
                break
            cur, hops = parents.get(cur, 0), hops + 1
        if found and found not in claimed:
            claimed[found] = sid
            path, state = sess[found]
            out[sid] = {"slot": found[4:], "cwd": cwd or path, "state": state,
                        "kind": "tmux", "context": "active"}
        else:
            alias, _ = cfg.repo_of_dir(cwd) if cwd else (None, None)
            label = "%s:%s" % (alias or os.path.basename(cwd or "") or "?", sid[:8])
            out[sid] = {"slot": label, "cwd": cwd, "state": "foreground",
                        "kind": "foreground", "context": "active"}
    idle = [{"slot": name[4:], "cwd": path, "state": state, "context": "idle"}
            for name, (path, state) in sess.items() if name not in claimed]
    return out, idle


def _live_rows(cache_root, projects_dir):
    """Gather for _live_index: two tmux forks, one ps, and the registry files whose
    pid is alive. A dev-* session with no registered claude falls back to its
    CLAUDE_RESUME_ID stamp — accepted only when the transcript exists under that
    slot's own project dir (a reused slot can carry a stale, even cross-repo, stamp)
    — injected as a registry entry keyed on the PANE pid, so the join is uniform."""
    def tmux(*fmt):
        try:
            r = subprocess.run(["tmux"] + list(fmt), stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, text=True)
        except OSError:
            return ""
        return r.stdout
    tmux_rows, panes = [], []
    for line in tmux("list-sessions", "-F", "#{session_name}\t#{session_path}\t"
                     "#{?session_attached,attached,detached}").splitlines():
        f = line.split("\t")
        if len(f) == 3:
            tmux_rows.append(tuple(f))
    for line in tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_pid}").splitlines():
        f = line.split("\t")
        if len(f) == 2:
            panes.append((f[0], f[1]))
    parents = {}
    try:
        r = subprocess.run(["ps", "-Axo", "pid=,ppid="], stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, text=True)
        for line in r.stdout.splitlines():
            f = line.split()
            if len(f) == 2 and f[0].isdigit() and f[1].isdigit():
                parents[int(f[0])] = int(f[1])
    except OSError:
        pass
    registry = {}
    for p in glob.glob(os.path.join(cache_root, "*")):
        name = os.path.basename(p)
        if not name.isdigit():
            continue
        try:
            os.kill(int(name), 0)
        except ProcessLookupError:
            continue
        except OSError:
            pass                      # EPERM: alive, just not ours
        try:
            with open(p, encoding="utf-8") as fh:
                sid, _, cwd = fh.read().strip().partition("\t")
        except OSError:
            continue
        if sid:
            registry[int(name)] = (sid, cwd)
    pane_of = {name: int(pid) for name, pid in panes if str(pid).isdigit()}
    # Which sessions are already covered by a registered claude's ancestry?
    covered = set()
    for pid in registry:
        cur, hops = pid, 0
        while cur and cur > 1 and hops < 64:
            for name, ppid in pane_of.items():
                if ppid == cur:
                    covered.add(name)
            cur, hops = parents.get(cur, 0), hops + 1
    for name, path, _ in tmux_rows:
        if not name.startswith("dev-") or name in covered or name not in pane_of:
            continue
        sid = tmux("show-environment", "-t", name, "CLAUDE_RESUME_ID").strip().partition("=")[2]
        enc = re.sub(r"[^A-Za-z0-9]", "-", path)
        if sid and os.path.exists(os.path.join(projects_dir, enc, sid + ".jsonl")):
            registry[pane_of[name]] = (sid, path)
    return tmux_rows, panes, parents, registry


# ── search ──

_KW_STOP = {"of", "the", "a", "an", "to", "on", "in", "for", "and", "is", "it", "with",
            "at", "which", "session", "was", "working", "that", "this", "where", "did",
            "i", "my", "we", "one", "had", "have", "has", "be", "do", "make", "making"}
_KW_PUNCT = "\"'`,.;:!?()[]{}<>"


def _kw_terms(query):
    """Query → search terms. Lowercase, punctuation-stripped, stopwords and one-char
    tokens dropped, crudely singularized (payments → payment; a substring match then
    covers both), deduped in order. A leading `#` survives, so `#accounts` still
    matches the page anchor the user actually typed."""
    out = []
    for tok in (query or "").lower().split():
        tok = tok.strip(_KW_PUNCT)
        core = tok.lstrip("#")
        if len(core) < 2 or core in _KW_STOP:
            continue
        if len(core) > 3 and core.endswith("s") and not core.endswith("ss"):
            core = core[:-1]
        term = ("#" + core) if tok.startswith("#") else core
        if term not in out:
            out.append(term)
    return out


def _kw_score(rec, terms):
    """Relevance of one record to the terms: body hits plus 4x for a hit in the head
    (title or first prompt) — the same weighting .zshrc's _claude_session_rows uses,
    so `t find -k` and this agree on order. Substring counting is deliberate
    (`account` matches `#accounts`). Recall only: the caller reads the excerpts.

    TODO(ranking): the one function here with real design latitude. Candidates —
    a per-term presence bonus (a session naming every term beats one repeating one),
    recency decay, an exact-match boost for #tags. Left as the plain count on purpose."""
    prompts = rec.get("prompts") or []
    head = (rec.get("ct") or rec.get("at") or (prompts[0]["text"] if prompts else "")).lower()
    body = " ".join(p["text"] for p in prompts).lower()
    return sum(body.count(t) + 4 * head.count(t) for t in terms)


def _kw_excerpts(prompts, terms, n=3, width=240):
    """The `n` prompts with the most term hits (ties → latest), each cut to a window
    around its first hit and dated, so the caller can judge the match from what the
    user actually said. A prompt with no hit is never shown."""
    scored = []
    for idx, p in enumerate(prompts):
        low = p["text"].lower()
        hits = sum(low.count(t) for t in terms)
        if hits:
            scored.append((hits, idx))
    scored.sort(key=lambda x: (-x[0], -x[1]))
    out = []
    for _, idx in scored[:n]:
        text = prompts[idx]["text"]
        low = text.lower()
        pos = min(low.find(t) for t in terms if t in low)
        start = max(0, pos - width // 3)
        end = min(len(text), start + width)
        snip = ("…" if start else "") + text[start:end] + ("…" if end < len(text) else "")
        when = _fmt_short(prompts[idx].get("ts"))
        out.append("%s · %s" % (when, snip) if when else snip)
    return out


def _repo_path(cfg, alias):
    return cfg.repos.get(alias) if alias else None


def _find_sessions(recs, terms, live_by_sid, cfg, days=60, repo=None, limit=10, now=None,
                   cache_root=None, this_sid=None):
    now = now or time.time()
    days = max(0, int(days or 0))
    limit = max(1, min(30, int(limit or 10)))
    cutoff = now - days * 86400 if days else 0
    want = None
    if repo:
        want = cfg.repos.get(repo)
        if not want:
            raise ValueError("unknown repo alias %r — one of: %s"
                             % (repo, ", ".join(sorted(cfg.repos)) or "(none configured)"))
    hits, scanned = [], 0
    for rec in recs:
        if not rec.get("n_prompts"):
            continue                    # a conversationless stub: nothing was said
        scanned += 1
        if want and _repo_path(cfg, cfg.repo_of_dir(rec.get("cwd") or "")[0]) != want:
            continue
        score = _kw_score(rec, terms)
        if not score:
            continue
        row = _session_row(cfg, rec, live_by_sid, now, cache_root, this_sid)
        if cutoff and row["activity_epoch"] < cutoff:
            continue
        row["score"] = score
        row["excerpts"] = _kw_excerpts(rec.get("prompts") or [], terms)
        hits.append(row)
    hits.sort(key=lambda r: (r["score"], r["activity_epoch"]), reverse=True)
    return {"query_terms": terms, "window_days": days, "scanned": scanned,
            "matched": len(hits), "results": hits[:limit]}


# ── one session ──

_SLOT_REF_RE = re.compile(r"^([A-Za-z0-9_.-]+?)[- ](\d+)$")
_HEX_REF_RE = re.compile(r"^[0-9a-f-]{4,}$")


def _session_ref_resolve(ref, cfg, recs, live_by_sid):
    """A tool's `session` argument → its index record, or ValueError with a teaching
    message. Forms, most specific first: dev-<x> (stripped); <alias>-<n> / <alias> <n>
    with a real DEV_REPOS alias and a numeric tail (rpartition on the last dash —
    so `financial-forecast-17` is a slot of financial-forecast)
    → the live session rooted at that slot's worktree, else the slot's newest real
    transcript; <alias>:<hex> or a bare hex prefix → a unique session id."""
    ref = (ref or "").strip()
    if ref.startswith("dev-"):
        ref = ref[4:]
    by_sid = {r["sid"]: r for r in recs if r.get("sid")}
    m = _SLOT_REF_RE.match(ref)
    if m and m.group(1) in cfg.repos:
        alias, n = m.groups()
        path = cfg.repos[alias]
        wt = os.path.join(cfg.worktree_root, os.path.basename(path), n)
        for sid, info in live_by_sid.items():
            if info.get("cwd") == wt and sid in by_sid:
                return by_sid[sid]
        for sid, info in live_by_sid.items():
            head, _, num = info.get("slot", "").rpartition("-")
            if num == n and cfg.repos.get(head) == path and sid in by_sid:
                return by_sid[sid]
        cands = [r for r in recs if r.get("cwd") == wt and r.get("n_prompts")]
        if cands:
            return max(cands, key=lambda r: (r.get("last_ts") or 0, r.get("mtime") or 0))
        raise ValueError("no transcript for slot %s-%s here (never run, a shared-tree repo, "
                         "or only on another host) — give a session id instead" % (alias, n))
    if ":" in ref:
        ref = ref.rsplit(":", 1)[1]
    if _HEX_REF_RE.match(ref):
        hits = [r for sid, r in by_sid.items() if sid.startswith(ref)]
        if len(hits) == 1:
            return hits[0]
        if hits:
            raise ValueError("ambiguous session id prefix %r: %s" % (
                ref, "; ".join("%s %s" % (r["sid"][:8], _rec_title(r) or "(untitled)")
                               for r in hits[:8])))
        raise ValueError("no session id starting with %r" % ref)
    raise ValueError("session must be a session id (or unique prefix) or a slot like "
                     "ff-17 / dot-6 — aliases: %s" % (", ".join(sorted(cfg.repos)) or "(none)"))


def _git_brief(path):
    """{branch, log[≤10], status[≤20], dirty} for a checkout, None if absent/not git."""
    if not path or not os.path.isdir(path):
        return None

    def run(args):
        try:
            r = subprocess.run(["git", "-C", path] + args, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                               text=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            return None
        return r.stdout if r.returncode == 0 else None

    branch = run(["rev-parse", "--abbrev-ref", "HEAD"])
    if branch is None:
        return None
    log = (run(["log", "--oneline", "-10"]) or "").splitlines()
    status = (run(["status", "--porcelain"]) or "").splitlines()
    return {"branch": branch.strip(), "log": log, "status": status[:20], "dirty": bool(status)}


def _plan_head_lines(path, n=40):
    """First n lines of a plan file, or None when it is not here (plans are per-host:
    csync syncs them only periodically)."""
    try:
        n = max(1, int(n))
        with open(path, encoding="utf-8", errors="replace") as fh:
            out = []
            for line in fh:
                out.append(line.rstrip("\n"))
                if len(out) >= n:
                    break
            return out
    except (OSError, TypeError, ValueError):
        return None


# ── the tools ──

_MCP_SERVER_INFO = {"name": "sessions", "version": "1"}
_MCP_PROTOCOL_FALLBACK = "2025-06-18"
_MCP_INSTRUCTIONS = (
    "Claude Code session awareness for this machine: its tmux dev slots, foreground "
    "claudes, and every saved transcript. Use these tools UNPROMPTED — the user will not "
    "name this server — whenever they ask which session/slot/worktree/branch is or was "
    "working on something ('which session had the accounts redesign?'), what a slot is "
    "doing or where it left off, or which PR a session opened. find_sessions returns candidates WITH prompt excerpts: judge the match "
    "yourself from the excerpts and titles, then session_detail for the winner. Slots are "
    "named <repo>-<n> (tmux session dev-<repo>-<n>, worktree ~/code/.worktrees/<basename>/"
    "<n>, branch dev/<basename>-<n>); a live one is attached with `t open <repo> <n>`, a "
    "dead one revived with `t resume <repo> <n>` — tell the user those commands rather than running them. A result flagged "
    "this_session is the conversation you are in.")

_MCP_TOOLS = [
    {"name": "find_sessions",
     "description": (
         "Keyword search over EVERY saved Claude Code transcript on this machine — titles "
         "plus every prompt the user typed (not just the first). Use it when the user asks "
         "which session, slot, worktree, or branch is or was working on something. Returns "
         "candidates with prompt EXCERPTS: read them and judge the match yourself; the "
         "score is recall, not truth. Then session_detail on the one that fits."),
     "inputSchema": {"type": "object", "properties": {
         "query": {"type": "string",
                   "description": "a few keywords, e.g. 'accounts page redesign' or "
                                  "'amex extra payment reschedule'"},
         "days": {"type": "integer", "default": 60,
                  "description": "only sessions active within N days; 0 = no window"},
         "repo": {"type": "string",
                  "description": "DEV_REPOS alias to restrict to (ff, dot, cfp, …)"},
         "limit": {"type": "integer", "default": 10, "maximum": 30}},
         "required": ["query"]}},
    {"name": "list_sessions",
     "description": (
         "The live Claude sessions right now: tmux dev slots (<repo>-<n>) and foreground "
         "claudes, with title, branch, PR + state, dev-server URL, and "
         "the last prompts. Use it for 'what is running', 'what is slot 17 doing', or to "
         "map a slot to its worktree/branch. all_hosts also asks the other machines "
         "(slow: several seconds)."),
     "inputSchema": {"type": "object", "properties": {
         "repo": {"type": "string", "description": "DEV_REPOS alias to restrict to"},
         "all_hosts": {"type": "boolean", "default": False}}}},
    {"name": "session_detail",
     "description": (
         "Everything about one session: title, cwd, worktree, branch, git log/status of "
         "the worktree if it still exists, live state, PR + state, plan "
         "file head, the first and last prompts, and the last assistant message (where it "
         "left off). `session` is a session id or unique prefix, or a slot like ff-17 / "
         "dot-6 (live slot → its session; dead slot → its newest transcript)."),
     "inputSchema": {"type": "object", "properties": {
         "session": {"type": "string"},
         "plan_lines": {"type": "integer", "default": 40}},
         "required": ["session"]}},
]


def _mcp_context(cfg, state):
    """Everything a tool call reads, gathered once per call (glue): the index (re-stat
    at most every _INDEX_REFRESH_S — a back-to-back pair of calls must not walk 600
    files twice) and liveness."""
    now = time.time()
    if state.get("recs") is None or now - state.get("at", 0) > _INDEX_REFRESH_S:
        state["recs"] = _index_dedupe(_index_all(_projects_dir(), _index_dir()))
        state["at"] = now
    tmux_rows, panes, parents, registry = _live_rows(_cache_root(), _projects_dir())
    live_by_sid, idle = _live_index(tmux_rows, panes, parents, registry, cfg)
    return {"recs": state["recs"], "live": live_by_sid, "idle": idle,
            "live_rows": [{"slot": v["slot"]} for v in live_by_sid.values()]
                         + [{"slot": i["slot"]} for i in idle],
            "now": now, "cache_root": _cache_root(),
            "this_sid": os.environ.get("CLAUDE_CODE_SESSION_ID")}


def _tool_find(cfg, ctx, args):
    terms = _kw_terms(args.get("query", ""))
    if not terms:
        raise ValueError("give me a few keywords — e.g. 'accounts page redesign'")
    return _find_sessions(ctx["recs"], terms, ctx["live"], cfg, days=args.get("days", 60),
                          repo=args.get("repo"), limit=args.get("limit", 10), now=ctx["now"],
                          cache_root=ctx["cache_root"], this_sid=ctx["this_sid"])


def _tool_list(cfg, ctx, args):
    repo = args.get("repo")
    want = cfg.repos.get(repo) if repo else None
    if repo and not want:
        raise ValueError("unknown repo alias %r — one of: %s"
                         % (repo, ", ".join(sorted(cfg.repos)) or "(none configured)"))
    by_sid = {r["sid"]: r for r in ctx["recs"] if r.get("sid")}
    rows = []
    for sid, info in ctx["live"].items():
        rec = by_sid.get(sid) or {"sid": sid, "cwd": info.get("cwd"), "prompts": [],
                                  "n_prompts": 0, "mtime": ctx["now"]}
        row = _session_row(cfg, rec, ctx["live"], ctx["now"], ctx["cache_root"],
                           ctx["this_sid"])
        if not by_sid.get(sid):
            row["title"] = "(no transcript yet)"
        rows.append(row)
    for i in ctx["idle"]:
        alias, _ = cfg.repo_of_dir(i["cwd"]) if i.get("cwd") else (None, None)
        rows.append({"sid": "", "short": "", "title": "(no active conversation)",
                     "repo": alias, "slot": i["slot"], "cwd": i["cwd"], "live": True,
                     "state": i["state"], "context": "idle", "host": "local",
                     "url": None,
                     "this_session": False})
    for row in rows:
        if row.get("slot") and row.get("cwd"):
            row["url"] = _dev_url(row["slot"], row["cwd"])
    if want:
        rows = [r for r in rows if cfg.repos.get(r.get("repo")) == want]
    rows.sort(key=lambda r: (r.get("repo") or "~", _slot_sort_key(r.get("slot") or "")))
    out = {"count": len(rows), "sessions": rows}
    if args.get("all_hosts"):
        remote = []
        for r in _parse_rows(zsh_capture("_dev_rows_all", stdin=subprocess.DEVNULL),
                             host_prefixed=True):
            if r["host"] == "local":
                continue
            alias, _ = cfg.repo_of_dir(r["cwd"]) if r["cwd"] else (None, None)
            remote.append({"host": r["host"], "sid": "" if r["sid"] == "-" else r["sid"],
                           "repo": alias, "slot": r["slot"], "cwd": r["cwd"], "live": True,
                           "state": r["state"], "context": r["context"],
                           "title": r["summary"]})
        out["remote"] = remote
        out["hosts"] = sorted(cfg.hosts)
    return out


def _slot_sort_key(slot):
    head, _, num = slot.rpartition("-")
    return (head, int(num)) if num.isdigit() else (slot, 0)


def _tool_detail(cfg, ctx, args):
    rec = _session_ref_resolve(args.get("session", ""), cfg, ctx["recs"], ctx["live"])
    row = _session_row(cfg, rec, ctx["live"], ctx["now"], ctx["cache_root"], ctx["this_sid"])
    prompts = rec.get("prompts") or []
    row["first_prompts"] = [{"at": _fmt_short(p.get("ts")), "text": p["text"]} for p in prompts[:3]]
    row["last_prompts"] = [{"at": _fmt_short(p.get("ts")), "text": p["text"]}
                           for p in prompts[-10:]] if len(prompts) > 3 else []
    row["last_assistant"] = rec.get("last_asst")
    row["also_at"] = rec.get("also_at") or []
    if row.get("slot") and row.get("cwd"):
        row["url"] = _dev_url(row["slot"], row["cwd"])
    row["git"] = _git_brief(row["worktree"] if row.get("worktree_exists") else row["cwd"])
    row["plan_head"] = _plan_head_lines(row["plan"], args.get("plan_lines", 40)) if row.get("plan") else None
    hints = []
    alias, slot = cfg.repo_of_dir(row["cwd"] or "") if row.get("cwd") else (None, None)
    if alias and slot:
        hints.append(("t open %s %s" if row["live"] else "t resume %s %s") % (alias, slot))
        if not row["worktree_exists"]:
            hints.append("worktree is gone (swept after merge?) — t resume rebuilds it from branch %s"
                         % row["branch"])
    row["hints"] = hints
    return row


_MCP_HANDLERS = {"find_sessions": _tool_find, "list_sessions": _tool_list,
                 "session_detail": _tool_detail}


def _mcp_call(cfg, state, name, args):
    return _MCP_HANDLERS[name](cfg, _mcp_context(cfg, state), args or {})


# ── framing (mirrors hive's mcp_servers/protocol.py) ──

def _mcp_result(mid, payload):
    return {"jsonrpc": "2.0", "id": mid, "result": payload}


def _mcp_error(mid, code, message):
    return {"jsonrpc": "2.0", "id": mid, "error": {"code": code, "message": message}}


def _mcp_text(text, is_error=False):
    return {"content": [{"type": "text", "text": text}], "isError": is_error}


def _mcp_handle(msg, tools, call, server_info=None, instructions=None):
    """One decoded message → one response dict, or None for anything that must not be
    answered (notifications). initialize echoes the client's protocolVersion so a
    client-side bump alone cannot break the handshake; unknown requests get -32601;
    a tool that raises becomes an isError result, never a dead loop."""
    if not isinstance(msg, dict):
        return _mcp_error(None, -32600, "invalid request")
    method = msg.get("method")
    mid = msg.get("id")
    if method is None or method.startswith("notifications/"):
        return None
    if method == "initialize":
        params = msg.get("params") or {}
        result = {"protocolVersion": params.get("protocolVersion") or _MCP_PROTOCOL_FALLBACK,
                  "capabilities": {"tools": {}},
                  "serverInfo": server_info or _MCP_SERVER_INFO}
        if instructions:
            result["instructions"] = instructions
        return _mcp_result(mid, result)
    if method == "ping":
        return _mcp_result(mid, {})
    if method == "tools/list":
        return _mcp_result(mid, {"tools": tools})
    if method == "prompts/list":
        return _mcp_result(mid, {"prompts": []})
    if method == "resources/list":
        return _mcp_result(mid, {"resources": []})
    if method == "tools/call":
        params = msg.get("params") or {}
        name = params.get("name", "")
        args = params.get("arguments") or {}
        if not any(t["name"] == name for t in tools):
            return _mcp_result(mid, _mcp_text(
                "unknown tool: %s — one of: %s" % (name, ", ".join(t["name"] for t in tools)),
                is_error=True))
        try:
            result = call(name, args)
        except Exception as e:  # noqa: BLE001 — every failure must become a result
            return _mcp_result(mid, _mcp_text("%s: %s" % (type(e).__name__, e), is_error=True))
        return _mcp_result(mid, _mcp_text(
            json.dumps(result, ensure_ascii=False, indent=1, default=str)))
    return _mcp_error(mid, -32601, "method not found: %s" % method)


def _mcp_serve(cfg):
    """The stdio loop. stdout is the wire: one JSON line per request, nothing else."""
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass
    state = {}

    def call(name, args):
        return _mcp_call(cfg, state, name, args)

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            sys.stdout.write(json.dumps(_mcp_error(None, -32700, "parse error")) + "\n")
            sys.stdout.flush()
            continue
        resp = _mcp_handle(msg, _MCP_TOOLS, call, _MCP_SERVER_INFO, _MCP_INSTRUCTIONS)
        if resp is not None:
            sys.stdout.write(json.dumps(resp, ensure_ascii=False) + "\n")
            sys.stdout.flush()
    return 0


def _mcp_registered(claude_json):
    """Is the `sessions` server in ~/.claude.json's user-scope mcpServers? True/False,
    None when the file is missing or unreadable. Read directly rather than via
    `claude mcp get`, which SPAWNS the server to health-check it."""
    try:
        with open(claude_json, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    servers = data.get("mcpServers") if isinstance(data, dict) else None
    return bool(isinstance(servers, dict) and "sessions" in servers)


# Registration alone still leaves every tool call behind a permission prompt, and a
# prompt per lookup makes the server useless mid-turn — the model asks "which slot had
# X?" three times in a row and stalls three times. This server is ours and read-only
# (three lookups over local transcripts and tmux, spawned by `t mcp`
# from this very checkout), so the allow rule is seeded BY DEFAULT: the blanket
# server-wide form, so a tool added to `t mcp` later is covered the day it ships.
# Deliberate consequence: a future WRITE-capable sessions tool would inherit the
# allowance — narrow this to explicit `mcp__sessions__<tool>` rules if that ever lands.
_MCP_ALLOW_RULE = "mcp__sessions"


def _mcp_allow_state(settings):
    """How ~/.claude/settings.json permits the sessions tools:

    "server" — the blanket `mcp__sessions` rule (what we seed),
    "tools"  — only per-tool `mcp__sessions__<name>` rules, i.e. a deliberate
               hand-narrowing, so it counts as configured and is never widened
               back out from under you,
    "none"   — nothing matches, so every call prompts,
    None     — the file is missing or unreadable (not ours to judge or repair).
    """
    try:
        with open(settings, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    perms = data.get("permissions") if isinstance(data, dict) else None
    allow = perms.get("allow") if isinstance(perms, dict) else None
    rules = [r for r in allow if isinstance(r, str)] if isinstance(allow, list) else []
    if _MCP_ALLOW_RULE in rules:
        return "server"
    if any(r.startswith(_MCP_ALLOW_RULE + "__") for r in rules):
        return "tools"
    return "none"


def _mcp_allow_write(settings):
    """Append the blanket allow rule. Add-only, the same stance as the registration
    itself: a hand-narrowed per-tool set, a deny/ask rule, or an unreadable file is
    left exactly as found. Written tmp + os.replace because Claude Code owns this
    file at runtime. True only when the file actually changed."""
    if _mcp_allow_state(settings) != "none":
        return False
    try:
        with open(settings, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return False
    if not isinstance(data, dict):
        return False
    perms = data.setdefault("permissions", {})
    if not isinstance(perms, dict):
        return False
    allow = perms.setdefault("allow", [])
    if not isinstance(allow, list):
        return False
    allow.append(_MCP_ALLOW_RULE)
    tmp = settings + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, settings)
    return True


def _mcp_install():
    """Register with Claude Code at user scope, via `claude mcp add` (Claude's own
    writer — never a hand edit of the stateful ~/.claude.json). The EXPANDED path:
    the stdio spawn does not go through a shell, so `$HOME/bin/t` would be exec'd
    literally (the SessionStart hook command, by contrast, is run through one)."""
    cmd = ["claude", "mcp", "add", "sessions", "-s", "user", "--",
           os.path.join(HOME, "bin", "t"), "mcp"]
    settings = os.path.join(HOME, ".claude", "settings.json")
    if _mcp_registered(os.path.join(HOME, ".claude.json")):
        print("MCP server 'sessions' is already registered (user scope)")
        _mcp_allow_announce(settings)
        return 0
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL)
    except OSError:
        r = None
    if r is None or r.returncode:
        print("could not register — run by hand: %s" % " ".join(shlex.quote(c) for c in cmd),
              file=sys.stderr)
        return 1
    print("registered MCP server 'sessions' (user scope) → %s mcp" % cmd[-2])
    _mcp_allow_announce(settings)
    return 0


def _mcp_allow_announce(settings):
    """Seed the allow rule and say so — the manual twin of install.sh's merge, so
    `t mcp --install` on a box `dots` has not reached is a complete setup."""
    if _mcp_allow_write(settings):
        print("allowed %s in %s (its tools no longer prompt)"
              % (_MCP_ALLOW_RULE, settings.replace(HOME, "~")))
    elif _mcp_allow_state(settings) == "tools":
        print("leaving the per-tool %s__* allow rules in %s alone"
              % (_MCP_ALLOW_RULE, settings.replace(HOME, "~")))


def cmd_mcp(cfg, args):
    if args.install:
        return _mcp_install()
    if args.list_tools:
        for t in _MCP_TOOLS:
            print("%-16s %s" % (t["name"], t["description"].split(". ")[0] + "."))
        return 0
    if args.reindex:
        recs = _index_all(_projects_dir(), _index_dir())
        print("indexed %d transcript(s), %.1f MB" % (len(recs), sum(r.get("size", 0) for r in recs) / 1e6))
        return 0
    if args.call:
        name, rest = args.call[0], args.call[1:]
        if name not in _MCP_HANDLERS:
            print("t mcp --call: unknown tool %r — one of: %s"
                  % (name, ", ".join(_MCP_HANDLERS)), file=sys.stderr)
            return 2
        try:
            params = json.loads(rest[0]) if rest else {}
        except ValueError as e:
            print("t mcp --call: arguments must be JSON (%s)" % e, file=sys.stderr)
            return 2
        try:
            result = _mcp_call(cfg, {}, name, params)
        except ValueError as e:
            print("t mcp --call: %s" % e, file=sys.stderr)
            return 1
        json.dump(result, sys.stdout, ensure_ascii=False, indent=1, default=str)
        print()
        return 0
    return _mcp_serve(cfg)


# ─── argument parsing (gh-style) ───────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="t", description="Claude session manager (open/list/move tmux'd Claude sessions).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  t open api              open/reattach the next free api slot
  t open api 3 --new      force a fresh session in api slot 3
  t open                  open/reattach in the repo cwd is in
  t paste 4               slot-only args mean the cwd repo (all verbs)
  t open ff -r --new      start a fresh session on the default remote host
  t open ff --host mini   start/attach a session on 'mini' (a specific remote host)
  t open a4aa5f6a         adopt a foreground (:fg) session here (id from t ls)
  t ls                    list this repo's live sessions
  t ls -r                 list live sessions across every machine
  t push                  send the current session to a background tmux slot
  t pop api 3             pull dev-api-3 back to this terminal
  t resume api 3          revive dev-api-3's last conversation after it was closed
  t cd ff 5               cd this shell into ff's slot-5 worktree (bare t cd: picker)
  t beam api --host mini  send a session to 'mini' and resume it there
  t find "auth refactor"  search saved sessions, then resume the pick
  t mcp --call find_sessions '{"query":"accounts redesign"}'
                          ask the sessions MCP by hand (Claude calls it for you)
  t on mini ls            run a command on a remote host
  t setup                 onboard this machine: register ~/code repos + ssh hosts
  t install               install + log in the agent CLIs (claude, codex, cursor) here and on every host
  t new tool-x            wizard: create ~/code/tool-x + github <owner>/tool-x, register it everywhere

agents — what each verb supports per agent (t install --status adds this machine's state):
""" + "\n".join(_agent_parity_render()) + """

Run `t <verb> -h` for a verb's own flags.""")
    sub = p.add_subparsers(dest="verb", metavar="<verb>")

    sp = sub.add_parser("open", help="open or reattach a session in a per-repo tmux slot",
        description="Open or reattach a Claude session in a per-repo tmux slot. Bare `t open` "
            "(or a lone slot like `t open 3`) targets the repo your cwd is in. A slot that is "
            "live only on another host is attached in place automatically — no flag needed. "
            "`--new` forces a fresh session, `--fg` runs inline without a tmux slot, and "
            "`-r`/`--host` open or attach on a remote host (`-r --new` starts one there).")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key, or a foreground session id/repo:id from `t ls`")
    sp.add_argument("slot", nargs="?", help="slot number, 'fg' (adopt a :fg session), or a session id")
    sp.add_argument("--new", action="store_true", help="force a fresh session")
    sp.add_argument("--fg", action="store_true", help="no tmux: foreground-resume / run inline")
    sp.add_argument("-l", "--local", "--here", dest="local", action="store_true", help="force this machine: skip the remote auto-attach probe (combine with --fg for local foreground)")
    sp.add_argument("-r", "--remote", action="store_true", help="remote: attach a live slot on any host; with --new, start one on the default host")
    sp.add_argument("--host", help="which host to open/attach on (sets the host for -r; default for --new: first $REMOTE_HOSTS)")

    sp = sub.add_parser("ls", help="list dev sessions (attached + active context)",
        description="List live Claude dev sessions: whether each is attached, and whether it "
            "has an active conversation loaded (vs. parked on the startup splash). Scoped to the "
            "repo your cwd is in by default (`t ls <repo>` scopes to a named repo from anywhere); "
            "`-a` widens to every repo, and `-r` spans every "
            "$REMOTE_HOSTS machine in one table with a HOST column. Read-only — attach with "
            "`t open`, move with `t beam`.")
    sp.add_argument("repo", nargs="?", help="scope to this repo from any directory (default: the repo cwd is in)")
    sp.add_argument("-r", "--remote", action="store_true", help="span every $REMOTE_HOSTS host")
    sp.add_argument("-a", "--all", action="store_true", help="every repo (not just the current)")

    sp = sub.add_parser("kill", help="tear down a session",
        description="Tear down a dev session (kill its tmux slot). Names default to the cwd "
            "repo, so `t kill 3` kills this repo's slot 3 and `t kill all` kills every slot for "
            "it. A foreground / :fg row from `t ls` (a bare `claude`, or a pr-watch `pr-*` "
            "session) is killed by its shown id/label — `t kill dotfiles-pr47:fg` or `t kill "
            "<short-id>` — since it is not a dev slot. Confirms first while a Claude is live "
            "unless `-y`; `-r` kills it on its remote host instead.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key (or a :fg id/label); defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("-y", "--yes", action="store_true", help="skip the 'Claude is live' confirm")
    sp.add_argument("-r", "--remote", action="store_true", help="kill it on its host instead")

    sp = sub.add_parser("push", help="push this session into a detached background tmux slot",
        description="Push the current Claude session into a detached background tmux slot — "
            "frees this terminal while the conversation keeps running. Inside Claude it "
            "backgrounds THIS chat (and exits it for you); from a plain shell it fzf-picks a "
            "session (scoped to the cwd repo, `-a` for every project). Bring it back with "
            "`t pop`. Inverse of `t pop`.")
    sp.add_argument("-p", "--pick", action="store_true", help="force the picker")
    sp.add_argument("-a", "--all", action="store_true", help="picker across every project")

    sp = sub.add_parser("pop", help="pull a tmux'd session back to the foreground",
        description="Pull a backgrounded (tmux'd) session back into THIS terminal and resume it "
            "in the foreground. Names default to the cwd repo, so `t pop` picks this repo's slot "
            "and `t pop api 3` pulls dev-api-3. Inverse of `t push`.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")

    sp = sub.add_parser("resume", help="revive a dead slot's saved conversation",
        description="Revive a DEAD dev slot's conversation (`t open` on a dead slot "
            "deliberately starts fresh — this brings the chat back). Offers EVERY conversation "
            "saved in the slot's own per-session worktree (one global newest-first list by "
            "session time — never grouped by repo; live rows on top when shown; conversationless stubs "
            "skipped), rebuilding a reaped worktree from its branch first, then resumes the pick "
            "in a fresh dev slot and attaches. Names default to "
            "the cwd repo; outside any repo dir a bare `t resume` scans every worktree repo. "
            "One candidate is taken, several fzf-pick (an explicit slot with no TTY takes the "
            "newest). The picker MULTI-SELECTS: space-mark several rows with a ✓ (tab works "
            "too) and every marked dead "
            "slot revives into its own detached dev slot — the first attaches, the rest open "
            "in NEW terminal tabs (Terminal.app/iTerm2; `t open` hints when tabs are "
            "impossible — ssh, unrecognized terminal, no Accessibility; --fg takes a single "
            "pick only). "
            "LIVE slots are hidden by default (a stderr count names them — `t open` is "
            "the verb for a running slot); -l/--live lists them as labeled rows — "
            "'● active' / '● on <host>' — and picking one ATTACHES in place (locally or on "
            "its host) instead of resuming; naming a live slot explicitly always attaches. "
            "Worktree-per-session repos only (a shared tree's transcripts are "
            "ambiguous per-slot — use `t push -p` there).")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("-f", "--fg", action="store_true", help="resume inline in THIS terminal (no tmux slot)")
    sp.add_argument("-a", "--all", action="store_true", help="scan every worktree repo (the default outside a repo dir)")
    sp.add_argument("-l", "--live", action="store_true",
        help="also list LIVE slots (hidden by default) as '● active' / '● on <host>' rows that attach on pick")
    sp.add_argument("-r", "--remote", action="store_true",
        help="pull the latest transcripts from every $REMOTE_HOSTS host first (direct rsync; "
             "csync is periodic and needs a shell on the far side), then scan as usual")
    sp.add_argument("--days", metavar="N", default="30",
        help="recency window for conversations (default 30; 'all' for everything)")

    sp = sub.add_parser("cd", help="cd this shell into a dev slot's worktree",
        description="cd the calling shell into a dev slot's worktree "
            "($DEV_WORKTREE_ROOT/<repo>/<slot>). Names default to the cwd repo, so `t cd 3` "
            "jumps to this repo's slot 3. With no slot: the repo's only worktree, an fzf pick "
            "when there are several (showing each worktree's checked-out branch), or the "
            "canonical repo dir when it has none. Bare `t cd` picks across every worktree. "
            "Navigation only — it never creates a worktree (`t open` does) and never touches "
