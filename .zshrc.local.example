# ~/.zshrc.local — private, per-machine configuration.
# Dotfiles loads this through the standalone t plugin. `t setup` registers repos
# and hosts here; `t config` manages tools/models and other session settings.
# See ~/code/t/local.zsh.example for t configuration examples.
# Do not commit this file: it may contain real paths, hostnames, and preferences.

# Dotfiles-specific switches (uncomment to opt out):
# export DOTS_NO_AUTORELOAD=1
# export DOTFILES_NO_MCP=1
# export DOTFILES_NO_TRUST=1
# export DOTFILES_NO_PERMISSIONS=1
# export DOTFILES_NO_AGENT_MODES=1
# export DOTFILES_NO_SUBAGENT_MODEL=1

# Personal scripts are added to PATH when ~/code/personal-scripts exists.
# Override the directory here, or set an empty string to disable it:
# DOTFILES_SCRIPTS_DIR="$HOME/code/my-scripts"

# Machine-specific completions (compinit has already run):
# [[ -f "$HOME/.tool/completions/tool.zsh" ]] && source "$HOME/.tool/completions/tool.zsh"
