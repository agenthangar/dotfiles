#!/usr/bin/env bash
# Command entry point for both Homebrew and checkout installations.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: dots <command>

Commands:
  system update [--all]     Update and apply managed configuration
  system integrate [--relink]
                             Apply installed configuration (optionally offline)
  install                   Apply the installed Homebrew package
  update [--all|--dev|--relink]
                             Update the installed configuration

Update options:
  --all, -a                  Update here and on configured remote hosts
  --dev, -d                  Use the dotfiles worktree in this directory
  --relink                   Refresh installed links without fetching

Run dots with no arguments to set up a new account or update an existing one.
dots --all/--dev/--relink remain aliases for update.
Run dots install --help for installation details.
EOF
}

# Resolve the payload for Homebrew, checkout, and symlinked commands.
payload_root() {
    local script=${BASH_SOURCE[0]} directory root
    while [[ -L "$script" ]]; do
        directory=$(cd -P "$(dirname "$script")" && pwd)
        script=$(readlink "$script")
        [[ "$script" == /* ]] || script="$directory/$script"
    done
    root=$(cd -P "$(dirname "$script")/.." && pwd)
    printf '%s\n' "$root"
}

# Normalize the canonical namespace before selecting package/source behavior.
# Validate the complete argument list before any setup or update can mutate state.
if [[ "${1:-}" == system ]]; then
    shift
    case "${1:-}" in
        update)
            shift
            if [[ $# -gt 1 ]] || { [[ $# -eq 1 ]] && [[ "$1" != --all && "$1" != -a && "$1" != -h && "$1" != --help ]]; }; then
                echo 'Usage: dots system update [--all]' >&2; exit 2
            fi
            set -- update "$@" ;;
        integrate)
            shift
            if [[ $# -eq 0 ]]; then
                set -- install
            elif [[ $# -eq 1 && "$1" == --relink ]]; then
                set -- --relink
            elif [[ $# -eq 1 && ( "$1" == -h || "$1" == --help ) ]]; then
                echo 'Usage: dots system integrate [--relink]'; exit 0
            else
                echo 'Usage: dots system integrate [--relink]' >&2; exit 2
            fi ;;
        help|-h|--help) usage; exit 0 ;;
        *) echo 'Usage: dots system <update|integrate>' >&2; exit 2 ;;
    esac
fi

root=$(payload_root)
if [[ -f "$root/.dotfiles-package" ]]; then
    # shellcheck source=lib/package.sh
    source "$root/lib/package.sh"
    dots_package_main "$root" "$@"
    exit $?
fi

first_run=0
[[ $# -eq 0 ]] && first_run=1
case "${1:-}" in
    help|-h|--help) usage; exit 0 ;;
    install)
        shift
        exec bash "$root/scripts/dotfiles-setup" "$@"
        ;;
    update) shift ;;
    ""|--all|-a|--dev|-d|--relink) ;;
    *) printf 'dots: unknown command: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    ""|--all|-a|--dev|-d|--relink) ;;
    *) printf 'dots update: unknown option: %s\n' "$1" >&2; exit 2 ;;
esac

[[ $# -le 1 ]] || { echo "dots: unexpected argument: $2" >&2; exit 2; }

# Updates belong to the selected shell configuration, not Homebrew's snapshot.
# Check for the function explicitly so an unconfigured shell cannot recurse
# into this executable. Interactive zsh calls the function directly and reloads
# itself; other callers update through this child shell.
exec zsh -f -c '
    setup=$1
    first_run=$2
    shift 2
    [[ -r "$HOME/.zshrc" ]] && source "$HOME/.zshrc"
    if (( ! $+functions[dots] )); then
        if [[ "$first_run" == 1 ]]; then
            exec bash "$setup"
        fi
        print -u2 -- "dots: shell integration not found; run dots install first"
        exit 1
    fi
    dots "$@"
' dots "$root/scripts/dotfiles-setup" "$first_run" "$@"
