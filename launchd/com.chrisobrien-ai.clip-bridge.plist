<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The laptop end of bin/clip-bridge: a socket-activated pbcopy. launchd owns the
  listening socket on loopback and, per connection (inetd-style, Wait=false), runs
  pbcopy with the connection as its stdin. Nothing of ours runs until a copy arrives.
  The ssh RemoteForwards in ssh/config point here; keep the port in step with them.
  Installed as a real copy (never a symlink) by install.sh's install_clip_bridge.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chrisobrien-ai.clip-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/pbcopy</string>
    </array>
    <key>inetdCompatibility</key>
    <dict>
        <key>Wait</key>
        <false/>
    </dict>
    <key>Sockets</key>
    <dict>
        <key>Listener</key>
        <dict>
            <key>SockNodeName</key>
            <string>127.0.0.1</string>
            <key>SockServiceName</key>
            <string>52520</string>
        </dict>
    </dict>
</dict>
</plist>
