#!/usr/bin/env python3
# t — Claude session manager: open/list/move tmux'd Claude sessions (gh-style).
#
# Single front door for the Claude-session workflow (was the dev/tpush/tpop/tbeam/
# tread/tplan/tpaste/tfind/on family). gh-style: `t <verb> [args] [--flags]`, -h
# everywhere. This BIN owns argument parsing, help, config, the cross-host fan-out,
# rendering, and the Python-shaped verbs. Verbs that must manipulate the CALLING
# shell (cd + `claude -r` in the current terminal, the tpush sentinel handoff) are
# driven by the thin `t()` zsh shim via `t __resolve …` — a bin subprocess cannot
# cd the parent shell or exec into its TTY.
#
# Config: ~/.config/t/config.sh, derived from the live zsh arrays by _t_sync_config
# in .zshrc (DEV_REPOS / DEV_BRANCHES / REMOTE_HOSTS / DEV_BRANCH). Parsed here with
# a strict line regex — never sourced (it is shell, but ~/.zshrc.local is not, and
# we never execute either).
#
# Hybrid: the intricate, battle-tested tmux/ps introspection + transcript resolution
# (the _dev_* helpers) stay as zsh functions; this bin invokes them via `zsh -lic`
# for the data and renders in Python. Reimplementing ps-tree walking buys nothing.

import argparse
import glob
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "t", "config.sh")

# Every zsh helper we spawn is `zsh -lic` (login+interactive — required so .zshrc is
# sourced and the _dev_* functions exist). An interactive login shell exiting under
# macOS Terminal.app triggers its shell-session-save, which prints "Saving session…"
# noise to stderr on every `t ls`/`t read`/etc. Disable it for our children (inherited
# by subprocess + execvp); does not affect the user's own shell.
os.environ["SHELL_SESSIONS_DISABLE"] = "1"

# Job-control noise prelude, prepended to every zsh snippet we spawn. The fan-out
# helpers run `&` + `wait` (e.g. _dev_rows_all behind `t ls -r`). When the spawned
# `zsh -lic` inherits a controlling tty (it does from a real terminal), -i turns on
# MONITOR (job control), so it prints job notices during the run and, crucially,
# "warning: N jobs SIGHUPed" at *exit*. _dev_rows_all's own `setopt local_options
# no_monitor` cannot fix the exit warning: local_options restores MONITOR=on when the
# function returns, before the shell exits. Setting it here keeps MONITOR off for the
# whole spawned-shell lifetime — quiet during the run AND at exit — and only touches
# our throwaway capture shells, never the user's interactive shell (or the `$(…)`
# subshell callers of _dev_rows_all, which already run with job control off).
ZSH_PRELUDE = "setopt no_monitor no_notify 2>/dev/null; "

# ─── config ──────────────────────────────────────────────────────────────────

_CFG_LINE = re.compile(
    r"^(DEV_REPOS|DEV_BRANCHES|REMOTE_HOSTS|DEV_WORKTREE)\[([^\]]+)\]=(.*)$"
    r"|^(DEV_BRANCH|DEV_WORKTREE_ROOT|DEV_WORKTREE_DEFAULT)=(.*)$")


def _unquote(v):
    """Strip one layer of zsh ${(q)} quoting (backslash escapes / quotes)."""
    v = v.strip()
    if not v:
        return ""
    try:
        parts = shlex.split(v)
        return parts[0] if parts else ""
    except ValueError:
        return v


class Config:
    def __init__(self):
        self.repos = {}      # alias -> path
        self.branches = {}   # alias -> branch
        self.hosts = {}      # alias -> ssh target
        self.branch = "dev/claude-1"
        self.worktree = {}   # alias -> opt-out flag (0/no/off → shared-tree)
        self.worktree_root = os.path.join(HOME, "code", ".worktrees")
        self.worktree_default = "1"
        self._load()

    def _load(self):
        try:
            with open(CONFIG, errors="ignore") as fh:
                lines = fh.readlines()
        except OSError:
            return  # graceful: no repos configured (mirrors zsh's degradation)
        for line in lines:
            m = _CFG_LINE.match(line.rstrip("\n"))
            if not m:
                continue
            if m.group(1):
                arr, key, val = m.group(1), m.group(2), _unquote(m.group(3))
                {"DEV_REPOS": self.repos, "DEV_BRANCHES": self.branches,
                 "REMOTE_HOSTS": self.hosts, "DEV_WORKTREE": self.worktree}[arr][key] = val
            elif m.group(4) == "DEV_BRANCH":
                self.branch = _unquote(m.group(5))
            elif m.group(4) == "DEV_WORKTREE_ROOT":
                self.worktree_root = _unquote(m.group(5))
            elif m.group(4) == "DEV_WORKTREE_DEFAULT":
                self.worktree_default = _unquote(m.group(5))

    def repo_of_dir(self, cwd):
        """(alias, slot) for a path — the Python twin of zsh _dev_repo_of_dir. slot is
        the worktree's own slot ($DEV_WORKTREE_ROOT/<basename>/<slot>), else "". Alias
        choice mirrors zsh: the key equal to the basename wins, else the shortest key.
        (None, None) when no repo matches."""
        base, slot = None, ""
        root = self.worktree_root
        if root and cwd.startswith(root + "/"):
            parts = cwd[len(root) + 1:].split("/")
            if len(parts) >= 2:
                base, slot = parts[0], parts[1]
        if base is None:
            best = ""
            for path in self.repos.values():
                if cwd == path or cwd.startswith(path + "/"):
                    if len(path) > len(best):
                        best = path
            if not best:
                return (None, None)
            base = os.path.basename(best)
        matches = [k for k, v in self.repos.items() if os.path.basename(v) == base]
        if not matches:
            return (None, None)
        if base in matches:
            return (base, slot)
        return (min(matches, key=len), slot)

    def repo_dir_for_cwd(self, cwd):
        """Canonical DEV_REPOS dir for cwd (or for the worktree containing it), else ''.
        Worktree-aware via repo_of_dir."""
        alias, _ = self.repo_of_dir(cwd)
        return self.repos.get(alias, "") if alias else ""


# ─── shell-out helpers ─────────────────────────────────────────────────────────

def zsh_capture(snippet):
    """Run a zsh login+interactive snippet, return stdout (stderr passes through).

    `-lic` is the same context the remote fan-out uses: ~/bin and Homebrew tmux/fzf
    are only on the login/interactive PATH, and the _dev_* helpers are defined there.
    """
    try:
        r = subprocess.run(["zsh", "-lic", ZSH_PRELUDE + snippet], stdout=subprocess.PIPE, text=True)
        return r.stdout
    except FileNotFoundError:
        return ""


# ─── rendering ───────────────────────────────────────────────────────────────

class Style:
    def __init__(self):
        tty = sys.stdout.isatty()
        self.g = "\033[32m" if tty else ""
        self.c = "\033[36m" if tty else ""
        self.y = "\033[2m" if tty else ""
        self.b = "\033[1m" if tty else ""
        self.r = "\033[0m" if tty else ""


def _columns():
    return shutil.get_terminal_size((80, 24)).columns


def _truncate(s, avail):
    if len(s) > avail:
        return s[:avail - 1] + "…"
    return s


def _parse_rows(text, host_prefixed=False):
    """Parse _dev_session_rows / _dev_rows_all output into dicts."""
    rows = []
    for line in text.splitlines():
        if not line:
            continue
        f = line.split("\t")
        if host_prefixed:
            if len(f) < 7:
                continue
            host, sid, cwd, slot, state, context, summary = f[:7]
        else:
            if len(f) < 6:
                continue
            host = "local"
            sid, cwd, slot, state, context, summary = f[:6]
        rows.append(dict(host=host, sid=sid, cwd=cwd, slot=slot,
                         state=state, context=context, summary=summary))
    return rows


_HOME_PREFIX = re.compile(r"^/(?:Users|home)/[^/]+/")


def _homerel(p):
    """Strip the machine-local home prefix (/Users/<u>/ on macOS, /home/<u>/ on
    Linux) so remote cwds compare against local scopes on hosts whose $HOME
    differs — the cross-host key is the home-relative form (`code/dotfiles`).
    Zsh twin: _dev_homerel in .zshrc; keep them in sync."""
    return _HOME_PREFIX.sub("", p or "")


def _scope_filter(rows, scope, wt_scope=""):
    """Keep rows whose cwd is under <scope> OR under <wt_scope> (the repo's worktree
    root $DEV_WORKTREE_ROOT/<basename>, where per-session worktrees live). Paths
    are compared home-relative so remote rows from a differing-$HOME host match."""
    if not scope:
        return rows
    scope, wt_scope = _homerel(scope), _homerel(wt_scope)
    def ok(c):
        c = _homerel(c)
        if c == scope or c.startswith(scope + "/"):
            return True
        return bool(wt_scope) and c.startswith(wt_scope + "/")
    return [r for r in rows if ok(r["cwd"])]


def _header(st, scope):
    note = ""
    if scope:
        # Make the scoped repo prominent (bold cyan) — the rest of the note stays dim.
        repo = os.path.basename(scope)
        note = f"   {st.y}(repo: {st.r}{st.b}{st.c}{repo}{st.r}{st.y} — --all for all){st.r}"
    return f"dev sessions   {st.g}●{st.r} attached · {st.c}✓{st.r} active context{note}"


def cmd_ls(cfg, args):
    scope = "" if args.all else cfg.repo_dir_for_cwd(os.getcwd())
    wt_scope = os.path.join(cfg.worktree_root, os.path.basename(scope)) if scope else ""
    st = Style()
    if args.remote:
        rows = _scope_filter(_parse_rows(zsh_capture("_dev_rows_all"), host_prefixed=True), scope, wt_scope)
        if not rows:
            where = f" in {os.path.basename(scope)} (t ls -r --all for every repo)," if scope else ""
            print(f"No dev sessions running{where} on this machine or any reachable host.")
            return 0
        _render_remote(rows, scope, st)
    else:
        rows = _scope_filter(_parse_rows(zsh_capture("_dev_session_rows")), scope, wt_scope)
        if not rows:
            where = f" in {os.path.basename(scope)}" if scope else ""
            hints = ([f"t ls --all for every repo"] if scope else []) + \
                    (["t ls -r for other machines"] if cfg.hosts else [])
            tail = f"  ({' · '.join(hints)})" if hints else ""
            print(f"No dev sessions running{where}.{tail}")
            return 0
        _render_local(rows, scope, st, bool(cfg.hosts))
    return 0


def _render_local(rows, scope, st, has_remote=False):
    name_w = max([7] + [len(r["slot"]) for r in rows])
    avail = _columns() - 11 - name_w
    if avail < 12:
        avail = 80 - 11 - name_w
    print(_header(st, scope))
    print()
    print(f"  {st.y}{'STATUS':<8}{'SESSION':<{name_w}} WORKING ON{st.r}")
    has_fg = False
    for r in rows:
        amark = f"{st.g}●{st.r}" if r["state"] == "attached" else "○"
        cmark = f"{st.c}✓{st.r}" if r["context"] == "active" else " "
        summary = _truncate(r["summary"], avail)
        print(f"  {amark} {cmark}     {r['slot']:<{name_w}} {st.y}{summary}{st.r}")
        if ":" in r["slot"]:                       # colon marks a foreground row
            has_fg = True
    foot = "reattach: t open <repo> <slot>"
    if has_fg:
        foot += " · foreground: t open <id>"
    if has_remote:
        foot += " · other machines: t ls -r"
    print()
    print(f"  {st.y}{foot}{st.r}")


def _render_remote(rows, scope, st):
    host_w = max([4] + [len(r["host"]) for r in rows if r["host"] != "local"])
    name_w = max([7] + [len(r["slot"]) for r in rows])
    avail = _columns() - 12 - host_w - name_w
    if avail < 12:
        avail = 80 - 12 - host_w - name_w
    print(_header(st, scope))
    print()
    print(f"  {st.y}{'STATUS':<8}{'HOST':<{host_w}} {'SESSION':<{name_w}} WORKING ON{st.r}")
    has_fg = False
    for r in rows:
        amark = f"{st.g}●{st.r}" if r["state"] == "attached" else "○"
        cmark = f"{st.c}✓{st.r}" if r["context"] == "active" else " "
        summary = _truncate(r["summary"], avail)
        hostcell = "" if r["host"] == "local" else r["host"]
        print(f"  {amark} {cmark}     {hostcell:<{host_w}} {r['slot']:<{name_w}} {st.y}{summary}{st.r}")
        if ":" in r["slot"]:                       # colon marks a foreground row
            has_fg = True
    foot = ("attach (auto-finds its host): t open <repo> <slot> · "
            "pull here: t beam <repo> <slot> --from <host>")
    if has_fg:
        foot += " · foreground: t on <host> t open <id>"
    print()
    print(f"  {st.y}{foot}{st.r}")


# ─── machine-readable (remote contract) ────────────────────────────────────────

def cmd_session_rows(cfg, args):
    """The per-host scan behind `t ls -r`. Delegates to the proven zsh helper."""
    sys.stdout.write(zsh_capture("_dev_session_rows"))
    return 0


def cmd_land(cfg, args):
    """Resume a beamed session on this host. Reads TB_CWD/TB_SID/TB_MODE/TB_ATTACH
    from the env (set by the beam orchestrator over ssh, dodging nested-quote hell)
    and delegates to the proven zsh _tbeam_land."""
    os.execvp("zsh", ["zsh", "-lic", "_tbeam_land"])


def cmd_kill_owner(cfg, args):
    """Stop the local dev slot that owns TB_SID (the MOVE / one-live-owner step).
    Delegates to the proven zsh _tbeam_kill_owner."""
    os.execvp("zsh", ["zsh", "-lic", "_tbeam_kill_owner"])


def cmd_cursor(cfg, args):
    """Passthrough to bin/cursor-beam, the cursor-agent chat mover — cursor chats
    have no dev slot/tmux, so the whole t machinery does not apply; this verb just
    gives them the same front door. `t cursor ls` sugar maps to `cursor-beam --ls`;
    everything else forwards verbatim. Resolved as a sibling of the real bin/t
    (works from a repo checkout before install.sh links it), else from PATH."""
    rest = list(args.rest)
    if rest and rest[0] == "ls":
        rest[0] = "--ls"
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cursor-beam")
    if not os.path.isfile(exe):
        exe = "cursor-beam"
    os.execvp(exe, [exe] + rest)


# ─── subprocess-safe verbs ─────────────────────────────────────────────────────

def _set_term_title(text):
    """Set the terminal/tab title via OSC, mirroring .zshrc's _term_title. No-op when
    stdout is not a tty. Used before an execvp into ssh so the title reads `host: cmd`
    instead of the leaked ssh argv. We cannot clear it afterward (execvp replaces this
    process), but the shell's precmd refreshes the title on return."""
    if sys.stdout.isatty():
        sys.stdout.write(f"\033]0;{text}\007")
        sys.stdout.flush()


def cmd_on(cfg, args):
    if not args.rest:
        # interactive login shell on the host
        target = cfg.hosts.get(args.host, args.host)
        _set_term_title(args.host)
        os.execvp("ssh", ["ssh", "-t", target])
    host = args.host
    target = cfg.hosts.get(host, host)
    inner = " ".join(shlex.quote(a) for a in args.rest)
    _set_term_title(f"{host}: {' '.join(args.rest)}")
    os.execvp("ssh", ["ssh", "-t", target, f"zsh -lic {shlex.quote(inner)}"])


# Escape-stripping for a tmux capture-pane log of a TUI (Claude Code). The naive
# "delete \r, strip a hand-picked set of CSI letters" stripper (the old _PERL_STRIP)
# was garbage on real logs two ways: (1) deleting \r collapsed every screen REPAINT
# into one giant jammed line, and (2) its letter allowlist missed the private-mode
# CSI sequences a modern TUI emits — \x1b[>4;2m / \x1b[>1u / \x1b[<u (keyboard
# protocol) and \x1b[?25h/l (cursor show/hide) — whose `>`/`<`/`?` parameter marker
# defeated the [\d;]* match, so they leaked into less as `^Qu1u4;2m`-style junk.
# _clean_capture handles the FULL CSI grammar instead: ESC [ <params 0x30-0x3F>
# <intermediates 0x20-0x2F> <final 0x40-0x7E>. It drops every CSI EXCEPT plain SGR
# colour (final `m`, digit/semicolon params only) so `less -R` still renders colour,
# strips OSC title sets / charset selects / lone control chars, and splits on BOTH
# \r and \n so each repaint row becomes one display line. Shared by the less and the
# --dump paths so they render identically. (Residual word-jamming — "monthpriceforecast"
# — is the TUI positioning words with cursor moves we strip; reconstructing that needs a
# terminal emulator and is out of scope.)
# All stripping runs on raw BYTES, before the utf-8 decode. A tmux capture interleaves
# SO/SI charset-shift bytes (\x0e/\x0f) and escapes *inside* multibyte UTF-8 chars
# (⏵, ─, ←), so decoding first and stripping after leaves the char already mangled into
# �; stripping the control/escape bytes first makes each char's bytes contiguous so
# it decodes cleanly.
_OSC = re.compile(rb"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
_CSI = re.compile(rb"\x1b\[[0-?]*[ -/]*[@-~]")
_CHARSET = re.compile(rb"\x1b[()][0-9AB]")
_ESC2 = re.compile(rb"\x1b[=>Mc78]")
_CTRL = re.compile(rb"[\x00-\x08\x0b\x0c\x0e-\x1a\x1c-\x1f\x7f]")


def _keep_sgr(m):
    """CSI replacement: keep plain SGR colour (\\x1b[…m, digit/semicolon params), drop
    everything else (cursor moves, clears, private-mode toggles)."""
    s = m.group(0)
    if s[-1:] == b"m" and all(c in b"0123456789;" for c in s[2:-1]):
        return s
    return b""


def _clean_capture(logfile):
    """Read a capture-pane log, strip non-colour escapes, return one display line per
    repaint row (split on \\r and \\n)."""
    b = open(logfile, "rb").read()
    b = _OSC.sub(b"", b)
    b = _CSI.sub(_keep_sgr, b)
    b = _CHARSET.sub(b"", b)
    b = _ESC2.sub(b"", b)
    # Drop the leftover C0 control chars (BEL, the SO/SI charset shifts \x0e/\x0f that
    # show as ^N/^O, etc.) — but keep \t, \n, \r (the split feeds on \r/\n) and \x1b
    # (the surviving SGR colour sequences start with it).
    b = _CTRL.sub(b"", b)
    return re.split(r"[\r\n]+", b.decode("utf-8", "replace"))


def _infer_repo(cfg, slot=None):
    """Repo alias implied by cwd — the bin-side twin of zsh's _t_infer_repo (t read
    is bin-native so it can't call the zsh helper). Evidence is the log files
    (t read targets logs, which outlive sessions): an existing dev-<alias>-<slot>.log
    wins, then any dev-<alias>-*.log — newest mtime first either way, so when several
    aliases key one dir (dot-* and dotfiles-* both at ~/code/dotfiles) the alias
    actually in use beats a stale one. No logs → the DEV_REPOS key for the dir
    (basename match preferred, then shortest)."""
    d = cfg.repo_dir_for_cwd(os.getcwd())
    if not d:
        return None
    aliases = [k for k, v in cfg.repos.items() if v == d]
    if not aliases:
        return None
    logdir = os.path.join(HOME, ".tmux-logs")

    def newest(patterns):
        cands = []
        for k in aliases:
            for pat in patterns(k):
                if os.path.isfile(pat):
                    cands.append((os.path.getmtime(pat), k))
        return max(cands)[1] if cands else None

    if slot:
        hit = newest(lambda k: [os.path.join(logdir, f"dev-{k}-{slot}.log")])
        if hit:
            return hit
    hit = newest(lambda k: glob.glob(os.path.join(logdir, f"dev-{k}-[0-9]*.log")))
    if hit:
        return hit
    base = os.path.basename(d)
    if base in aliases:
        return base
    return min(aliases, key=len)


def cmd_read(cfg, args):
    bare = args.repo is None and args.slot is None
    repo, slot = args.repo, args.slot
    # Repo-aware: `t read 4` ≡ slot 4 of the repo cwd is in; bare `t read` is its
    # first slot's log.
    if repo is not None and repo.isdigit() and not slot:
        repo, slot = None, repo
    # Inside a slot's worktree with no slot given → default to that worktree's slot
    # (so bare `t read` in ~/code/.worktrees/<repo>/3 reads slot 3, not slot 1).
    if not slot:
        _wa, _ws = cfg.repo_of_dir(os.getcwd())
        if _ws:
            slot = _ws
    if not repo:
        repo = _infer_repo(cfg, slot or "1")
    if not repo or repo not in cfg.repos:
        _read_usage(cfg)
        return 1
    args.repo = repo
    slot = slot or "1"
    # --tail implies --dump (a tailed pager makes no sense on mobile).
    dump = args.dump or args.tail is not None
    logfile = os.path.join(HOME, ".tmux-logs", f"dev-{args.repo}-{slot}.log")
    if not os.path.isfile(logfile):
        # Same-dir sibling aliases (mirrors _dev_kill / _t_pop): `dot` and
        # `dotfiles` both key ~/code/dotfiles, so `t read dotfiles 2` should
        # also reach `dev-dot-2.log` here before delegating to a remote host.
        # _infer_repo already does this when the repo arg is omitted; this
        # handles an explicitly-named repo too.
        d = cfg.repos.get(args.repo, "")
        if d:
            for k, v in cfg.repos.items():
                if k == args.repo or v != d:
                    continue
                sib = os.path.join(HOME, ".tmux-logs", f"dev-{k}-{slot}.log")
                if os.path.isfile(sib):
                    args.repo, logfile = k, sib
                    break
    if not os.path.isfile(logfile):
        # No log here — the slot may live on a remote host (the tmux log is host-local;
        # csync syncs transcripts, not ~/.tmux-logs). Try delegating the read to that
        # host over ssh -t, which renders the remote log in less through the ssh TTY.
        # On a fully bare `t read` (no repo, no slot), probe for ANY of the inferred
        # repo's remote slots (empty slot → _dev_remote_resolve picks / fzf-picks) so a
        # remote slot other than 1 is still found. With a repo or slot explicitly named,
        # pass the resolved slot so remote mirrors the local default of slot 1.
        # --dump/--tail forward so the mobile-friendly stdout dump renders on the host.
        # rc 0 = handled (or a no-TTY hint printed); rc 1 = live nowhere → local error.
        extra = []
        if args.tail is not None:
            extra += ["--tail", str(args.tail)]
        elif dump:
            extra.append("--dump")
        if _try_remote_delegate(args.repo, "" if bare else slot, "read", extra) == 0:
            return 0
        print(f"No log found: {logfile}")
        print(f"(start a session with 't open {args.repo} {slot}' first)")
        return 1
    lines = _clean_capture(logfile)
    if dump:
        # Print straight to stdout (no pager) so a mobile terminal's native touch-scroll
        # can scroll it — `less` repaints one viewport and needs arrow/PageUp keys that
        # are unusable on a phone. --tail N keeps only the last N lines (bare --dump
        # prints all). SGR colour stays so the dump is still readable; the rest is
        # stripped by _clean_capture.
        if args.tail is not None:
            lines = lines[-args.tail:]
        sys.stdout.write("\n".join(lines) + "\n")
        return 0
    # Feed the same cleaned, repaint-split text to less -R (colour rendered, +G = tail).
    less = subprocess.Popen(["less", "-R", "+G"], stdin=subprocess.PIPE)
    less.communicate(("\n".join(lines) + "\n").encode("utf-8", "replace"))
    return 0


def _delegate(snippet):
    """exec the existing zsh implementation (login+interactive). For subprocess-safe
    verbs whose battle-tested logic stays in zsh during the hybrid migration; these
    end in a pager / tmux send-keys / tmux kill, all child-safe. (At hard cutover the
    target functions are renamed to internal _t_* helpers and these snippets follow.)"""
    os.execvp("zsh", ["zsh", "-lic", ZSH_PRELUDE + snippet])


def _try_remote_delegate(repo, slot, verb, extra=None):
    """Run zsh `_dev_remote_delegate <repo> <slot> <verb> [extra…]` (login+interactive)
    so a slot that is live on a $REMOTE_HOSTS host is handled THERE over ssh -t — the
    same shared helper `t plan`/`t pop` use. Unlike _delegate() this does NOT exec: it
    runs as a child (inheriting the TTY so the remote pager/attach works) and RETURNS the
    rc, so a bin-native verb can fall back to its local path. `extra` forwards verb flags
    (e.g. read's --dump/--tail) to the far-side `t <verb>`. rc 0 = handled (or a no-TTY
    hint was printed); rc 1 = no remote slot. Returns 1 if zsh is unavailable."""
    toks = ["_dev_remote_delegate", shlex.quote(repo), shlex.quote(slot), shlex.quote(verb)]
    toks += [shlex.quote(a) for a in (extra or [])]
    snippet = " ".join(toks)
    try:
        return subprocess.run(["zsh", "-lic", ZSH_PRELUDE + snippet]).returncode
    except OSError:
        return 1


def cmd_plan(cfg, args):
    parts = ["_t_plan"]
    if args.all:
        parts.append("--all")
    if args.repo:
        parts.append(shlex.quote(args.repo))
    if args.slot:
        parts.append(shlex.quote(args.slot))
    _delegate(" ".join(parts))


def cmd_paste(cfg, args):
    parts = ["_t_paste"]
    if args.pick:
        parts.append("--pick")
    if args.newest:
        parts.append("--newest")
    if args.repo:
        parts.append(shlex.quote(args.repo))
    if args.slot:
        parts.append(shlex.quote(args.slot))
    _delegate(" ".join(parts))


def cmd_kill(cfg, args):
    # remote kill = `_t_dev -r kill <repo> [slot]`; local = `_t_dev kill <repo> <slot|all>`
    parts = ["_t_dev", "-r", "kill"] if args.remote else ["_t_dev", "kill"]
    if args.repo:
        parts.append(shlex.quote(args.repo))
    if args.slot:
        parts.append(shlex.quote(args.slot))
    if args.yes:
        parts.append("-y")
    _delegate(" ".join(parts))


def _read_usage(cfg):
    repos = "|".join(cfg.repos) or "repo"
    print(f"t read — open a dev slot's tmux log in less\n")
    print(f"Usage: t read [{repos}] [slot] [-d|-n N]   (no repo: the one cwd is in)")
    print(f"       -d/--dump prints to stdout for mobile touch-scroll; -n N tails N lines\n")
    print("Logs:")
    logdir = os.path.join(HOME, ".tmux-logs")
    logs = sorted(f for f in os.listdir(logdir)) if os.path.isdir(logdir) else []
    logs = [f for f in logs if f.endswith(".log")]
    if logs:
        for f in logs:
            print(f"  {f[:-4]}  {os.path.join(logdir, f)}")
    else:
        print("  (none yet — start one with 't open <repo> <slot>')")


# ─── setup — onboard repos + hosts into ~/.zshrc.local ─────────────────────────
# `t setup [dir …]` scans for git checkouts (default ~/code) and ~/.ssh/config
# hosts, and appends the picks as DEV_REPOS/REMOTE_HOSTS lines to ~/.zshrc.local.
# The local file is parsed with line regexes and NEVER sourced (same stance as the
# config bridge header above); dedup unions the parsed live lines with the possibly
# stale config cache — over-skipping is the safe direction for an appender. All
# picks are staged in memory and land in ONE dated block at the end, so Ctrl-C
# mid-flow writes nothing. Idempotent by dedup, not by marker: re-runs offer only
# what is not yet registered.

ZSHRC_LOCAL = os.path.join(HOME, ".zshrc.local")
SSH_CONFIG = os.path.join(HOME, ".ssh", "config")

_LOCAL_LINE = re.compile(r"^\s*(DEV_REPOS|REMOTE_HOSTS)\[([^\]]+)\]=(.*)$")
_TBEAM_LINE = re.compile(r"^\s*export\s+TBEAM_HOST=")
_BARE_HOST = re.compile(r"^[A-Za-z0-9@._:-]+$")
_SETUP_KEY = re.compile(r"^[^\s\]=-][^\s\]=]*$")   # no whitespace/]/=; no leading -


def _local_entries(text):
    """Parse LIVE (uncommented) DEV_REPOS/REMOTE_HOSTS assignments and a TBEAM_HOST
    export out of ~/.zshrc.local text. Returns (repos, hosts, tbeam_set) with raw
    (still-quoted) values."""
    repos, hosts, tbeam = {}, {}, False
    for line in text.splitlines():
        if _TBEAM_LINE.match(line):
            tbeam = True
            continue
        m = _LOCAL_LINE.match(line)
        if m:
            (repos if m.group(1) == "DEV_REPOS" else hosts)[m.group(2)] = m.group(3).strip()
    return repos, hosts, tbeam


def _expand_home(rawval):
    """Comparable absolute path for a raw ~/.zshrc.local value: strip one quoting
    layer, then expand $HOME/${HOME}/~ (the forms the example file uses)."""
    v = _unquote(rawval).replace("${HOME}", HOME).replace("$HOME", HOME)
    return os.path.expanduser(v)


def _scan_repos(dirs, skip_paths, max_depth=3):
    """Git checkouts under dirs: a dir containing .git (dir OR file — worktrees and
    submodules have a file) counts and is not descended into. Skips hidden dirs and
    anything whose realpath is in skip_paths (registered repos, the worktree root).
    Deduped by realpath (symlinked duplicates), sorted."""
    skip = {os.path.realpath(p) for p in skip_paths}
    found, seen = [], set()
    for top in dirs:
        for dirpath, dirnames, _ in os.walk(top):
            real = os.path.realpath(dirpath)
            if real in skip:
                dirnames[:] = []
                continue
            if os.path.exists(os.path.join(dirpath, ".git")):
                dirnames[:] = []
                if real not in seen:
                    seen.add(real)
                    found.append(dirpath)
                continue
            rel = os.path.relpath(dirpath, top)
            depth = 0 if rel == "." else rel.count(os.sep) + 1
            if depth >= max_depth:
                dirnames[:] = []
                continue
            dirnames[:] = sorted(d for d in dirnames if not d.startswith("."))
    return sorted(found)


def _propose_aliases(paths, taken):
    """{path: alias} proposals + the set of paths whose alias needed disambiguating
    (those get an interactive override prompt). Policy: basename; a collision with
    a taken key or an earlier path qualifies with the parent dir (~/work/api →
    work-api); still taken → numeric suffix on the QUALIFIED alias (work-api-2),
    so the parent context survives."""
    proposals, collided = {}, set()
    used = set(taken)
    for p in paths:
        base = os.path.basename(p.rstrip(os.sep))
        alias = base
        if alias in used:
            alias = f"{os.path.basename(os.path.dirname(p))}-{base}"
            collided.add(p)
        qualified, n = alias, 2
        while alias in used:
            alias = f"{qualified}-{n}"
            n += 1
            collided.add(p)
        proposals[p] = alias
        used.add(alias)
    return proposals, collided


def _propose_aliases_hosts(names, taken):
    """{alias: target} for ssh-config Host names: alias = first dot-label
    (studio.local → studio), the full name when that label is taken, skipped
    entirely when both are. Returns (proposals, skipped-names)."""
    out, skipped = {}, []
    used = set(taken)
    for n in names:
        alias = n.split(".")[0]
        if alias in used or alias in out:
            alias = n
        if alias in used or alias in out or not _SETUP_KEY.match(alias):
            skipped.append(n)
            continue
        out[alias] = n
        used.add(alias)
    return out, skipped


def _homeify(path):
    """Render a repo path for ~/.zshrc.local: "$HOME/rel" under home (portable
    across machines with differing usernames), else the quoted absolute path."""
    if path == HOME or path.startswith(HOME + os.sep):
        return f'"$HOME/{os.path.relpath(path, HOME)}"'
    return f'"{path}"'


def _hostval(target):
    """Host values are written bare when shell-safe (matches the example file),
    quoted otherwise."""
    return target if _BARE_HOST.match(target) else f'"{target}"'


def _setup_block(repos, hosts, tbeam, date):
    """The exact text appended to ~/.zshrc.local: a dated provenance marker + one
    assignment per pick (sorted for determinism). `date` is injected so the block
    is testable byte-for-byte."""
    lines = [f"# ── added by `t setup` ({date}) ──"]
    lines += [f"DEV_REPOS[{k}]={_homeify(repos[k])}" for k in sorted(repos)]
    lines += [f"REMOTE_HOSTS[{k}]={_hostval(hosts[k])}" for k in sorted(hosts)]
    if tbeam:
        lines.append(f"export TBEAM_HOST={_hostval(tbeam)}")
    return "\n".join(lines) + "\n"


def _parse_ssh_hosts(path, seen=None):
    """Ordered, deduped Host names from an ssh config: keywords case-insensitive,
    multi-pattern Host lines split, wildcard (*/?) and negated (!) patterns skipped
    (drops the stock `Host *`), Include followed (expanduser, ~/.ssh-relative,
    glob-expanded, cycle-safe via `seen`). Missing file → []."""
    seen = set() if seen is None else seen
    real = os.path.realpath(path)
    if real in seen:
        return []
    seen.add(real)
    try:
        with open(path, errors="ignore") as fh:
            lines = fh.readlines()
    except OSError:
        return []
    hosts = []
    for line in lines:
        parts = line.strip().split(None, 1)
        if len(parts) < 2 or parts[0].startswith("#"):
            continue
        key, rest = parts[0].lower(), parts[1]
        if key == "include":
            try:
                pats = shlex.split(rest)
            except ValueError:
                pats = rest.split()
            for pat in pats:
                pat = os.path.expanduser(pat)
                if not os.path.isabs(pat):
                    pat = os.path.join(HOME, ".ssh", pat)
                for inc in sorted(glob.glob(pat)):
                    hosts.extend(_parse_ssh_hosts(inc, seen))
        elif key == "host":
            hosts.extend(n for n in rest.split()
                         if "*" not in n and "?" not in n and not n.startswith("!"))
    out = []
    for h in hosts:
        if h not in out:
            out.append(h)
    return out


def _comment_stale(text, keys):
    """Comment out exactly the named live DEV_REPOS[key]= lines (prefix marks
    provenance, so the edit is recognizable and reversible); every other line
    byte-identical."""
    out = []
    for line in text.splitlines(keepends=True):
        m = _LOCAL_LINE.match(line)
        if m and m.group(1) == "DEV_REPOS" and m.group(2) in keys:
            out.append("# (stale — t setup) " + line)
        else:
            out.append(line)
    return "".join(out)


def _append_local(path, block):
    """Append block to ~/.zshrc.local with a separating blank line, normalizing a
    missing trailing newline first. An absent file (install.sh normally seeds it)
    is created with a short header rather than failing."""
    try:
        with open(path, errors="ignore") as fh:
            text = fh.read()
    except OSError:
        text = ("# ~/.zshrc.local — per-machine config, sourced by ~/.zshrc if it exists.\n"
                "# Created by `t setup` (install.sh normally seeds it from .zshrc.local.example).\n")
    if text and not text.endswith("\n"):
        text += "\n"
    with open(path, "w") as fh:
        fh.write(text + "\n" + block)


def _tilde(p):
    """~-abbreviate a path under $HOME for display."""
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


def _setup_items(repo_cands, reg_repos, host_cands, reg_hosts, tbeam_default, stale, roots_label):
    """Build the checklist item model the setup UI renders — pure and testable.
    repo_cands: [(path, alias)]; host_cands: [(alias, target)]; reg_*: registered
    entries, shown locked with a ✓ so "why isn't X offered?" answers itself;
    tbeam_default: proposed TBEAM_HOST target or None; stale: registered aliases
    whose path is gone. Item types: header / spacer / note / locked / toggle
    (kind repo|host|stale|tbeam)."""
    items = [{"t": "header", "sec": "repos", "label": f"REPOS · {roots_label}"}]
    for path, alias in repo_cands:
        items.append({"t": "toggle", "sec": "repos", "kind": "repo",
                      "alias": alias, "value": path, "checked": False})
    if not repo_cands:
        items.append({"t": "note", "sec": "repos", "label": "no new checkouts found"})
    for k in sorted(reg_repos):
        items.append({"t": "locked", "sec": "repos", "alias": k, "value": reg_repos[k]})
    items += [{"t": "spacer", "sec": "hosts"},
              {"t": "header", "sec": "hosts", "label": "HOSTS · ~/.ssh/config"}]
    for alias, target in host_cands:
        items.append({"t": "toggle", "sec": "hosts", "kind": "host",
                      "alias": alias, "value": target, "checked": False})
    # manual add is a ROW, not a keybind: the hosts step always has something to
    # select, and the affordance is visible instead of hidden in a hint bar
    items.append({"t": "toggle", "sec": "hosts", "kind": "addhost",
                  "alias": "+ add a host manually", "value": "", "checked": False})
    for k in sorted(reg_hosts):
        items.append({"t": "locked", "sec": "hosts", "alias": k, "value": reg_hosts[k]})
    if stale or tbeam_default:
        items += [{"t": "spacer", "sec": "options"},
                  {"t": "header", "sec": "options", "label": "OPTIONS"}]
    if stale:
        items.append({"t": "toggle", "sec": "options", "kind": "stale",
                      "alias": "comment out stale entries",
                      "value": ", ".join(stale), "checked": False})
    if tbeam_default:
        items.append({"t": "toggle", "sec": "options", "kind": "tbeam",
                      "alias": "set TBEAM_HOST", "value": tbeam_default, "checked": False})
    return items


def _selectable(items):
    """Indices of the toggleable rows, in screen order."""
    return [i for i, it in enumerate(items) if it["t"] == "toggle"]


def _setup_result(items):
    """(repos, hosts, tbeam, stale_confirmed) from the checked toggles."""
    repos, hosts, tbeam, stale = {}, {}, None, False
    for it in items:
        if it["t"] != "toggle" or not it["checked"]:
            continue
        if it["kind"] == "repo":
            repos[it["alias"]] = it["value"]
        elif it["kind"] == "host":
            hosts[it["alias"]] = it["value"]
        elif it["kind"] == "tbeam":
            tbeam = it["value"]
        elif it["kind"] == "stale":
            stale = True
    return repos, hosts, tbeam, stale


def _host_insert_at(items):
    """Where a manually-added host row belongs: right above the '+ add a host'
    action row (else after the last host toggle / the HOSTS header) — always
    before the section's locked rows."""
    at = None
    for i, it in enumerate(items):
        if it["sec"] != "hosts":
            continue
        if it.get("kind") == "addhost":
            return i
        if it["t"] in ("header", "toggle"):
            at = i
    return (at + 1) if at is not None else len(items)


def _prompt(msg, default=""):
    """input() wrapper: strip, empty → default, EOF → None (caller aborts cleanly)."""
    try:
        r = input(msg).strip()
    except EOFError:
        print()
        return None
    return r if r else default


def _confirm(msg):
    """[y/N] confirm — EOF, blank, and anything but y/yes are all No."""
    r = _prompt(f"{msg} [y/N] ")
    return bool(r) and r.lower() in ("y", "yes")


def _parse_host_entry(ent, used):
    """Parse a manual 'alias=target' / 'user@host' entry against the aliases
    already in use. Returns (alias, target) or (None, error-message)."""
    alias, _sep, target = ent.partition("=")
    alias, target = alias.strip(), target.strip()
    if not target:  # bare target → alias = first dot-label of the host part
        target = alias
        alias = target.split("@")[-1].split(".")[0]
    if not _SETUP_KEY.match(alias) or alias in used:
        return None, f"'{alias}' is taken or not a valid key"
    return alias, target


def _pick_inline(title, rows, multi=False):
    """A one-list inline picker in the `t setup` style — stdlib only, drawn on a rail
    and redrawn in place, so it never takes over the screen and the whole transaction
    stays in normal scrollback.

    Deliberately NOT fzf and not curses, the same call t setup documents: fzf is not on
    every host, and both take the screen. It also replaced a `zsh -lic` session scan
    that cost 5s and suspended the shell with SIGTTOU — an interactive shell fights the
    foreground process for the terminal.

    rows: [(value, label)]. Returns a list of values when multi, one value otherwise,
    or None when it cannot run (no tty, raw mode unavailable) or the user cancels."""
    import select
    import termios
    import tty

    if not rows or not sys.stdin.isatty() or not sys.stdout.isatty():
        return None
    st, out, fd = Style(), sys.stdout, sys.stdin.fileno()
    try:
        old_attrs = termios.tcgetattr(fd)
    except termios.error:
        return None
    height = max(5, shutil.get_terminal_size((80, 24)).lines - 6)
    cur, marked, painted = 0, set(), [0]

    def read_key():
        ch = os.read(fd, 1).decode(errors="replace")
        if ch == "\x1b":
            r, _, _ = select.select([fd], [], [], 0.05)
            if r:
                seq = os.read(fd, 2).decode(errors="replace")
                return {"[A": "up", "OA": "up", "[B": "down", "OB": "down"}.get(seq, "esc")
            return "esc"
        return {"\r": "enter", "\n": "enter", " ": "space",
                "\x03": "abort", "\x04": "abort", "": "abort"}.get(ch, ch)

    def paint():
        lo = max(0, min(cur - height // 2, len(rows) - height)) if len(rows) > height else 0
        hi = min(len(rows), lo + height)
        lines = ["%s┌%s %s" % (st.y, st.r, title)]
        if lo:
            lines.append("%s│%s   … %d above" % (st.y, st.r, lo))
        for n in range(lo, hi):
            sel = "›" if n == cur else " "
            box = ("✓ " if n in marked else "  ") if multi else ""
            body = _truncate(rows[n][1], max(20, shutil.get_terminal_size((80, 24)).columns - 8))
            paint_on = st.c if n == cur else ""
            lines.append("%s│%s %s%s%s%s%s" % (st.y, st.r, paint_on, sel, box, body, st.r))
        if hi < len(rows):
            lines.append("%s│%s   … %d more" % (st.y, st.r, len(rows) - hi))
        keys = "↑↓ move · space mark · enter pick · q cancel" if multi \
            else "↑↓ move · enter pick · q cancel"
        lines.append("%s└%s %s%s%s" % (st.y, st.r, st.y, keys, st.r))
        if painted[0]:
            out.write("\x1b[%dA\r\x1b[J" % painted[0])
        out.write("\n".join(lines) + "\n")
        out.flush()
        painted[0] = len(lines)

    try:
        tty.setcbreak(fd)
        out.write("\x1b[?25l")
        while True:
            paint()
            k = read_key()
            if k in ("up", "k"):
                cur = (cur - 1) % len(rows)
            elif k in ("down", "j"):
                cur = (cur + 1) % len(rows)
            elif k == "space" and multi:
                marked.symmetric_difference_update({cur})
                cur = min(cur + 1, len(rows) - 1)
            elif k == "enter":
                picked = sorted(marked) if multi and marked else [cur]
                return [rows[i][0] for i in picked] if multi else rows[cur][0]
            elif k in ("abort", "esc", "q"):
                return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        out.write("\x1b[?25h")
        if painted[0]:
            out.write("\x1b[%dA\r\x1b[J" % painted[0])
        out.flush()


def _setup_wizard(items, taken):
    """The t setup UI: a clack-style inline TWO-SCREEN flow. Screen one is the
    whole selection — repos, hosts (with the '+ add a host' action row), and
    options on a single list under one cursor; screen two is a diff-style review
    of the exact ~/.zshrc.local changes: y applies, n/esc goes back to the
    selection, q/ctrl-c aborts with nothing written. Rendered inline on a
    vertical rail (redrawn in place via ANSI cursor-up, windowed when taller
    than the terminal) so the whole transcript stays in scrollback. stdlib only
    — termios/tty raw keys, readline prefill for the rename input. Returns True
    on apply (items mutated in place), False on abort; raises when raw mode is
    unavailable → _setup_prompt_flow."""
    import select
    import termios
    import tty

    st = Style()
    out = sys.stdout
    rail = f"{st.y}│{st.r}"
    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)
    width = max(40, shutil.get_terminal_size((100, 24)).columns)

    def read_key():
        ch = os.read(fd, 1).decode(errors="replace")
        if ch == "\x1b":
            r, _, _ = select.select([fd], [], [], 0.05)
            if r:
                seq = os.read(fd, 2).decode(errors="replace")
                return {"[A": "up", "OA": "up", "[B": "down", "OB": "down"}.get(seq, "esc")
            return "esc"
        return {"\r": "enter", "\n": "enter", " ": "space", "\x03": "abort",
                "\x04": "abort", "": "abort"}.get(ch, ch)

    def cooked_input(prompt, default="", prefill=None):
        # Temporarily restore the line discipline so input() gives real editing.
        # `prefill` puts the suggestion IN the input line, editable in place —
        # the clearest "you can change this" signal there is (readline startup
        # hook; on the rare build without readline it degrades to a [suggestion]
        # prompt). Prompts here stay ANSI-free: once readline is loaded it does
        # the cursor math for every input(), and escape codes break it.
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        out.write("\x1b[?25h")
        out.flush()
        hooked = False
        if prefill:
            try:
                import readline
                readline.set_startup_hook(lambda: readline.insert_text(prefill))
                hooked = True
            except ImportError:
                prompt = f"{prompt}[{prefill}] "
        try:
            s = input(prompt).strip()
        except EOFError:
            s = ""
        finally:
            if hooked:
                import readline
                readline.set_startup_hook()
            tty.setcbreak(fd)
            out.write("\x1b[?25l")
            out.flush()
        out.write("\x1b[1A\r\x1b[J")   # reclaim the input line for the repaint
        return s or default

    def used_aliases(skip=None):
        return taken | {it["alias"] for it in items
                        if it is not skip and it["t"] in ("toggle", "locked")}

    painted = [0]

    def repaint(lines):
        if painted[0]:
            out.write(f"\x1b[{painted[0]}A\r\x1b[J")
        out.write("\n".join(lines) + "\n")
        painted[0] = len(lines)
        out.flush()

    def row_text(it, aw, cur):
        if it.get("kind") == "addhost":
            pre = f"{st.c}▸{st.r}" if cur else " "
            text = it["alias"].lstrip("+ ") + "…"
            body = f"{st.b}{text}{st.r}" if cur else text
            tail = f"  {st.c}· space to add{st.r}" if cur else ""
            return f"{rail}  {pre}{st.c}+{st.r} {body}{tail}"
        # host/tbeam values are ssh targets (never home paths); everything else
        # is a filesystem path worth ~-abbreviating (locked rows have no kind)
        val = it["value"] if it.get("kind") in ("host", "tbeam") else _tilde(str(it["value"]))
        val = _truncate(str(val), max(8, width - aw - 12))
        if it["t"] == "locked":
            return f"{rail}   {st.g}✓{st.r} {st.y}{it['alias']:<{aw}}  {val} · registered{st.r}"
        mark = f"{st.c}◼{st.r}" if it["checked"] else "◻"
        pre = f"{st.c}▸{st.r}" if cur else " "
        alias = (f"{st.b}{it['alias']:<{aw}}{st.r}" if cur else f"{it['alias']:<{aw}}")
        # the cursor row advertises the rename key right where the eye is
        tail = f"  {st.c}· e rename{st.r}" if cur and it.get("kind") in ("repo", "host") else ""
        return f"{rail}  {pre}{mark} {alias}  {st.y}{val}{st.r}{tail}"

    HINTS = "space select · e rename · enter review · q quit"

    def select_screen(msg=""):
        # ONE list: every section under a single cursor; enter goes to review
        pos = 0
        while True:
            sel = _selectable(items)
            pos = max(0, min(pos, len(sel) - 1))
            cur = sel[pos]
            aw = max([len(items[i]["alias"]) for i in sel
                      if items[i].get("kind") != "addhost"] +
                     [len(x["alias"]) for x in items if x["t"] == "locked"] + [1])
            disp = [(f"{st.c}◆{st.r}  {st.b}pick what to add{st.r}  "
                     f"{st.y}{msg or HINTS}{st.r}", None)]
            for idx, it in enumerate(items):
                if it["t"] == "spacer":
                    disp.append((rail, None))
                elif it["t"] == "header":
                    disp.append((f"{rail}  {st.b}{it['label']}{st.r}", None))
                elif it["t"] == "note":
                    disp.append((f"{rail}   {st.y}{it['label']}{st.r}", None))
                else:
                    disp.append((row_text(it, aw, idx == cur), idx))
            # window the list when taller than the terminal, cursor kept visible
            body = max(6, shutil.get_terminal_size((100, 24)).lines - 3)
            if len(disp) > body:
                cur_line = next((n for n, d in enumerate(disp) if d[1] == cur), 1)
                lo = max(1, min(cur_line - body // 2, len(disp) - (body - 1)))
                lines = [disp[0][0]] + [d[0] for d in disp[lo:lo + body - 1]]
                if lo > 1:
                    lines[1] = f"{rail}  {st.y}… {lo - 1} more above{st.r}"
                if lo + body - 1 < len(disp):
                    lines[-1] = f"{rail}  {st.y}… {len(disp) - (lo + body - 1)} more below{st.r}"
            else:
                lines = [d[0] for d in disp]
            repaint(lines)
            msg = ""
            k = read_key()
            it = items[cur] if sel else None
            if k in ("q", "esc", "abort"):
                return False
            elif k == "enter":
                return True
            elif it and k in ("up", "k"):
                pos -= 1
            elif it and k in ("down", "j"):
                pos += 1
            elif (k == "a") or (it and it.get("kind") == "addhost"
                                and k in ("space", "e")):
                ent = cooked_input("│  add host (alias=target or user@host): ")
                if not ent:
                    continue
                alias, target = _parse_host_entry(ent, used_aliases())
                if alias is None:
                    msg = f"⚠ {target}"
                    continue
                at = _host_insert_at(items)
                items.insert(at, {"t": "toggle", "sec": "hosts", "kind": "host",
                                  "alias": alias, "value": target, "checked": True})
                pos = _selectable(items).index(at)
            elif it and k == "space":
                it["checked"] = not it["checked"]
                pos += 1
            elif it and k == "e" and it["kind"] in ("repo", "host"):
                a = cooked_input(f"│  name for {_tilde(str(it['value']))} → ",
                                 it["alias"], prefill=it["alias"])
                if a != it["alias"]:
                    if _SETUP_KEY.match(a) and a not in used_aliases(skip=it):
                        it["alias"] = a
                        it["checked"] = True   # renaming it means you want it
                    else:
                        msg = f"⚠ '{a}' is taken or not a valid key"
            elif it and k == "e" and it["kind"] == "tbeam":
                it["value"] = cooked_input("│  TBEAM_HOST target → ", it["value"],
                                           prefill=it["value"])
            else:
                # a key that does nothing must SAY so — a silent no-op reads as broken
                msg = f"⚠ no binding for that key — {HINTS}"

    def review_screen():
        # diff-style: exactly what lands in ~/.zshrc.local, one keypress decides
        repos, hosts, tbeam, stale_ok = _setup_result(items)
        if not (repos or hosts or tbeam or stale_ok):
            return "empty"
        lines = [f"{st.c}◆{st.r}  {st.b}review — changes to ~/.zshrc.local{st.r}  "
                 f"{st.y}y apply · n back · q quit{st.r}"]
        for ln in _setup_block(repos, hosts, tbeam, time.strftime("%Y-%m-%d")).splitlines():
            shown = f"{st.y}{ln}{st.r}" if ln.startswith("#") else ln
            lines.append(f"{rail}  {st.g}+{st.r} {shown}")
        if stale_ok:
            sv = next(x["value"] for x in items if x.get("kind") == "stale")
            lines.append(f"{rail}  {st.y}~ comment out stale entries: {sv}{st.r}")
        repaint(lines)
        while True:
            k = read_key()
            if k == "y":
                lines[0] = f"{st.g}◇{st.r}  {st.b}applied to ~/.zshrc.local{st.r}"
                repaint(lines)
                painted[0] = 0
                return True
            if k in ("n", "esc"):
                return False
            if k in ("q", "abort"):
                return None

    out.write(f"{st.y}┌{st.r}  {st.b}t setup{st.r} {st.y}· ~/.zshrc.local — nothing "
              f"is written until you confirm{st.r}\n{rail}\n")
    tty.setcbreak(fd)
    out.write("\x1b[?25l")
    ok, msg = False, ""
    try:
        while True:
            if not select_screen(msg):
                break
            r = review_screen()
            if r == "empty":
                msg = "nothing selected — space marks ◼ what gets added"
                continue
            if r:
                ok = True
                break
            if r is None:
                break
            msg = ""   # n: back to the selection, keep editing
    except KeyboardInterrupt:
        ok = False
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        out.write("\x1b[?25h")
        out.flush()
    end = "" if ok else f" {st.y}· aborted — nothing written{st.r}"
    out.write(f"{st.y}└{st.r}{end}\n")
    return ok


def _setup_prompt_flow(items, taken):
    """Plain-prompt fallback when curses cannot initialize (TERM=dumb, hostile
    terminals): same item model, one y/N per candidate, a manual host loop, then
    the same review gate. Returns True when the review confirm passed."""
    st = Style()
    for it in items:
        if it["t"] == "header":
            print(f"\n{st.b}{it['label']}{st.r}")
        elif it["t"] == "note":
            print(f"  {st.y}{it['label'].replace(' — press a to add one', '')}{st.r}")
        elif it["t"] == "locked":
            print(f"  {st.y}✓ {it['alias']} — already registered{st.r}")
        elif it["t"] == "toggle":
            if it["kind"] == "addhost":
                continue   # the fallback has its own manual-add loop below
            if it["kind"] in ("repo", "host"):
                q = {"repo": f"add repo {it['alias']} ({_tilde(it['value'])})",
                     "host": f"add host {it['alias']} → {it['value']}"}[it["kind"]]
                while True:   # any answer that is not y/n = yes, under that alias
                    r = _prompt(f"  {q}? [y/N/other alias] ")
                    if r is None or r.lower() in ("", "n", "no"):
                        break
                    if r.lower() in ("y", "yes"):
                        it["checked"] = True
                        break
                    used = taken | {x["alias"] for x in items
                                    if x is not it and x["t"] in ("toggle", "locked")}
                    if _SETUP_KEY.match(r) and r not in used:
                        it["alias"] = r
                        it["checked"] = True
                        break
                    print(f"  '{r}' is taken or not a valid key", file=sys.stderr)
            else:
                q = {"stale": f"comment out stale entries ({it['value']})",
                     "tbeam": f"set TBEAM_HOST = {it['value']}"}[it["kind"]]
                it["checked"] = _confirm(f"  {q}?")
    while True:
        ent = _prompt("add host (alias=target or user@host, blank to finish): ")
        if not ent:
            break
        used = taken | {x["alias"] for x in items if x["t"] in ("toggle", "locked")}
        alias, target = _parse_host_entry(ent, used)
        if alias is None:
            print(f"  {target}", file=sys.stderr)
            continue
        items.insert(_host_insert_at(items),
                     {"t": "toggle", "sec": "hosts", "kind": "host",
                      "alias": alias, "value": target, "checked": True})
        print(f"  {st.g}+{st.r} {alias} → {target}")
    repos, hosts, tbeam, stale_ok = _setup_result(items)
    if not (repos or hosts or tbeam or stale_ok):
        return True   # nothing selected — cmd_setup prints the no-op summary
    print(f"\n{st.b}review{st.r} — will append to ~/.zshrc.local:\n")
    if repos or hosts or tbeam:
        for ln in _setup_block(repos, hosts, tbeam, time.strftime("%Y-%m-%d")).splitlines():
            print(f"  {ln}")
    if stale_ok:
        sv = next(x["value"] for x in items if x.get("kind") == "stale")
        print(f"  (and comment out the stale entries: {sv})")
    return _confirm("proceed?")


def cmd_setup(cfg, args):
    """Interactive onboarding (see the section comment above). Phases: stale-entry
    comment-out (the one in-place edit, own confirm) → repo picker → host picker +
    manual loop → TBEAM_HOST offer → summary + single append + cache regen."""
    try:
        with open(ZSHRC_LOCAL, errors="ignore") as fh:
            local_text = fh.read()
    except OSError:
        local_text = ""
    f_repos, f_hosts, tbeam_set = _local_entries(local_text)

    # dedup state: union of the live file lines and the (possibly stale) cache
    reg_paths = ({os.path.realpath(_expand_home(v)) for v in f_repos.values()} |
                 {os.path.realpath(v) for v in cfg.repos.values()})
    taken_keys = set(f_repos) | set(cfg.repos)
    host_keys = set(f_hosts) | set(cfg.hosts)
    host_targets = {_unquote(v) for v in f_hosts.values()} | set(cfg.hosts.values())

    # scan roots: args or ~/code; drop missing / worktree-rooted ones with a note
    roots, wt_root = [], os.path.realpath(cfg.worktree_root)
    for d in (args.dirs or [os.path.join(HOME, "code")]):
        d = os.path.abspath(os.path.expanduser(d))
        real = os.path.realpath(d)
        if not os.path.isdir(d):
            print(f"t setup: skipping {d} — not a directory", file=sys.stderr)
        elif real == wt_root or real.startswith(wt_root + os.sep):
            print(f"t setup: skipping {d} — per-session worktrees are managed by "
                  f"`t open`, not DEV_REPOS", file=sys.stderr)
        else:
            roots.append(d)
    if not roots:
        print("t setup: no scannable directories", file=sys.stderr)
        return 1

    cands = _scan_repos(roots, reg_paths | {cfg.worktree_root})
    proposals, collided = _propose_aliases(cands, taken_keys)
    ssh_hosts = [h for h in _parse_ssh_hosts(SSH_CONFIG)
                 if h not in host_keys and h not in host_targets]
    stale = sorted(k for k, v in f_repos.items() if not os.path.isdir(_expand_home(v)))

    # registered entries scoped to what this run looks at, for the "already in
    # your config" context each phase prints (silent skipping read as a bug);
    # stale entries are excluded — they get their own phase-0 section
    reg_repos = {k: v for k, v in
                 {**{k: _expand_home(v) for k, v in f_repos.items()}, **cfg.repos}.items()
                 if k not in stale
                 and any(v == r or v.startswith(r + os.sep) for r in roots)}
    reg_hosts = {**{k: _unquote(v) for k, v in f_hosts.items()}, **cfg.hosts}

    if args.dry_run or not (sys.stdin.isatty() and sys.stdout.isatty()):
        if reg_repos or reg_hosts:
            print(f"already registered: {len(reg_repos)} repo(s) under the scanned "
                  f"dirs, {len(reg_hosts)} host(s)")
        if stale:
            print("stale DEV_REPOS entries (path missing): " + ", ".join(stale))
        if not cands and not ssh_hosts:
            print("nothing to offer — every discovered repo/host is already registered")
        else:
            hp, _ = _propose_aliases_hosts(ssh_hosts, host_keys)
            print("would offer (shown as if everything were picked):\n")
            print(_setup_block({a: p for p, a in proposals.items()}, hp, None,
                               time.strftime("%Y-%m-%d")), end="")
        if args.dry_run:
            return 0
        print("\nt setup is interactive — run it from a terminal (or use --dry-run)",
              file=sys.stderr)
        return 1

    # one checklist screen: everything discovered, registered entries locked
    hp, _skipped = _propose_aliases_hosts(ssh_hosts, host_keys)
    tbeam_default = None
    if not tbeam_set:
        tbeam_default = next(iter(hp.values()), None) or next(iter(sorted(reg_hosts.values())), None)
    items = _setup_items([(p, proposals[p]) for p in cands], reg_repos,
                         list(hp.items()), reg_hosts, tbeam_default, stale,
                         ", ".join(_tilde(r) for r in roots))
    if not _selectable(items):   # no toggles at all → nothing the screen could do
        print("nothing to offer — every discovered repo and host is already registered")
        print("(add an unlisted host by hand: REMOTE_HOSTS[alias]=user@host in ~/.zshrc.local)")
        return 0
    all_keys = taken_keys | host_keys
    wizard_ran = True
    try:
        confirmed = _setup_wizard(items, all_keys)
    except Exception as e:
        wizard_ran = False
        print(f"(inline UI unavailable: {e} — falling back to prompts)", file=sys.stderr)
        confirmed = _setup_prompt_flow(items, all_keys)
    if not confirmed:
        if not wizard_ran:   # the wizard already printed its └ aborted line
            print("t setup: aborted — nothing written")
        return 1

    add_repos, add_hosts, tbeam_target, stale_ok = _setup_result(items)
    st = Style()
    if stale_ok and stale:
        local_text = _comment_stale(local_text, set(stale))
        with open(ZSHRC_LOCAL, "w") as fh:
            fh.write(local_text)
        print(f"✓ commented out stale entries: {', '.join(stale)}")
    if not add_repos and not add_hosts and not tbeam_target:
        if not stale_ok and not wizard_ran:   # the wizard showed "nothing selected"
            print("nothing selected — nothing written")
        return 0

    block = _setup_block(add_repos, add_hosts, tbeam_target, time.strftime("%Y-%m-%d"))
    _append_local(ZSHRC_LOCAL, block)
    # a fresh zsh -lic sources the updated ~/.zshrc.local; .zshrc's own
    # _t_sync_config call then regenerates the (now-stale) config cache
    zsh_capture("_t_sync_config")
    n = len(add_repos) + len(add_hosts) + (1 if tbeam_target else 0)
    if wizard_ran:   # its review left the exact block on screen — just summarize
        print(f"✓ appended {n} entr{'y' if n == 1 else 'ies'} to ~/.zshrc.local")
    else:
        print("✓ appended to ~/.zshrc.local:")
        for ln in block.splitlines():
            print(f"  {st.y}{ln}{st.r}" if ln.startswith("#") else f"  {ln}")
    if not os.environ.get("T_SETUP_SHIM"):
        print("run `source ~/.zshrc` (or open a new shell) to make the new shortcuts live")
    return 0


# ─── shell-bound verbs — handled by the t() zsh shim, not the bin ──────────────
# These cd the calling shell / exec `claude -r` in the current terminal / hand off
# the tpush sentinel — a subprocess cannot. The t() function in .zshrc intercepts
# them and calls the _t_dev/_t_pop/_t_push/_t_resume/_t_find/_t_beam/_t_cd helpers. Reaching
# the bin here means it was invoked DIRECTLY (e.g. `command t open`, or a context with no
# t() function) — which cannot perform the shell action.

_SHELL_BOUND = {"open", "pop", "push", "resume", "beam", "find", "cd", "__resolve"}


def cmd_pending(cfg, args):
    print(f"t {args._verb}: this verb runs in the shell via the `t` function, not the "
          f"bin. You reached bin/t directly (e.g. `command t {args._verb}`) — run "
          f"`t {args._verb} …` in an interactive zsh instead.", file=sys.stderr)
    return 2


# ─── doctor — read-only setup diagnostics ─────────────────────────────────────
# Born from a real debugging session: "scroll wheel doesn't work" turned out to be
# four stacked facts (stale live checkout, missing ~/.tmux.conf link, tmux server
# options predating the config, and Claude's fullscreen TUI capturing the wheel).
# doctor gathers exactly that state in one shot. The gathering is subprocess glue
# (cmd_doctor, coverage-excluded); the diagnosis rules are pure + pytest-covered.

# install.sh's own `link "$LINK_SRC/<src>" "<dst>"` calls, parsed rather than
# hardcoded so doctor can never drift from what install.sh actually manages. Leading
# whitespace is allowed because the calls live inside install.sh's link_all(); a
# comment or a mention (`# link …`, `echo link …`) still has to not match, which is
# why this anchors on indentation-then-`link` rather than searching anywhere.
_INSTALL_LINK_RE = re.compile(r'^[ \t]*link\s+"\$LINK_SRC/([^"]+)"\s+"([^"]+)"', re.M)

# Terminals that translate the scroll wheel into arrow keys while an app sits on
# the alternate screen. Claude's fullscreen renderer keeps its own virtualized
# scrollback and expects real wheel events, so there the wheel moves nothing and
# Claude posts "Scroll wheel is sending arrow keys" (its detector trips on 8 bare
# arrows inside a 100ms window). Verified for Apple_Terminal — only add a
# terminal here once its wheel has actually been observed arriving as arrows.
_WHEEL_ARROW_TERMS = ("Apple_Terminal",)


def _env_on(env, name):
    """A CLAUDE_CODE_* toggle counts as on unless unset/empty/0/false."""
    return env.get(name, "").strip().lower() not in ("", "0", "false")


def _effective_tui(settings_tui, env):
    """Which renderer Claude will actually use: "fullscreen", "default" or None.

    `tui` is optional in Claude's settings schema with NO default, and the
    fullscreen upsell only fires while it is undefined — so unset means the
    CLASSIC main-screen renderer and must never be read as fullscreen (that
    would fire the wheel warning at everyone who never opted in). The env knobs
    override the file; DISABLE_ALTERNATE_SCREEN wins outright because it forces
    the main screen regardless of the renderer setting.
    """
    if _env_on(env, "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN"):
        return "default"
    if _env_on(env, "CLAUDE_CODE_NO_FLICKER"):   # documented as == fullscreen
        return "fullscreen"
    return settings_tui

# Terminals that translate the scroll wheel into arrow keys while an app sits on
# the alternate screen. Claude's fullscreen renderer keeps its own virtualized
# scrollback and expects real wheel events, so there the wheel moves nothing and
# Claude posts "Scroll wheel is sending arrow keys" (its detector trips on 8 bare
# arrows inside a 100ms window). Verified for Apple_Terminal — only add a
# terminal here once its wheel has actually been observed arriving as arrows.
_WHEEL_ARROW_TERMS = ("Apple_Terminal",)


def _env_on(env, name):
    """A CLAUDE_CODE_* toggle counts as on unless unset/empty/0/false."""
    return env.get(name, "").strip().lower() not in ("", "0", "false")


def _effective_tui(settings_tui, env):
    """Which renderer Claude will actually use: "fullscreen", "default" or None.

    `tui` is optional in Claude's settings schema with NO default, and the
    fullscreen upsell only fires while it is undefined — so unset means the
    CLASSIC main-screen renderer and must never be read as fullscreen (that
    would fire the wheel warning at everyone who never opted in). The env knobs
    override the file; DISABLE_ALTERNATE_SCREEN wins outright because it forces
    the main screen regardless of the renderer setting.
    """
    if _env_on(env, "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN"):
        return "default"
    if _env_on(env, "CLAUDE_CODE_NO_FLICKER"):   # documented as == fullscreen
        return "fullscreen"
    return settings_tui


def _parse_install_links(text):
    return [(m.group(1), m.group(2)) for m in _INSTALL_LINK_RE.finditer(text)]


def _doctor_findings(facts):
    """Pure diagnosis over the gathered facts → list of finding lines.

    facts keys (all optional): links [(dst, status)] where status != "ok" is a
    problem; behind (int, live surface commits behind origin/main); conf_exists /
    conf_is_link (~/.tmux.conf); tmux_running; mouse ("on"/"off"); conf_mouse_on
    (the FILE says mouse on); history_limit (global); panes [{session, cmd,
    mouse, alt, hist}]; in_tmux; term_program ($TERM_PROGRAM); tui (the
    effective renderer per _effective_tui).
    """
    out = []
    bad = [(d, s) for d, s in facts.get("links", []) if s != "ok"]
    if bad:
        out.append("⚠ %d managed link(s) not in place: %s — run dots (it relinks every "
                   "run; dots --relink to do it without fetching)"
                   % (len(bad), ", ".join("%s (%s)" % (os.path.basename(d), s) for d, s in bad)))
    if facts.get("behind"):
        out.append("⚠ live surface is %d commit(s) behind origin/main — run dots"
                   % facts["behind"])
    if facts.get("conf_exists") and not facts.get("conf_is_link"):
        out.append("⚠ ~/.tmux.conf is a real file, not the repo-managed symlink — "
                   "re-run install.sh to adopt it (the old file is backed up to .bak)")
    if facts.get("tmux_running"):
        if facts.get("mouse") != "on":
            if facts.get("conf_mouse_on"):
                out.append("⚠ tmux mouse is OFF but ~/.tmux.conf says on — the server "
                           "predates the config; run dots (it re-sources it), or: "
                           "tmux source-file ~/.tmux.conf")
            else:
                out.append("⚠ tmux mouse is OFF — the wheel scrolls the terminal's stale "
                           "scrollback, not the pane; get the repo ~/.tmux.conf linked "
                           "(install.sh), then tmux source-file ~/.tmux.conf")
        caps = [p for p in facts.get("panes", []) if p.get("mouse")]
        if caps and facts.get("mouse") == "on":
            out.append("· %d pane(s) capture the wheel themselves (Claude's fullscreen "
                       "TUI): scrolling there moves Claude's view, not tmux history. "
                       "Full output: ctrl+o transcript ('[' dumps it to native "
                       "scrollback); classic renderer: /tui default or "
                       "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1" % len(caps))
        gl = facts.get("history_limit")
        stale = [p for p in facts.get("panes", []) if gl and p.get("hist") and p["hist"] < gl]
        if stale:
            out.append("· %d existing pane(s) still have the old history-limit (%d); the "
                       "global %d applies only to panes created after the change"
                       % (len(stale), stale[0]["hist"], gl))
    if (not facts.get("in_tmux") and facts.get("tui") == "fullscreen"
            and facts.get("term_program") in _WHEEL_ARROW_TERMS):
        out.append("⚠ %s turns the wheel into arrow keys on the alternate screen, so "
                   "the fullscreen renderer never sees it scroll (\"Scroll wheel is "
                   "sending arrow keys\"). Fix: /tui default — the classic renderer "
                   "draws on the main screen, so the wheel scrolls the terminal\'s own "
                   "scrollback. To keep fullscreen, read back with the ctrl+o transcript "
                   "(\'[\' dumps it to native scrollback)" % facts["term_program"])
    if not out:
        out.append("✓ nothing suspicious found")
    return out


def cmd_doctor(cfg, args):
    import json
    import platform

    st = Style()

    def run(cmd, timeout=8):
        """stdout on success (stripped, possibly empty), None on any failure."""
        try:
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               text=True, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return r.stdout.strip() if r.returncode == 0 else None

    def ver(out):
        if out is None or not out.strip():
            return "missing"
        m = re.search(r"\d[\w.\-]*", out.splitlines()[0])
        return m.group(0) if m else out.splitlines()[0]

    def section(title):
        print("\n%s%s%s" % (st.b, title, st.r))

    print("%st doctor%s — dotfiles / tmux / Claude session diagnostics" % (st.b, st.r))

    # host + terminal environment
    section("Host")
    un = platform.uname()
    os_line = "%s %s (%s)" % (un.system, un.release, un.machine)
    if un.system == "Darwin":
        v = run(["sw_vers", "-productVersion"])
        if v:
            os_line = "macOS %s (%s)" % (v, un.machine)
    print("  %s · %s" % (un.node, os_line))
    bits = ["TERM=%s" % os.environ.get("TERM", "?")]
    if os.environ.get("TERM_PROGRAM"):
        bits.append("TERM_PROGRAM=%s %s" % (os.environ["TERM_PROGRAM"],
                                            os.environ.get("TERM_PROGRAM_VERSION", "")))
    bits.append("inside tmux: %s" % ("yes" if os.environ.get("TMUX") else "no"))
    bits.append("ssh: %s" % ("yes" if os.environ.get("SSH_CONNECTION") else "no"))
    print("  " + " · ".join(bits))
    # which renderer Claude will use here — decides who owns the scroll wheel
    settings_tui = None
    try:
        with open(os.path.join(HOME, ".claude", "settings.json")) as f:
            settings_tui = json.load(f).get("tui")
    except (OSError, ValueError, AttributeError):
        settings_tui = None
    tui = _effective_tui(settings_tui, os.environ)
    print("  claude tui: %s" % (tui or "default (unset)"))

    # tool versions (claude lives on the interactive PATH / ~/.local/bin)
    section("Versions")
    vers = ["%s %s" % (n, ver(run(c))) for n, c in [
        ("zsh", ["zsh", "--version"]), ("tmux", ["tmux", "-V"]),
        ("git", ["git", "--version"]), ("gh", ["gh", "--version"]),
        ("fzf", ["fzf", "--version"])]]
    claude_bin = shutil.which("claude") or os.path.join(HOME, ".local", "bin", "claude")
    vers.append("claude %s" % (ver(run([claude_bin, "--version"], timeout=15))
                               if os.path.exists(claude_bin) else "missing"))
    print("  " + " · ".join(vers))

    # dotfiles: which checkout is live, is it current, are the links in place
    section("Dotfiles")
    facts = {"in_tmux": bool(os.environ.get("TMUX")),
             "term_program": os.environ.get("TERM_PROGRAM"), "tui": tui}
    zrc = os.path.join(HOME, ".zshrc")
    live_src = None
    if os.path.islink(zrc):
        live_src = os.path.dirname(os.path.realpath(zrc))
        br = run(["git", "-C", live_src, "rev-parse", "--abbrev-ref", "HEAD"]) or "?"
        head = run(["git", "-C", live_src, "log", "-1", "--format=%h %s"]) or "?"
        print("  live surface   ~/.zshrc → %s" % live_src)
        print("                 %s @ %s" % (br, head))
        fetched = run(["git", "-C", live_src, "fetch", "-q", "origin", "main"]) is not None
        behind = run(["git", "-C", live_src, "rev-list", "--count", "HEAD..origin/main"])
        if behind is not None and behind.isdigit():
            facts["behind"] = int(behind)
            note = "" if fetched else " (as of last fetch — origin unreachable)"
            print("                 vs origin/main: %s%s"
                  % ("up to date" if not facts["behind"] else "behind %d" % facts["behind"], note))
    else:
        print("  live surface   ~/.zshrc is not a symlink — install.sh has not run here")
    links = []
    if live_src:
        try:
            with open(os.path.join(live_src, "install.sh")) as f:
                pairs = _parse_install_links(f.read())
        except OSError:
            pairs = []
        for rel, dst_raw in pairs:
            dst = dst_raw.replace("$HOME", HOME)
            want = os.path.realpath(os.path.join(live_src, rel))
            if not os.path.lexists(dst):
                links.append((dst, "missing"))
            elif not os.path.islink(dst):
                links.append((dst, "not a symlink"))
            elif os.path.realpath(dst) != want:
                links.append((dst, "→ %s" % os.path.realpath(dst)))
            else:
                links.append((dst, "ok"))
        n_ok = sum(1 for _, s in links if s == "ok")
        print("  managed links  %d/%d in place" % (n_ok, len(links)))
        for d, s in links:
            if s != "ok":
                print("                 %s~/%s: %s%s"
                      % (st.y, os.path.relpath(d, HOME), s, st.r))
    facts["links"] = links
    if os.path.exists(CONFIG):
        age = int(time.time() - os.path.getmtime(CONFIG))
        print("  config bridge  %s (%dm old)" % (CONFIG.replace(HOME, "~"), age // 60))
    else:
        print("  config bridge  missing (%s) — open an interactive zsh once" % CONFIG.replace(HOME, "~"))

    # tmux: server options vs the config file, and who owns the mouse per pane
    section("Tmux")
    tmux_running = run(["tmux", "list-sessions", "-F", "#{session_name}"]) is not None
    facts["tmux_running"] = tmux_running
    conf = os.path.join(HOME, ".tmux.conf")
    facts["conf_exists"] = os.path.lexists(conf)
    facts["conf_is_link"] = os.path.islink(conf)
    try:
        with open(conf) as f:
            facts["conf_mouse_on"] = bool(re.search(r"^\s*set(?:-option)?\s+-g\s+mouse\s+on",
                                                    f.read(), re.M))
    except OSError:
        facts["conf_mouse_on"] = False
    print("  ~/.tmux.conf   %s" % ("→ %s" % os.path.realpath(conf) if facts["conf_is_link"]
                                   else "real file (not repo-managed)" if facts["conf_exists"]
                                   else "absent"))
    if not tmux_running:
        print("  server         not running")
    else:
        mouse = run(["tmux", "show", "-g", "-v", "mouse"])
        focus = run(["tmux", "show", "-g", "-v", "focus-events"])
        hist = run(["tmux", "show", "-g", "-v", "history-limit"])
        facts["mouse"] = mouse
        facts["history_limit"] = int(hist) if hist and hist.isdigit() else None
        print("  server         mouse %s · focus-events %s · history-limit %s"
              % (mouse, focus, hist))
        panes = []
        raw = run(["tmux", "list-panes", "-a", "-F",
                   "#{session_name}\t#{pane_current_command}\t#{mouse_any_flag}"
                   "\t#{alternate_on}\t#{history_limit}"]) or ""
        for ln in raw.splitlines():
            f = ln.split("\t")
            if len(f) == 5:
                panes.append({"session": f[0], "cmd": f[1], "mouse": f[2] == "1",
                              "alt": f[3] == "1", "hist": int(f[4]) if f[4].isdigit() else 0})
        facts["panes"] = panes
        if panes:
            w = max(len(p["session"]) for p in panes)
            for p in panes:
                flags = [x for x in (("mouse-capture" if p["mouse"] else None),
                                     ("alt-screen" if p["alt"] else None)) if x]
                print("    %-*s  %-12s %-25s hist %d"
                      % (w, p["session"], p["cmd"], " ".join(flags) or "-", p["hist"]))

    section("Findings")
    for line in _doctor_findings(facts):
        print("  " + line)
    return 0



# ─── todo — a per-slot task list ───────────────────────────────────────────────
#
# Keyed on the SLOT (<repo>-<slot>), not the Claude session id: a conversation's id
# changes under you (compaction, /clear, a fresh `t resume`) while the work does not,
# and the slot is the unit you actually hold in your head when several run at once.
# Keying on <repo>-<slot> also survives a beam, since the worktree path and branch are
# basename+slot on every host by design.
#
# Removal is a TOMBSTONE, never an unlink. csync's sync_pair is `rsync --update` with
# NO --delete (bin/csync), so a file removed here comes straight back from iCloud on
# the next run — but a done/deleted FLAG rides inside the file, and the newest whole
# file wins. Only `t todo clear` physically drops the flagged items. Same reason the
# union caveat is real: two machines editing one slot's list between syncs lose a side.
# That is the one-live-owner-per-slot invariant the rest of `t` already assumes.

_TODO_EMPTY = {"v": 1, "next_id": 1, "items": []}


def _todo_dir():
    """State root, read at call time so tests (and $XDG_STATE_HOME) can redirect it."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state")
    return os.path.join(base, "t", "todo")


def _todo_path(key):
    return os.path.join(_todo_dir(), key + ".json")


def _todo_key(cfg, cwd, tmux_name=None, override=None):
    """The list a given cwd belongs to. Ladder, most specific first:
      1. an explicit -s override (or the `<repo> [slot]` positionals, which become one);
      2. a per-session worktree — cfg.repo_of_dir gives (alias, slot) straight off the
         path, which is the normal case since Claude's Bash tool runs in the worktree;
      3. the tmux session name (dev-<repo>-<slot>) for a shared-tree / opt-out repo,
         split on the LAST dash so a multi-dash alias resolves (the _dev_* rule);
      4. a canonical repo dir with no slot → the repo's own list;
      5. nothing → "scratch", so a quick add from anywhere never errors out.
    Deliberately NOT _infer_repo: its newest-log tiebreak between sibling aliases (dot
    vs dotfiles) can drift between calls, which would silently split one slot's list
    across two files. repo_of_dir's basename-else-shortest choice is stable."""
    if override:
        return override
    alias, slot = cfg.repo_of_dir(cwd)
    if alias and slot:
        return "%s-%s" % (alias, slot)
    if tmux_name and tmux_name.startswith("dev-"):
        repo, dash, num = tmux_name[4:].rpartition("-")
        if dash and repo and num.isdigit():
            return "%s-%s" % (repo, num)
    if alias:
        return alias
    return "scratch"


def _todo_load(path):
    """Read a list file. Missing, unreadable, or malformed all read as an EMPTY list
    rather than an error: this is a convenience surface, and refusing to work because
    half a JSON write survived would be worse than starting the list over."""
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return dict(_TODO_EMPTY, items=[])
    if not isinstance(data, dict) or not isinstance(data.get("items"), list):
        return dict(_TODO_EMPTY, items=[])
    items = [i for i in data["items"] if isinstance(i, dict) and "id" in i]
    highest = max([i.get("id", 0) for i in items] or [0])
    return {"v": data.get("v", 1),
            "next_id": max(int(data.get("next_id", 1) or 1), highest + 1),
            "items": items}


_TODO_TTL = 7 * 86400


def _todo_purge(data, now=None, ttl=_TODO_TTL):
    """Physically drop finished items older than `ttl`. Returns the count dropped.

    This replaced an explicit `clear` verb: a list you have to tidy is a list you stop
    using. Tombstones still do their csync job while they live (rsync has no --delete,
    so an unlinked item would come straight back) — they just expire on their own, and
    the purged copy wins the union merge by being newer.

    An item with no timestamp is LEFT ALONE: rows written before this existed have no
    done_at, and must not vanish on a technicality."""
    now = int(now if now is not None else time.time())
    keep = []
    for i in data["items"]:
        if i.get("done") or i.get("deleted"):
            stamp = i.get("done_at") or i.get("deleted_at")
            if stamp and now - int(stamp) > ttl:
                continue
        keep.append(i)
    dropped = len(data["items"]) - len(keep)
    data["items"] = keep
    return dropped


def _todo_save(path, data):
    """Write atomically (tmp + os.replace) so a crash mid-write can never leave a
    truncated list where a good one was. Expiry rides on the write so that reading a
    list never rewrites it."""
    _todo_purge(data)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=1)
        fh.write("\n")
    os.replace(tmp, path)


def _todo_open(data):
    return [i for i in data["items"] if not i.get("done") and not i.get("deleted")]


def _todo_visible(data, show_all=False):
    live = [i for i in data["items"] if not i.get("deleted")]
    return live if show_all else [i for i in live if not i.get("done")]


def _todo_find(data, tok):
    """Resolve an id token to a live (non-tombstoned) item, else None."""
    if not str(tok).isdigit():
        return None
    n = int(tok)
    for i in data["items"]:
        if i.get("id") == n and not i.get("deleted"):
            return i
    return None


_TODO_ACTIONS = ("add", "done", "rm", "mv", "ls")

# Four spellings, not thirteen. Each is a word you would plausibly reach for first;
# a longer table only made the "one of:" error longer without making anything findable.
_TODO_ALIASES = {"list": "ls", "x": "done", "delete": "rm", "move": "mv"}

# Verbs that existed for a few days and no longer do. Answering with the reason beats
# "unknown action" — muscle memory from this week should get a pointer, not a dead end.
_TODO_RETIRED = {
    "clear": "finished items purge themselves now",
    "purge": "finished items purge themselves now",
    "edit": "remove it and add it again",
    "undone": "t todo -a, then pick the item",
    "reopen": "t todo -a, then pick the item",
}


def _todo_canon(action):
    return _TODO_ALIASES.get(action, action)


def _todo_options(p):
    """The `t todo` flags. One table, two parsers: build_parser() puts them on the
    subcommand, and _todo_hoist_flags() re-reads them out of `rest` — a second
    hand-copied list would drift the moment a flag was added to one and not the other."""
    p.add_argument("-a", "--all", action="store_true",
                   help="show finished items too, and inactive slots from a repo dir")
    p.add_argument("-A", "--all-slots", action="store_true",
                   help="every slot's open items, grouped")
    p.add_argument("-s", "--slot", metavar="KEY",
                   help="target another list by key (e.g. dotfiles-3) instead of the cwd's")
    # Working but off the everyday surface: the statusLine config and CLAUDE.md depend
    # on these, nobody types them.
    p.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--statusline", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("-n", "--items", type=int, metavar="N", help=argparse.SUPPRESS)


# Flags that take a value: when scanning `add` text for a leading run of flags, the
# token after one of these is its argument, not the first word of the task.
_TODO_VALUE_FLAGS = ("-s", "--slot", "-n", "--items")


def _todo_flaggy(tok):
    """A token the hoist lets argparse see as an option: dash-led and whitespace-free.
    A quoted "-A literal" is ONE space-bearing token — argparse's short-option prefix
    match runs BEFORE its "contains a space → positional" rule, so left to itself it
    reads that as -A plus junk. Holding such tokens back makes quoting a real escape
    hatch, whatever argparse version is installed."""
    return tok.startswith("-") and len(tok) > 1 and not any(c.isspace() for c in tok)


def _todo_hoist_flags(args):
    """Lift the todo flags out of `rest`, where argparse's REMAINDER parks every token
    that follows the action — flags included. `t todo ls -A` parsed as action=ls,
    rest=['-A'], all_slots=False: the flag sat unread and the view answered as a plain
    `t todo` would, which reads as "-A can't see all slots". Only flags BEFORE the
    action were ever seen (`t todo -A ls`), a gh-style order nobody types.

    For `add` only a LEADING run of flags is hoisted (`t todo add -s dot-3 fix it`),
    because the text that follows is prose and a `-s` inside it is a word, not a flag
    (`t todo add handle -s in t setup` must stay one task, not file "in t setup" into a
    list called `in`). The other actions take ids, so a flag anywhere is a flag.
    Quoting is still the escape hatch for a task whose FIRST word is dash-shaped."""
    rest = list(args.rest or [])
    if not any(_todo_flaggy(tok) for tok in rest):
        return args
    verbatim = []
    # A `--` ends the flags. (One placed directly after the action never reaches us —
    # argparse eats it as the REMAINDER delimiter — so for a task whose FIRST word is
    # dash-shaped, quote it: `t todo add "-A literal"` is one space-bearing token, which
    # argparse never reads as an option.)
    if "--" in rest:
        cut = rest.index("--")
        rest, verbatim = rest[:cut], rest[cut + 1:]
    p = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    _todo_options(p)
    if _todo_canon(args.action) == "add":
        i = 0
        while i < len(rest) and _todo_flaggy(rest[i]):
            i += 2 if rest[i] in _TODO_VALUE_FLAGS else 1
        head, tail = rest[:i], rest[i:]
        found, extra = p.parse_known_args(head)
        rest = extra + tail
    else:
        held = [tok for tok in rest if tok.startswith("-") and not _todo_flaggy(tok)]
        found, rest = p.parse_known_args([tok for tok in rest if tok not in held])
        rest += held
    for name, val in vars(found).items():
        if val not in (None, False):             # a flag that was actually given
            setattr(args, name, val)
    args.rest = rest + verbatim
    return args


def _todo_slot_arg(rest):
    """Split a leading bare slot number off an `add` -> ("11", ["fix","it"]) for
    `t todo add 11 fix the ledger`; (None, rest) when there is none.

    A bare number is genuinely ambiguous here -- `t todo 11` already means item #11 --
    so the slot reading is taken only when TEXT FOLLOWS. `t todo add 11` alone stays a
    literal item, which is what a lone number nearly always is. The escape hatch for
    text that really does start with a digit is quoting: `t todo add "3 more tests"`
    arrives as ONE token, so rest[0] is not a digit and nothing is stripped.

    Pure -- resolving the number against a repo is the caller's job, and without one
    (an add from ~) there is nothing to resolve it against, so it stays text."""
    rest = list(rest or [])
    if len(rest) >= 2 and rest[0].isdigit():
        return (rest[0], rest[1:])
    return (None, rest)


def _todo_repo_arg(action, rest, repos):
    """Split a leading `<repo> [slot]` off the positionals -> (key, action, rest), the
    `t <verb> <repo> [slot]` grammar every other slot verb speaks: `t todo ff add x`
    files into ff's repo-level list, `t todo ff 3 add x` into ff-3, `t todo ff` views
    the repo, `t todo ff-3 done 2` names a list outright. (None, action, rest) when
    the first token is not a repo -- an ACTION name always wins, so a repo aliased
    `add` could never shadow the verb (it just needs -s).

    A bare number right after the repo is read as a SLOT, never as an item: that is
    the grammar's slot position, and an item wants an action anyway -- `t todo ff 3 4`
    still reaches item #4 of ff-3 through the bare-id path.

    Pure -- the caller turns the key into the -s override."""
    rest = list(rest or [])
    if not action or action in _TODO_ACTIONS or action in _TODO_ALIASES \
            or action in _TODO_RETIRED:
        return (None, action, rest)
    key = None
    if action in repos:
        key = action
        if rest and rest[0].isdigit():
            key, rest = "%s-%s" % (action, rest[0]), rest[1:]
    else:
        alias, dash, num = action.rpartition("-")
        if dash and num.isdigit() and alias in repos:
            key = action
    if key is None:
        return (None, action, rest)
    return (key, rest[0] if rest else None, rest[1:])
def _todo_ls_target(key, repos, rest):
    """Resolve `t todo ls <what>` to the list to show -> (key, None) or (None, error).

    A bare number is the slot of the repo `key` resolves to -- the same reading `add`
    gives a leading number (`t todo add 17 fix it`), so `t todo ls 17` from a repo dir
    OR from inside a sibling's worktree shows slot 17 and nothing else. No repo to
    resolve against (scratch, ~) is an error naming the full-key form, not a silent
    fall-through to the widened view -- that was the bug: the number was ignored and
    the whole repo rendered, which read as "can't ls only slot 17".

    Anything else is a list key verbatim (`t todo ls dotfiles-3`), the positional twin
    of -s. Only ONE token is taken: the view is one list, and extra words would be
    silently dropped otherwise."""
    rest = list(rest or [])
    if not rest:
        return (key, None)
    if len(rest) > 1:
        return (None, "one slot or list at a time -- t todo ls %s" % rest[0])
    tok = rest[0]
    if not tok.isdigit():
        return (tok, None)
    alias = key if key in repos else key.rpartition("-")[0]
    if alias not in repos:
        return (None, "no repo here to read slot %s against -- t todo ls <repo>-%s" % (tok, tok))
    return ("%s-%s" % (alias, tok), None)


def _todo_apply(data, action, rest, now=None):
    """Mutate `data` in place for one action. Returns (message, rc). Never raises on
    bad input — an unknown id is a message and rc 1, so a fat-fingered `t todo done 9`
    reports instead of exploding."""
    now = int(now if now is not None else time.time())
    rest = list(rest or [])
    action = _todo_canon(action)

    if action == "add":
        text = " ".join(rest).strip()
        if not text:
            return ("t todo add: needs some text — t todo add \"rebase onto main\"", 2)
        item = {"id": data["next_id"], "text": text, "done": False,
                "added": now, "done_at": None, "deleted": False}
        data["items"].append(item)
        data["next_id"] += 1
        return ("✓ added #%d  %s" % (item["id"], text), 0)

    if action == "_reopen":          # internal: the bare-id picker's un-tick
        item = _todo_find(data, rest[0]) if rest else None
        if not item:
            return ("⚠ no such item: %s" % (rest[0] if rest else "?"), 1)
        item["done"], item["done_at"] = False, None
        return ("✓ reopened #%d  %s" % (item["id"], item["text"]), 0)

    if action in ("done", "rm"):
        if not rest:
            return ("t todo %s: needs an id (t todo to list them)" % action, 2)
        hit, missed = [], []
        for tok in rest:
            item = _todo_find(data, tok)
            if not item:
                missed.append(str(tok))
                continue
            if action == "done":
                item["done"], item["done_at"] = True, now
            else:
                item["deleted"], item["deleted_at"] = True, now
            hit.append(item)
        verb = {"done": "done", "rm": "removed"}[action]
        msg = []
        if hit:
            msg.append("✓ %s %s" % (verb, ", ".join("#%d" % i["id"] for i in hit)))
        if missed:
            msg.append("⚠ no such item: %s" % ", ".join(missed))
        return ("\n".join(msg), 1 if missed else 0)

    if action in _TODO_RETIRED:
        return ("t todo: `%s` is gone — %s" % (action, _TODO_RETIRED[action]), 2)

    return ("t todo: unknown action '%s' — one of: %s"
            % (action, ", ".join(_TODO_ACTIONS)), 2)


def _todo_move(src_data, dst_data, tok, dst_key, now=None):
    """Move one item between two lists. Returns (message, rc); mutates both dicts.

    The item is re-created in the destination with a fresh id (ids are per-list) and
    TOMBSTONED in the source rather than spliced out — same reason as `rm`: csync has
    no --delete, so the source file has to carry the fact of the move."""
    now = int(now if now is not None else time.time())
    item = _todo_find(src_data, tok)
    if not item:
        return ("⚠ no such item: %s" % tok, 1)
    moved = dict(item, id=dst_data["next_id"], deleted=False, deleted_at=None)
    dst_data["items"].append(moved)
    dst_data["next_id"] += 1
    item["deleted"], item["deleted_at"] = True, now
    return ("✓ moved #%s → %s #%d  %s" % (tok, dst_key, moved["id"], moved["text"]), 0)


def _todo_render(data, key, show_all=False, width=80, st=None, shared=None):
    """The one-list view. Returns display lines (no trailing newlines).

    `shared` is an optional (key, data) for the repo-level list this slot hangs off:
    its items render as a dim second section marked ◇ rather than ◻, so which list an
    item lives in is readable at a glance — which matters, because ids are per-list and
    the two sections can both hold a #3."""
    st = st or Style()
    items = _todo_visible(data, show_all)
    n_open = len(_todo_open(data))
    # Footer of next actions, mirroring `t ls`. Bare `t todo` is the discovery surface —
    # without it the verbs exist only in -h, which nobody runs before they need them.
    n_done = len(items) - n_open if show_all else 0
    tally = "nothing open" if not n_open else "%d open" % n_open
    if n_done:
        tally += " · %d done" % n_done
    head = "%s%s%s %s— %s%s" % (st.b, key, st.r, st.y, tally, st.r)
    foot = ['', "  %s%s%s" % (st.y, _TODO_FOOT, st.r)]

    lines = [head] if items else [head, '  %s(nothing here yet)%s' % (st.y, st.r)]
    if items:
        idw = max(len(str(i["id"])) for i in items)
        for i in items:
            mark = "✓" if i.get("done") else "◻"
            body = _truncate(i["text"], max(10, width - idw - 6))
            if i.get("done"):
                lines.append("  %s%*d  %s %s%s" % (st.y, idw, i["id"], mark, body, st.r))
            else:
                lines.append("  %s%*d%s  %s %s" % (st.c, idw, i["id"], st.r, mark, body))
    return lines + _todo_shared_lines(shared, show_all, width, st) + foot


def _todo_shared_lines(shared, show_all, width, st):
    """The repo-level section appended to a slot's view. Empty when there is nothing
    to show, so a slot with no shared notes renders exactly as it always did."""
    if not shared:
        return []
    skey, sdata = shared
    sitems = _todo_visible(sdata, show_all)
    if not sitems:
        return []
    n = len(_todo_open(sdata))
    out = ['', "  %s%s — %s%s" % (st.y, skey,
                                  "nothing open" if not n else "%d open" % n, st.r)]
    idw = max(len(str(i["id"])) for i in sitems)
    for i in sitems:
        body = _truncate(i["text"], max(10, width - idw - 6))
        mark = "✓" if i.get("done") else "◇"
        out.append("  %s%*d%s  %s %s%s%s"
                   % (st.c, idw, i["id"], st.r, mark, st.y if i.get("done") else "",
                      body, st.r if i.get("done") else ""))
    return out


def _todo_id_actions(item):
    """Actions offered for one item → [(action, label)]. `reopen` appears only for a
    finished item, and is how un-ticking survives the `undone` verb being removed."""
    if item.get("done"):
        return [("_reopen", "reopen"), ("rm", "remove"), ("mv", "move to another slot")]
    return [("done", "tick off"), ("rm", "remove"), ("mv", "move to another slot")]


def _todo_scoped_candidates(entries, action):
    """Items to offer across several lists → [(key, id, label)].

    The view widens to the repo when the cwd names no slot; the ACTIONS have to widen
    with it, or you see an item you cannot touch — which is exactly what `t todo rm`
    did from a repo dir: it offered the (empty) repo-level list while the view showed a
    slot's item. The label carries the slot whenever more than one list is in play."""
    show_key = len(entries) > 1
    out = []
    for key, data in entries:
        for ident, label in _todo_pick_candidates(data, action):
            out.append((key, ident, "%s%s" % ("%-12s " % key if show_key else "", label)))
    return out


def _todo_locate(entries, tok):
    """Every live item with id `tok` across `entries` → [(key, item)]. Ids are per-list,
    so a widened scope can genuinely match twice; the caller disambiguates rather than
    guessing."""
    return [(key, i) for key, data in entries for i in data["items"]
            if not i.get("deleted") and str(i.get("id")) == str(tok)]


def _todo_pick_candidates(data, action):
    """Items a no-id `done`/`undone`/`rm`/`edit`/`mv` should offer → [(id, label)].

    `done` offers only open items (marking a done item done again is a no-op), `undone`
    only finished ones, and the rest offer everything still live — you may well want to
    remove or re-file something already ticked off."""
    action = _todo_canon(action)
    if action == "undone":
        items = [i for i in data["items"] if i.get("done") and not i.get("deleted")]
    elif action == "done":
        items = _todo_open(data)
    else:
        items = _todo_visible(data, show_all=True)
    return [(i["id"], "%d  %s %s" % (i["id"], "✓" if i.get("done") else "◻", i["text"]))
            for i in items]


_TODO_FOOT = ('add: t todo add "…" · done: t todo done <id> · one item: t todo <id> '
              '· one slot: t todo ls <n> · every slot: t todo -A')


def _todo_parent(key, repos):
    """The repo-level list a slot key belongs to → alias, or None for a repo-level key.

    The counterpart to `_todo_scoped`, which widens a slotless view DOWN to the repo's
    slots. Without this the widening was one-way: a note jotted at repo level — the
    cross-slot stuff, which is exactly what wants to be visible everywhere — was
    invisible from inside every slot, on the bar and in the view alike. The tail must
    be numeric AND the head a real alias, so `financial-forecast` is a repo, not slot
    `forecast` of repo `financial`."""
    head, _, num = key.rpartition("-")
    return head if num.isdigit() and head in repos else None


def _todo_shared(cfg, key):
    """A slot's repo-level list as a (key, data) pair, or None when there is nothing
    there. Gated on live items so a slot with no shared notes pays only one stat and
    renders exactly as it always did."""
    parent = _todo_parent(key, cfg.repos)
    if not parent:
        return None
    data = _todo_load(_todo_path(parent))
    return (parent, data) if _todo_visible(data, show_all=True) else None


def _todo_live_nums(repos, alias, live_slots):
    """Slot NUMBERS of this repo's live tmux sessions, from `_todo_live_slots` rows.

    Matched through the repo DIR, not the alias string: a session named `dev-dot-4`
    keys the same tree as the `dotfiles-4` list (`_todo_key` files by the canonical
    alias, whichever name the session was opened under), so a string compare would
    report a live slot dead. Pure: the caller gathers."""
    path = repos.get(alias)
    out = set()
    for r in live_slots:
        head, _, num = r.get("slot", "").rpartition("-")
        if num.isdigit() and path and repos.get(head) == path:
            out.add(num)
    return out


def _todo_scoped(entries, alias, live_nums=None):
    """This repo's lists — its repo-level one plus every <alias>-<slot>. A plain shell in
    a repo dir names no slot, so showing only the (usually empty) repo-level list hides
    the work sitting in that repo's slots, which is exactly what was being asked for.

    `live_nums` (a set of slot numbers) keeps only ACTIVE slots — the repo-level list is
    always kept, open or not. A list outlives its session on purpose (keyed on the slot,
    not the conversation id), so without this gate every slot that ever held a task kept
    showing up from the repo dir long after its session was gone. None = no gate."""
    out = []
    for key, data in entries:
        head, _, num = key.rpartition("-")
        if key == alias:
            out.append((key, data))
        elif head == alias and num.isdigit() and (live_nums is None or num in live_nums):
            out.append((key, data))
    return out


def _todo_add_targets(alias, rows, list_keys, wt_slots):
    """Ordered destinations for a slotless `t todo add` → [(key, label)].

    Standing in a repo dir names no slot, and with 20+ live slots for one repo a guess
    would be worse than asking. The repo-level list stays FIRST so it is the default
    pick (fzf preselects line 1) — the picker adds a choice, it does not take one away.

    Slots come from three unioned sources, cheapest last-resort first: a live session
    (labelled with what it is working on — the only label that is actually recognisable
    among twenty), a worktree on disk, an existing list. Pure: the caller gathers."""
    live = {}
    for r in rows:
        slot = r.get("slot", "")
        head, _, num = slot.rpartition("-")
        if head == alias and num.isdigit():
            live[num] = (r.get("summary") or "").strip()
    seen = set(live) | {s for s in wt_slots if s.isdigit()}
    open_counts = {}
    for key, n in list_keys.items():
        head, _, num = key.rpartition("-")
        if head == alias and num.isdigit():
            seen.add(num)
            open_counts[num] = n
    out = [(alias, "%s   (no slot — the repo-level list)" % alias)]
    for num in sorted(seen, key=int):
        bits = []
        if num in live:
            bits.append(live[num] or "(live)")
        elif num in wt_slots:
            bits.append("worktree")
        if open_counts.get(num):
            bits.append("%d open" % open_counts[num])
        out.append(("%s-%s" % (alias, num),
                    "%s-%s   %s" % (alias, num, " · ".join(bits) or "-")))
    return out


def _todo_canon_aliases(cfg):
    """One alias per repo DIR. Sibling keys (dot + dotfiles) name one tree, and
    repo_of_dir only ever resolves to one of them, so offering both would list the same
    slots twice under two names. Same choice repo_of_dir makes: the key equal to the
    basename wins, else the shortest key."""
    by_dir = {}
    for key, path in (cfg.repos or {}).items():
        by_dir.setdefault(os.path.realpath(path), []).append(key)
    out = []
    for path, keys in by_dir.items():
        base = os.path.basename(path)
        out.append(base if base in keys else min(keys, key=len))
    return sorted(out)


def _todo_add_targets_all(aliases, rows, list_keys, wt_slots):
    """Destinations for an add from NOWHERE -- no repo in the cwd -> [(key, label)].

    "scratch" stays FIRST so Enter keeps the old fallback behaviour: the picker adds a
    choice, it never takes one away. Then every repo that has somewhere to file -- a
    live slot, a worktree, or an existing list. A repo with none of those is left out on
    purpose: from nowhere the useful destinations are the ones that already exist, and
    `-s <key>` still reaches any list by name. Pure: the caller gathers.

    wt_slots is keyed by alias here (one repo per key), unlike the single-repo twin."""
    out = [("scratch", "scratch   (no repo -- the catch-all list)")]
    for alias in aliases:
        targets = _todo_add_targets(alias, rows, list_keys, wt_slots.get(alias) or set())
        if len(targets) == 1 and alias not in list_keys:
            continue                     # no slots, no list -- nothing to file against
        out.extend(targets)
    return out


def _todo_render_all(entries, width=80, st=None):
    """The -A cross-slot view: every list with something open, grouped by key. This is
    the actual answer to 'many things in parallel and I forget what I need to do'."""
    st = st or Style()
    live = [(k, _todo_open(d)) for k, d in entries]
    live = [(k, items) for k, items in live if items]
    if not live:
        return ["%snothing open in any slot%s" % (st.y, st.r),
                "", "  %s%s%s" % (st.y, _TODO_FOOT, st.r)]
    kw = max(len(k) for k, _ in live)
    lines = []
    for key, items in live:
        for n, i in enumerate(items):
            label = key if n == 0 else ""
            body = _truncate(i["text"], max(10, width - kw - 10))
            lines.append("  %s%-*s%s  %s%2d%s  ◻ %s"
                         % (st.b, kw, label, st.r, st.c, i["id"], st.r, body))
    return lines + ["", "  %s%s%s" % (st.y, _TODO_FOOT, st.r)]


# The dev server a slot's work is testable at. Mirrors financial-forecast's
# scripts/dev-worktree.sh, which is the thing that actually binds the port:
# .worktrees/<repo>/<N> → 5200+N, primary checkout → Vite's canonical 5173.
# Re-derived here rather than shelled out to because the statusline renders many
# times a second and that script costs a bash plus several lsof calls.
_DEV_PORT_BASE = 5200
_DEV_PORT_PRIMARY = 5173


def _port_is_live(port, host="localhost", timeout=0.05):
    """True when something is LISTENING on the port. A loopback connect settles in
    well under a millisecond either way — a closed port refuses immediately rather
    than waiting out the timeout — which is what makes this affordable per render.

    Probed by NAME, not 127.0.0.1: create_connection tries every address localhost
    resolves to, and Vite without --host binds ONLY [::1] on modern macOS/Node, so an
    IPv4-only probe reported a perfectly live slot port dead and the bar fell through
    to whoever held the shared :5173."""
    try:
        with socket.create_connection((host, port), timeout):
            return True
    except OSError:
        return False


def _has_dev_server(cwd):
    """Could this checkout be running a dev server at all? A package.json is the tell."""
    return bool(cwd) and os.path.exists(os.path.join(cwd, "package.json"))


def _dev_url(key, cwd):
    """The URL to test this slot's work at, or None if nothing is serving it.

    Candidates in order: the slot's own deterministic port, then the canonical dev
    port — the latter only for a checkout that could plausibly have a dev server
    (a package.json), so a repo without one never claims the shared :5173 out from
    under whoever is on it.

    Only a port with a LIVE listener is returned. A URL that refuses the connection
    is worse than no URL, and appearing exactly when the server comes up makes the
    bar double as the "it's ready" signal."""
    # Only a checkout that could run a dev server (a package.json) gets a URL at all.
    # Ports are 5200+N across EVERY repo, so dotfiles slot 3 would otherwise claim
    # ff slot 3's vite on :5203 — a CLI repo pointing at someone else's web app.
    if not _has_dev_server(cwd):
        return None
    _, dash, slot = key.rpartition("-")
    if dash and slot.isdigit():
        # A slot has exactly one port. It never falls back to :5173 — that is some
        # OTHER checkout's server, and a bar that names it while this slot's server
        # is down sends you to the wrong app with total confidence.
        port = _DEV_PORT_BASE + int(slot)
    else:
        port = _DEV_PORT_PRIMARY
    return "http://localhost:%d" % port if _port_is_live(port) else None


# A single item's share of the one-line bar. The bar is a reminder, not the list —
# `t todo` shows the full text — and without a cap one 140-char task fits a wide
# terminal outright and hides every item behind it (the width fit only ever
# ellipses an item that OVERFLOWS the bar). Sized so a hand-off's usual lead-in,
# a name plus the URL it is checked at, survives whole:
#   "Accounts ledger (http://localhost:5217/#accounts) Aug 21…"
_TODO_BAR_ITEM_MAX = 56


def _todo_statusline(payload, cfg, items_n=1, width=80, tmux_name=None):
    """Claude Code's statusLine. The payload arrives as JSON on stdin;
    workspace.current_dir is preferred over cwd (they differ when Claude is run from a
    subdir of the project). Everything is optional — a statusline that raises leaves
    the TUI with a permanently broken status bar, so every field degrades to nothing.

    Layout is two zones split by │: a dim head (slot · model, plus ● and the URL the
    slot is testable at when a dev server is live) and the tasks, each carrying its own
    checkbox — so the box, not a separator, is what delimits an item.
    A slot's bar also carries its REPO-level list, marked ◇ instead of ◻ and sorted
    after the slot's own: the cross-slot notes live there, and keying the bar strictly
    on the slot hid them from every place you actually work.
    The open COUNT is deliberately gone: the ◻s and the trailing +N already say how
    many, and a bare number sitting next to a checkbox read as an item.

    items_n == 1 packs as many open items onto ONE line as `width` allows (the safe
    default: a single line renders anywhere), each capped at _TODO_BAR_ITEM_MAX so
    one long task cannot take the whole line. items_n > 1 emits a header plus one line
    per item, which is only useful if the host renders a multi-line statusline.

    Colour is emitted UNCONDITIONALLY (honouring NO_COLOR) — Style() gates on
    isatty and stdout here is always the pipe Claude Code reads, so the shared helper
    would render every bar plain.

    tmux_name is gathered by the caller and passed in (the ladder stays pure). Without
    it the bar renders a DIFFERENT list from the one `t todo add` files into whenever
    the cwd carries no slot of its own — a session run from a repo's primary checkout
    inside a dev-<repo>-<n> window is exactly that case, and the items silently never
    appear."""
    if not isinstance(payload, dict):
        payload = {}
    ws = payload.get("workspace") if isinstance(payload.get("workspace"), dict) else {}
    cwd = ws.get("current_dir") or payload.get("cwd") or os.getcwd()
    model = payload.get("model") if isinstance(payload.get("model"), dict) else {}
    name = (model.get("display_name") or "").strip()
    key = _todo_key(cfg, cwd, tmux_name)
    items = [("◻", i["id"], i["text"]) for i in _todo_open(_todo_load(_todo_path(key)))]
    parent = _todo_parent(key, cfg.repos)
    if parent:                             # the slot's own work first, shared notes after
        items += [("◇", i["id"], i["text"])
                  for i in _todo_open(_todo_load(_todo_path(parent)))]

    dim, cyan, green, rst = ("", "", "", "") if os.environ.get("NO_COLOR") else \
        ("\033[2m", "\033[36m", "\033[32m", "\033[0m")
    head = " · ".join([key] + ([name] if name else []))
    # A live dev URL rides in the head zone, but deliberately NOT dim — it is the one
    # part of the bar you act on. Carried as (coloured, printable) so the one-line
    # packer below keeps measuring real widths rather than escape sequences.
    url = _dev_url(key, cwd)
    # " ● " + url + " │ " is 6 columns of chrome, and an item needs ~12 to say anything.
    # On a bar too narrow for both, the tasks win — they are the reason for the bar.
    if url and len(head) + len(url) + 18 > width:
        url = None
    if url:
        head_c = "%s%s%s %s●%s %s%s%s%s │ %s" % (dim, head, rst, green, rst,
                                                 cyan, url, rst, dim, rst)
        head_p = "%s ● %s │ " % (head, url)
    else:
        head_c, head_p = dim + head + " │ " + rst, head + " │ "
    if not items:
        return head_c + dim + "nothing open" + rst

    if items_n > 1:
        shown = items[:items_n]
        iw = max(len(str(i)) for _, i, _ in shown)
        out = [head_c + dim + "%d open" % len(items) + rst]
        for g, ident, text in shown:
            out.append("  %s %s%*d%s %s"
                       % (cyan + g + rst, dim, iw, ident, rst,
                          _truncate(text, max(10, width - 6 - iw))))
        if len(items) > items_n:
            out.append("  %s+%d more%s" % (dim, len(items) - items_n, rst))
        return "\n".join(out)

    # One line, newest ask first. Fit against a limit that already reserves the
    # "+N more" tail, so the assembled bar can never exceed `width`.
    tail_room = len("  +%d more" % len(items)) if len(items) > 1 else 0
    limit = width - tail_room
    plain, line, shown = head_p, head_c, 0
    for g, _, text in items:
        text = _truncate(text, _TODO_BAR_ITEM_MAX)   # every item; the width fit below
        sep = "  " if shown else ""                  # only ever ellipses the first
        if len(plain) + len(sep) + 2 + len(text) > limit:
            if shown:
                break                      # a mid-list ellipsis reads noisier than a +N
            avail = limit - len(plain) - 2
            if avail < 10:
                break
            text = _truncate(text, avail)
        plain += sep + g + " " + text
        line += sep + cyan + g + rst + " " + text
        shown += 1
    if not shown:                          # a width too narrow for even one item
        return head_c + dim + "%d open" % len(items) + rst
    if shown < len(items):
        line += "%s  +%d more%s" % (dim, len(items) - shown, rst)
    return line


def _todo_live_slots():
    """Live dev slots by name, straight from tmux. This replaced
    zsh_capture("_dev_session_rows"): that spawned a login+interactive zsh to fetch each
    slot's "working on" summary, cost 5 SECONDS, and suspended the caller with SIGTTOU
    when the interactive shell went for the terminal. 8ms here, and a slot number plus
    its open count is enough to choose between lists."""
    try:
        r = subprocess.run(["tmux", "list-sessions", "-F", "#{session_name}"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return []
    return [{"slot": n[4:], "summary": ""} for n in r.stdout.split() if n.startswith("dev-")]


def _todo_worktree_slots(cfg, alias):
    """The slot dirs on disk for one repo: $DEV_WORKTREE_ROOT/<basename>/<slot>."""
    root = os.path.join(cfg.worktree_root, os.path.basename(cfg.repos.get(alias, "")))
    return {os.path.basename(p) for p in glob.glob(os.path.join(root, "*"))
            if os.path.exists(os.path.join(p, ".git"))}


def _todo_pick_target(cfg, alias):
    """Ask which list a slotless add should go to. Returns a key, or None to stay put.

    `alias` None means the cwd names no repo at all (an add from ~), so the choice
    widens across every repo instead of not being offered: the old gate only fired from
    a repo dir, which left the from-nowhere add silently filing to `scratch` with a ✓
    line that never said so — the one write path that did not name its list."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    list_keys = {os.path.basename(p)[:-5]: len(_todo_open(_todo_load(p)))
                 for p in glob.glob(os.path.join(_todo_dir(), "*.json"))}
    rows = _todo_live_slots()
    if alias:
        targets = _todo_add_targets(alias, rows, list_keys,
                                    _todo_worktree_slots(cfg, alias))
    else:
        aliases = _todo_canon_aliases(cfg)
        targets = _todo_add_targets_all(
            aliases, rows, list_keys,
            {a: _todo_worktree_slots(cfg, a) for a in aliases})
    if len(targets) == 1:
        return None                      # nowhere to file but here — nothing to choose
    return _pick_inline("add to which list?", targets)


def _todo_pick_action(item):
    """What to do with one item; None if it cannot pick (caller prints the hint)."""
    return _pick_inline('#%d  %s' % (item["id"], _truncate(item["text"], 50)),
                        _todo_id_actions(item))


def _todo_pick_ids(entries, action, multi=True):
    """Pick the items for a no-id action across `entries` → [(key, id)]. None = cannot or
    would not pick (caller keeps its 'needs an id' error, so scripts are unchanged)."""
    cands = _todo_scoped_candidates(entries, action)
    if not cands:
        return None
    rows = [((key, ident), lbl) for key, ident, lbl in cands]
    return _pick_inline("%s which?" % _todo_canon(action), rows, multi=multi) or None


def _todo_all_entries():
    """(key, data) for every list on disk, key-sorted."""
    return [(os.path.basename(p)[:-5], _todo_load(p))
            for p in sorted(glob.glob(os.path.join(_todo_dir(), "*.json")))]


def _tmux_session_name():
    """The tmux session this shell is in, or None. Gathering only — _todo_key takes it
    as an argument so the ladder stays pure."""
    if not os.environ.get("TMUX"):
        return None
    try:
        out = subprocess.run(["tmux", "display-message", "-p", "#S"],
                             capture_output=True, text=True)
    except OSError:
        return None
    return out.stdout.strip() or None


def cmd_todo(cfg, args):
    # --statusline is a rendering-only path invoked by Claude Code many times a second;
    # it must never raise and never write. The blanket except is deliberate.
    if args.statusline:
        payload = {}
        try:
            raw = "" if sys.stdin.isatty() else sys.stdin.read()
            if raw.strip():
                payload = json.loads(raw)
        except Exception:
            payload = {}   # unparseable stdin still gets a line, just without the model
        try:
            print(_todo_statusline(payload, cfg, args.items or 1, _columns(),
                                   _tmux_session_name()))
        except Exception:
            print("")
        return 0

    # `t todo ff add …` / `t todo ff 3` — the `<repo> [slot]` positionals every other
    # slot verb takes. They are sugar for -s: the key lands in args.slot and the real
    # action shifts left, so nothing below has to know the list was named positionally.
    target, action, rest = _todo_repo_arg(args.action, args.rest, cfg.repos)
    if target:
        if args.slot and args.slot != target:
            print("t todo: -s %s and %s name different lists — drop one"
                  % (args.slot, target), file=sys.stderr)
            return 2
        # Re-parse the shifted tail as `todo -s <key> …`: REMAINDER swallowed anything
        # after the repo on the first pass, so `t todo ff -a` arrived with `-a` as the
        # action. Flags already parsed ahead of the repo are kept; -h prints and exits.
        tail = build_parser().parse_args(["todo", "-s", target]
                                         + ([action] if action is not None else []) + rest)
        for name in ("all", "all_slots", "json", "statusline", "items"):
            setattr(args, name, getattr(args, name) or getattr(tail, name))
        args.slot, args.action, args.rest = target, tail.action, tail.rest
    # `t todo ls -A`: flags typed after the action live in rest. Deliberately AFTER the
    # repo shift — the hoist's rule depends on the real action (`add` text is prose, ids
    # are not), and the shift's re-parse parks after-action flags in rest all over again.
    _todo_hoist_flags(args)

    # `t todo add -h` must print help, not file an item called "-h". REMAINDER swallows
    # flags after the action, so the t() shim's -h check and argparse both miss it.
    # Only the FIRST token counts, so `t todo add fix the -h flag` still adds normally.
    if args.action in ("-h", "--help") or (args.rest and args.rest[0] in ("-h", "--help")):
        build_parser().parse_args(["todo", "--help"])   # prints, then SystemExit(0)

    width = _columns()
    st = Style()

    if args.all_slots:
        entries = _todo_all_entries()
        for line in _todo_render_all(entries, width, st):
            print(line)
        return 0

    key = _todo_key(cfg, os.getcwd(), _tmux_session_name(), args.slot)

    def live_gate():
        """Slot numbers the repo view is limited to: its live sessions, unless -a asked
        for everything. None disables the gate."""
        return None if args.all else _todo_live_nums(cfg.repos, key, _todo_live_slots())

    def scope():
        """Lists this invocation acts on, exactly the set the view shows: a slotless cwd
        widens DOWN to the repo's slots, a slot widens UP to its repo-level list. The
        actions have to track the view either way, or you see an item you cannot touch.
        An EXPLICITLY named list (-s, or the repo/slot positionals) is exactly that
        list: the ambiguous-id error says "name one with -s", and naming one has to
        actually narrow, or the advice is a dead end."""
        if args.slot:
            return [(key, data)]
        if key in cfg.repos:
            found = _todo_scoped(_todo_all_entries(), key, live_gate())
            if found:
                return found
        shared = _todo_shared(cfg, key)
        return [(key, data), shared] if shared else [(key, data)]
    # An `add` resolves its destination three ways, most explicit first: -s names a list
    # outright; a leading bare slot number files ACROSS slots without leaving the dir
    # (`t todo add 11 fix the ledger`); otherwise the list is ASKED for rather than
    # guessed. The picker used to be gated on `key in cfg.repos`, so an add from ~ fell
    # through to the `scratch` catch-all with no prompt — and since the ✓ line named no
    # list either, `t todo add 11` looked like it had gone to a slot 11 that was never
    # involved. Both halves are fixed here and at the ✓ print below.
    if _todo_canon(args.action or "ls") == "add" and not args.slot:
        alias = key if key in cfg.repos else key.rpartition("-")[0]
        alias = alias if alias in cfg.repos else None
        slot, stripped = _todo_slot_arg(args.rest)
        if slot and alias:
            key, args.rest = "%s-%s" % (alias, slot), stripped
        elif " ".join(args.rest).strip():
            # No repo to resolve a number against (or no number): ask. The leading token
            # stays part of the text — a slot needs a repo, and the picker shows both.
            key = _todo_pick_target(cfg, alias) or key
    # `t todo ls 17` names a slot the way `add 17 …` does; `ls` used to drop its args on
    # the floor and render the widened repo view, so there was no way to see ONE slot.
    if _todo_canon(args.action or "ls") == "ls" and args.rest:
        key, err = _todo_ls_target(key, cfg.repos, args.rest)
        if err:
            print("t todo ls: %s" % err, file=sys.stderr)
            return 2
    path = _todo_path(key)
    data = _todo_load(path)
    action = args.action or "ls"

    if args.json:
        json.dump({"key": key, "path": path, **data}, sys.stdout, ensure_ascii=False, indent=1)
        sys.stdout.write("\n")
        return 0

    # A lone id is not an action, but it is obviously about one item — offer what can be
    # done with it rather than rejecting it.
    if action and action.isdigit() and not args.rest:
        hits = _todo_locate(scope(), action)
        if len(hits) > 1:
            print("t todo: #%s is in %s — name one with -s"
                  % (action, ", ".join(k for k, _ in hits)), file=sys.stderr)
            return 2
        key = hits[0][0] if hits else key
        path = _todo_path(key)
        data = dict(scope()).get(key, data) if hits else data
        item = hits[0][1] if hits else None
        picked = _todo_pick_action(item) if item else None
        if picked == "mv":
            dest = _todo_pick_target(cfg, key.rpartition("-")[0] if key not in cfg.repos else key)
            if not dest or dest == key:
                return 2
            dst_data = _todo_load(_todo_path(dest))
            msg, rc = _todo_move(data, dst_data, action, dest)
            if rc == 0:
                _todo_save(_todo_path(dest), dst_data)
                _todo_save(path, data)
            print(msg, file=sys.stderr if rc else sys.stdout)
            return rc
        if picked:
            msg, rc = _todo_apply(data, picked, [action])
            if rc != 2:
                _todo_save(path, data)
            print(msg, file=sys.stderr if rc else sys.stdout)
            if rc:
                return rc
            for line in _todo_render(data, key, args.all, width, st,
                                     _todo_shared(cfg, key)):
                print(line)
            return 0
        if not item:
            print("⚠ no such item: %s" % action, file=sys.stderr)
            return 1
        print("t todo: %s is an item, not an action. Try:  t todo done %s  ·  t todo rm %s"
              % (action, action, action), file=sys.stderr)
        return 2

    if _todo_canon(action) == "mv":
        rest = list(args.rest)
        if not rest:                                   # which item?
            rest = _todo_pick_ids(data, "mv", multi=False) or []
        if len(rest) == 1:                             # …and where to?
            alias = key.rpartition("-")[0] if key not in cfg.repos else key
            picked = _todo_pick_target(cfg, alias) if alias in cfg.repos else None
            if picked and picked != key:
                rest.append(picked)
        if len(rest) < 2:
            print("t todo mv: needs an id and a destination — t todo mv 2 ff-3", file=sys.stderr)
            return 2
        tok, dst_key = rest[0], rest[1]
        if dst_key == key:
            print("t todo mv: #%s is already in %s" % (tok, key), file=sys.stderr)
            return 2
        dst_path = _todo_path(dst_key)
        dst_data = _todo_load(dst_path)
        msg, rc = _todo_move(data, dst_data, tok, dst_key)
        if rc == 0:
            _todo_save(dst_path, dst_data)
            _todo_save(path, data)
        print(msg, file=sys.stderr if rc else sys.stdout)
        return rc

    # A repo dir names no slot. Showing only the (usually empty) repo-level list hides
    # the work sitting in that repo's slots, so a slotless view widens to the repo —
    # to its LIVE slots only (-a widens to inactive ones too; the repo-level list is
    # shown regardless).
    if (_todo_canon(action) == "ls" and key in cfg.repos
            and (_todo_open(data) or any(
                _todo_open(d) for _, d in _todo_scoped(_todo_all_entries(), key,
                                                       live_gate())))):
        scoped = _todo_scoped(_todo_all_entries(), key, live_gate())
        if len(scoped) > 1 or not _todo_open(data):
            n = sum(len(_todo_open(d)) for _, d in scoped)
            print("%s%s%s %s— %d open%s" % (st.b, key, st.r, st.y, n, st.r))
            for line in _todo_render_all(scoped, width, st):
                print(line)
            return 0

    if _todo_canon(action) != "ls":
        rest, canon = list(args.rest), _todo_canon(action)
        if canon in ("done", "rm"):
            entries = scope()
            by_list = {}
            if rest:
                for tok in rest:                       # explicit ids resolve in scope too
                    hits = _todo_locate(entries, tok)
                    if len(hits) > 1:
                        print("t todo: #%s is in %s — name one with -s"
                              % (tok, ", ".join(k for k, _ in hits)), file=sys.stderr)
                        return 2
                    if not hits:
                        print("⚠ no such item: %s" % tok, file=sys.stderr)
                        return 1
                    by_list.setdefault(hits[0][0], []).append(tok)
            else:
                for k, ident in _todo_pick_ids(entries, canon) or []:
                    by_list.setdefault(k, []).append(str(ident))
            if not by_list:
                print("t todo %s: needs an id (t todo to list them)" % canon, file=sys.stderr)
                return 2
            worst = 0
            for k, toks in by_list.items():
                d = dict(entries)[k] if k != key else data
                msg, rc = _todo_apply(d, canon, toks)
                if rc != 2:
                    _todo_save(_todo_path(k), d)
                print(msg, file=sys.stderr if rc else sys.stdout)
                worst = max(worst, rc)
            if worst:
                return worst
            # _todo_render_all only fits a view widened DOWN to sibling slots; a slot
            # widened UP re-renders as itself, with the repo section under it.
            for line in _todo_render_all(scope(), width, st) \
                    if key in cfg.repos and len(entries) > 1 \
                    else _todo_render(data, key, args.all, width, st,
                                      _todo_shared(cfg, key)):
                print(line)
            return 0

        msg, rc = _todo_apply(data, action, rest)
        if rc != 2:
            _todo_save(path, data)
        if msg and canon == "add" and not rc:
            # Always name the list. The destination comes from the cwd, a bare slot arg
            # or a picker — none of which the ✓ line showed, so an add that landed
            # somewhere unintended stayed invisible until you went looking for it.
            msg = "%s   %s→ %s%s" % (msg, st.y, key, st.r)
        if msg:
            print(msg, file=sys.stderr if rc else sys.stdout)
        if rc:
            return rc
        if canon == "add":
            return 0

    for line in _todo_render(data, key, args.all, width, st, _todo_shared(cfg, key)):
        print(line)
    return 0

# ─── argument parsing (gh-style) ───────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(
        prog="t", description="Claude session manager (open/list/move tmux'd Claude sessions).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  t open api              open/reattach the next free api slot
  t open api 3 --new      force a fresh session in api slot 3
  t open                  open/reattach in the repo cwd is in
  t paste 4               slot-only args mean the cwd repo (all verbs)
  t open ff -r --new      start a fresh session on the default remote host
  t open ff --host mini   start/attach a session on 'mini' (a specific remote host)
  t open a4aa5f6a         adopt a foreground (:fg) session here (id from t ls)
  t ls                    list this repo's live sessions
  t ls -r                 list live sessions across every machine
  t push                  send the current session to a background tmux slot
  t pop api 3             pull dev-api-3 back to this terminal
  t resume api 3          revive dev-api-3's last conversation after it was closed
  t todo add "rebase"     add to this slot's task list (t todo -A: every slot)
  t cd ff 5               cd this shell into ff's slot-5 worktree (bare t cd: picker)
  t beam api --host mini  send a session to 'mini' and resume it there
  t find "auth refactor"  search saved sessions, then resume the pick
  t on mini ls            run a command on a remote host
  t setup                 onboard this machine: register ~/code repos + ssh hosts

Run `t <verb> -h` for a verb's own flags.""")
    sub = p.add_subparsers(dest="verb", metavar="<verb>")

    sp = sub.add_parser("open", help="open or reattach a session in a per-repo tmux slot",
        description="Open or reattach a Claude session in a per-repo tmux slot. Bare `t open` "
            "(or a lone slot like `t open 3`) targets the repo your cwd is in. A slot that is "
            "live only on another host is attached in place automatically — no flag needed. "
            "`--new` forces a fresh session, `--fg` runs inline without a tmux slot, and "
            "`-r`/`--host` open or attach on a remote host (`-r --new` starts one there).")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key, or a foreground session id/repo:id from `t ls`")
    sp.add_argument("slot", nargs="?", help="slot number, 'fg' (adopt a :fg session), or a session id")
    sp.add_argument("--new", action="store_true", help="force a fresh session")
    sp.add_argument("--fg", action="store_true", help="no tmux: foreground-resume / run inline")
    sp.add_argument("-l", "--local", "--here", dest="local", action="store_true", help="force this machine: skip the remote auto-attach probe (combine with --fg for local foreground)")
    sp.add_argument("-r", "--remote", action="store_true", help="remote: attach a live slot on any host; with --new, start one on the default host")
    sp.add_argument("--host", help="which host to open/attach on (sets the host for -r; default for --new: first $REMOTE_HOSTS)")

    sp = sub.add_parser("ls", help="list dev sessions (attached + active context)",
        description="List live Claude dev sessions: whether each is attached, and whether it "
            "has an active conversation loaded (vs. parked on the startup splash). Scoped to the "
            "repo your cwd is in by default; `-a` widens to every repo, and `-r` spans every "
            "$REMOTE_HOSTS machine in one table with a HOST column. Read-only — attach with "
            "`t open`, move with `t beam`.")
    sp.add_argument("-r", "--remote", action="store_true", help="span every $REMOTE_HOSTS host")
    sp.add_argument("-a", "--all", action="store_true", help="every repo (not just the current)")

    sp = sub.add_parser("kill", help="tear down a session",
        description="Tear down a dev session (kill its tmux slot). Names default to the cwd "
            "repo, so `t kill 3` kills this repo's slot 3 and `t kill all` kills every slot for "
            "it. A foreground / :fg row from `t ls` (a bare `claude`, or a pr-watch `pr-*` "
            "session) is killed by its shown id/label — `t kill dotfiles-pr47:fg` or `t kill "
            "<short-id>` — since it is not a dev slot. Confirms first while a Claude is live "
            "unless `-y`; `-r` kills it on its remote host instead.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key (or a :fg id/label); defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("-y", "--yes", action="store_true", help="skip the 'Claude is live' confirm")
    sp.add_argument("-r", "--remote", action="store_true", help="kill it on its host instead")

    sp = sub.add_parser("push", help="push this session into a detached background tmux slot",
        description="Push the current Claude session into a detached background tmux slot — "
            "frees this terminal while the conversation keeps running. Inside Claude it "
            "backgrounds THIS chat (and exits it for you); from a plain shell it fzf-picks a "
            "session (scoped to the cwd repo, `-a` for every project). Bring it back with "
            "`t pop`. Inverse of `t pop`.")
    sp.add_argument("-p", "--pick", action="store_true", help="force the picker")
    sp.add_argument("-a", "--all", action="store_true", help="picker across every project")

    sp = sub.add_parser("pop", help="pull a tmux'd session back to the foreground",
        description="Pull a backgrounded (tmux'd) session back into THIS terminal and resume it "
            "in the foreground. Names default to the cwd repo, so `t pop` picks this repo's slot "
            "and `t pop api 3` pulls dev-api-3. Inverse of `t push`.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")

    sp = sub.add_parser("resume", help="revive a dead slot's saved conversation",
        description="Revive a DEAD dev slot's conversation (`t open` on a dead slot "
            "deliberately starts fresh — this brings the chat back). Offers EVERY conversation "
            "saved in the slot's own per-session worktree (one global newest-first list by "
            "session time — never grouped by repo; live rows on top; conversationless stubs "
            "skipped), rebuilding a reaped worktree from its branch first, then resumes the pick "
            "in a fresh dev slot and attaches. Names default to "
            "the cwd repo; outside any repo dir a bare `t resume` scans every worktree repo. "
            "One candidate is taken, several fzf-pick (an explicit slot with no TTY takes the "
            "newest). The picker MULTI-SELECTS: space-mark several rows with a ✓ (tab works "
            "too) and every marked dead "
            "slot revives into its own detached dev slot — the first attaches, the rest open "
            "in NEW terminal tabs (Terminal.app/iTerm2; `t open` hints when tabs are "
            "impossible — ssh, unrecognized terminal, no Accessibility; --fg takes a single "
            "pick only). "
            "LIVE slots appear as labeled rows — '● active' / '● on <host>' — and "
            "picking one ATTACHES in place (locally or on its host) instead of resuming. "
            "Worktree-per-session repos only (a shared tree's transcripts are "
            "ambiguous per-slot — use `t push -p` there).")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("-f", "--fg", action="store_true", help="resume inline in THIS terminal (no tmux slot)")
    sp.add_argument("-a", "--all", action="store_true", help="scan every worktree repo (the default outside a repo dir)")
    sp.add_argument("-r", "--remote", action="store_true",
        help="pull the latest transcripts from every $REMOTE_HOSTS host first (direct rsync; "
             "csync is periodic and needs a shell on the far side), then scan as usual")
    sp.add_argument("--days", metavar="N", default="30",
        help="recency window for conversations (default 30; 'all' for everything)")

    sp = sub.add_parser("cd", help="cd this shell into a dev slot's worktree",
        description="cd the calling shell into a dev slot's worktree "
            "($DEV_WORKTREE_ROOT/<repo>/<slot>). Names default to the cwd repo, so `t cd 3` "
            "jumps to this repo's slot 3. With no slot: the repo's only worktree, an fzf pick "
            "when there are several (showing each worktree's checked-out branch), or the "
            "canonical repo dir when it has none. Bare `t cd` picks across every worktree. "
            "Navigation only — it never creates a worktree (`t open` does) and never touches "
            "tmux.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")

    sp = sub.add_parser("beam", help="move a session between machines (send, or --from to receive)",
        description="Move a Claude session between machines (a cross-host push/pop). By default "
            "SENDS the resolved session to --host (default $TBEAM_HOST) and resumes it there; "
            "`--from HOST` (or `--here` to auto-detect the host) RECEIVES — pulls a session "
            "living on another host down into a local slot. It is a move, not a copy: the "
            "origin's live owner is stopped so exactly one machine owns the conversation. The "
            "repo must exist at the same path on both hosts.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("--host", help="SEND destination machine (default: $TBEAM_HOST)")
    sp.add_argument("--from", dest="from_host", metavar="HOST", help="RECEIVE: pull <repo> [slot] from HOST to this machine")
    sp.add_argument("--here", action="store_true", help="RECEIVE (auto-host): pull it back here, auto-detecting which host it is on")
    sp.add_argument("--fg", action="store_true", help="resume in the foreground, no tmux slot")
    sp.add_argument("-d", "--detach", action="store_true", help="leave it running there; print attach hint")
    sp.add_argument("-p", "--pick", action="store_true", help="force the picker")
    sp.add_argument("-a", "--all", action="store_true", help="picker across every project")
    sp.add_argument("-s", "--session", help="target a session by id or unique prefix")

    sp = sub.add_parser("read", help="read a dev slot's scrollable tmux log",
        description="Page a dev slot's captured tmux log (its scrollback) — handy for checking "
            "on a backgrounded session without attaching. Defaults to `less`; `-d`/`--dump` "
            "prints straight to stdout and `-n N`/`--tail` keeps only the last N lines (default "
            "200, implies --dump) — both for phone terminals that can only touch-scroll native "
            "output. Slot defaults to the cwd repo; a remote slot is read on its host.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("-d", "--dump", action="store_true",
                    help="print to stdout (no less) so a mobile terminal can touch-scroll it")
    sp.add_argument("-n", "--tail", nargs="?", const=200, type=int, metavar="N",
                    help="dump only the last N lines to stdout (default 200; implies --dump)")

    sp = sub.add_parser("plan", help="render the plan a session wrote",
        description="Render the plan a Claude session last wrote (the ExitPlanMode markdown). "
            "Resolves the session like `t pop` — `t plan api 1`, a full dev-<repo>-<slot> name, "
            "or inside Claude the current session — then displays it word-wrapped for narrow "
            "(phone) terminals. `-a` fzf-picks across every project. A remote slot renders on "
            "its host, where the plan file lives.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("-a", "--all", action="store_true", help="fzf-pick across every project")

    sp = sub.add_parser("paste", help="paste the latest iCloud screenshot/doc path into a session",
        description="Paste the path of the latest iCloud screenshot/document into a session's "
            "input — so a screenshot taken on your phone drops straight into a desktop Claude. "
            "Takes the newest file by default; `-p` fzf-picks one, `-n` forces newest. Local-"
            "only: it reads THIS machine's iCloud, so it is not delegated to a remote slot.")
    sp.add_argument("repo", nargs="?", help="DEV_REPOS key; defaults to the repo your cwd is in")
    sp.add_argument("slot", nargs="?", help="slot number; a lone slot implies the cwd repo")
    sp.add_argument("-p", "--pick", action="store_true", help="fzf-pick the file instead of taking the newest")
    sp.add_argument("-n", "--newest", action="store_true", help="skip the picker; take the newest file by mtime")

    sp = sub.add_parser("find", help="semantic search across saved sessions, then resume",
        description="Semantic search across your saved Claude transcripts (\"which session was "
            "working on X?\"), then resume the one you pick. A keyword pass builds a candidate "
            "pool, Sonnet reranks it, and every failure path (no CLI, offline, timeout) falls "
            "back to keyword order so the picker always populates. `-k` forces the offline "
            "keyword path.")
    sp.add_argument("-k", "--keyword", action="store_true", help="offline keyword ranking (no Sonnet)")
    sp.add_argument("query", nargs="*", help="search terms (omit to browse recent sessions)")

    sp = sub.add_parser("cursor", help="move Cursor CLI (cursor-agent) chats between machines",
        description="Passthrough to cursor-beam: send/pull/list cursor-agent chats across "
            "machines, translating the md5-of-cwd workspace hash between differing $HOMEs. "
            "`t cursor ls` lists local chats (`--host <h>` for a remote's); `t cursor` sends "
            "the newest chat to $TBEAM_HOST; `t cursor [id] --from <h>` pulls; `t cursor "
            "resume [id]` resumes one here (cd to its workspace + keychain unlock over ssh). "
            "Full flag reference: cursor-beam -h. Cursor chats have no dev slot, so the "
            "other t verbs do not apply to them.")
    sp.add_argument("rest", nargs=argparse.REMAINDER, help="args forwarded to cursor-beam (ls → --ls)")

    sp = sub.add_parser("on", help="run a command on a remote host (or open a shell)",
        description="Run a command on another machine over ssh, in a login+interactive shell so "
            "the dev tooling and Homebrew are on PATH (e.g. `t on mini t ls`). With no command, "
            "opens an interactive shell there. Hosts come from $REMOTE_HOSTS; an unknown name is "
            "used as a literal ssh target.")
    sp.add_argument("host", help="$REMOTE_HOSTS key, or a literal ssh target")
    sp.add_argument("rest", nargs=argparse.REMAINDER, help="command to run (omit for an interactive shell)")

    sp = sub.add_parser("setup", help="register local repos and ssh hosts in ~/.zshrc.local",
        description="Interactive onboarding for this machine's per-machine config: a stepped "
            "inline wizard over every git checkout found under the scan dirs (default ~/code) "
            "and every ~/.ssh/config host on ONE list, with already-registered entries shown "
            "locked under a ✓. space toggles, e renames in place (the current name sits "
            "pre-filled in the input), a (or the '+ add a host' row) adds a host by hand; enter "
            "then shows the exact changes as a diff — y applies, n goes back to keep editing, "
            "q aborts. Appends to "
            "~/.zshrc.local (append-only; "
            "re-running is safe — registered entries are never re-offered). Also offers to "
            "comment out registered repos whose path no longer exists (the fresh-install "
            "placeholders) and to set TBEAM_HOST. Run it from the shell — the t() shim reloads "
            "your config afterward so the new cd shortcuts and host shorthands go live.")
    sp.add_argument("dirs", nargs="*", help="directories to scan for git repos (default: ~/code)")
    sp.add_argument("--dry-run", action="store_true",
                    help="print what would be offered/appended, change nothing")

    sub.add_parser("doctor", help="diagnose this machine's dotfiles/tmux/Claude setup",
        description="Read-only diagnostics for when the tooling misbehaves: which checkout the "
            "live $HOME symlinks point at and whether it is behind origin/main, whether every "
            "install.sh-managed link is in place, tmux server options vs ~/.tmux.conf (mouse, "
            "focus-events, history-limit), which panes capture the mouse themselves (Claude's "
            "fullscreen TUI — the usual answer to 'the scroll wheel does not scroll the "
            "output'), and tool versions. Ends with findings + suggested fixes. Run it on "
            "another machine with `t on <host> t doctor`.")

    sp = sub.add_parser("todo", help="a scratch task list scoped to this dev slot",
        description="""t todo — tasks for the slot you are standing in

Usage: t todo [repo [slot]] [action] [args]

  (no action)        show this slot's tasks
  <repo> [slot]      another list, positionally: t todo ff add …  ·  t todo ff 3
  ls [slot|key]      show one slot's tasks (t todo ls 17; t todo ls dotfiles-3)
  add <text…>        add a task
  done [id…]         tick off      — no id: pick from a list
  rm   [id…]         remove        — no id: pick from a list
  mv   [id] [slot]   move to another slot's list
  <id>               pick an action for one item

Lists live in $XDG_STATE_HOME/t/todo/<slot>.json and ride csync to your other
machines. Finished tasks leave the view at once and are dropped after a week.""",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sp.add_argument("action", nargs="?", help=argparse.SUPPRESS)
    sp.add_argument("rest", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    _todo_options(sp)

    # machine-readable / internal (hidden-ish; still have -h)
    sub.add_parser("session-rows", help="machine-readable per-host scan (remote contract)",
        description="Internal/machine-readable: emit one tab-separated row per live dev slot on "
            "this host. Part of the cross-host remote contract `t ls -r` and `t beam` run over "
            "ssh; not meant to be called directly.")
    sub.add_parser("land", help="(internal) resume a beamed session on this host",
        description="Internal: resume a just-beamed session on this (the receiving) host, "
            "reading its parameters from TB_* env vars. Invoked over ssh by `t beam`; not for "
            "direct use.")
    sub.add_parser("kill-owner", help="(internal) stop the local owner of a session id",
        description="Internal: stop the local live owner (dev slot) of a session id, enforcing "
            "`t beam`'s one-live-owner-per-conversation invariant. Invoked over ssh; not for "
            "direct use.")
    rp = sub.add_parser("__resolve", help="(internal) resolve a shell action for the t() shim",
        description="Internal: resolve a shell action for the t() zsh shim. Not for direct use.")
    rp.add_argument("rest", nargs=argparse.REMAINDER)
    return p


IMPLEMENTED = {
    "ls": cmd_ls, "session-rows": cmd_session_rows, "on": cmd_on, "read": cmd_read,
    "plan": cmd_plan, "paste": cmd_paste, "kill": cmd_kill, "setup": cmd_setup,
    "land": cmd_land, "kill-owner": cmd_kill_owner, "cursor": cmd_cursor,
    "doctor": cmd_doctor, "todo": cmd_todo,
}


def main(argv):
    # `cursor` dispatches BEFORE argparse: its args belong to cursor-beam, and
    # argparse's REMAINDER rejects a LEADING flag (`t cursor --ls` errors before
    # the remainder engages). Side benefit: `t cursor -h` shows cursor-beam's
    # own help. The subparser still exists so `t -h` lists the verb.
    if argv and argv[0] == "cursor":
        return cmd_cursor(Config(), argparse.Namespace(rest=argv[1:]))
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.verb:
        parser.print_help()
        return 0
    cfg = Config()
    handler = IMPLEMENTED.get(args.verb)
    if handler:
        return handler(cfg, args)
    args._verb = args.verb
    return cmd_pending(cfg, args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
