    sp.add_argument("agents", nargs="*", metavar="agent",
                    help=f"pre-mark only these ({', '.join(INSTALL_AGENTS)}); default: every missing one")
    sp.add_argument("-y", "--yes", action="store_true", help="no list, no review: run the marks as they stand")
    sp.add_argument("--no-login", action="store_true", help="install only, skip the login steps")
    sp.add_argument("--update", action="store_true", help="also run each installed agent's updater")
    sp.add_argument("--headless", action="store_true",
                    help="use the device-code logins (automatic over ssh)")
    hg = sp.add_mutually_exclusive_group()
    hg.add_argument("--hosts", metavar="A,B", help="offer the run only on these REMOTE_HOSTS aliases")
    hg.add_argument("--no-hosts", action="store_true", help="local only (default: every REMOTE_HOSTS host is offered)")
    sp.add_argument("--dry-run", action="store_true", help="print what would run, change nothing")
    sp.add_argument("--status", action="store_true",
                    help="print each agent's install/login state and the per-agent support matrix")

    sub.add_parser("doctor", help="diagnose this machine's dotfiles/tmux/Claude setup",
        description="Read-only diagnostics for when the tooling misbehaves: which checkout the "
